---
import Znacky from './Znacky.astro';
import Vazby from './Vazby.astro';
import type { Tag } from '../lib/data';
import type { PolozkaHlasovani } from '../lib/prehledy';
import type { VazbaHlasovani } from '../lib/vazby';
import { souhrnHlasu, tridaVysledku } from '../lib/prehledy';
import { bezDiakritiky, datumKratke, nazevOrganu, nazevVysledku } from '../lib/format';

export interface Props {
  h: PolozkaHlasovani;
  ciselnik: Map<string, Tag>;
  /** Hlasující, kteří mají vazbu na firmu dotčenou tímhle bodem. */
  vazby?: VazbaHlasovani[];
  /** Klíče protistran, na které vede stránka `/penize/[ico]`. */
  zname?: Set<string>;
  /**
   * Odkud se vezme rozpis jmenovitých hlasů.
   *
   *  `ostruvek` (výchozí) — z JSON ostrůvku, poskládá ho prohlížeč při
   *      rozbalení. Seznam s tisíci hlasováními se jinak nedá otevřít:
   *      12 349 rozpisů vydá na 230 000 DOM uzlů a telefon na tom zamrzne.
   *  `primo`  — rovnou do HTML. Jen tam, kde je hlasování pár, a má to
   *      fungovat i bez JavaScriptu.
   *
   * Při `ostruvek` musí být na stránce komponenta `JmenoviteData`, jinak
   * rozpis zůstane prázdný a napíše to.
   */
  jmenovite?: 'ostruvek' | 'primo';
}

const { h, ciselnik, vazby = [], zname, jmenovite = 'ostruvek' } = Astro.props;
const skupiny = jmenovite === 'primo' ? souhrnHlasu(h) : null;
const nazvyTagu = h.tagy.map((t) => ciselnik.get(t)?.nazev ?? t).join(' ');
const hledat = bezDiakritiky(`${h.nazev} ${h.bod} ${nazvyTagu} ${nazevOrganu(h.organ)}`);
---

<li
  class="polozka"
  data-hlasovani
  data-tagy={h.tagy.join(' ')}
  data-organ={h.organ}
  data-rok={h.rok ?? ''}
  data-vysledek={h.vysledek}
  data-hledat={hledat}
  data-vazba={vazby.length > 0 ? '1' : undefined}
>
  <div class="polozka__hlava">
    <span>{nazevOrganu(h.organ)}</span>
    <span>{datumKratke(h.datum)}</span>
    <span class="mono">bod {h.bod}</span>
  </div>

  <h3 class="polozka__nazev">{h.nazev}</h3>

  <div class="polozka__meta">
    <span class={`vysledek vysledek--${tridaVysledku(h.vysledek)}`}>
      <span class="vysledek__tecka" aria-hidden="true"></span>
      {nazevVysledku(h.vysledek)}
    </span>
    <span class="rozdeleni-hlasu">
      <span>pro {h.pro}</span>
      <span>proti {h.proti}</span>
      <span>zdrželo se {h.zdrzel}</span>
      {h.nehlasoval > 0 && <span>nehlasovalo {h.nehlasoval}</span>}
    </span>
    <Znacky tagy={h.tagy} ciselnik={ciselnik} />
  </div>

  <Vazby vazby={vazby} zname={zname} />

  {
    h.jmenovite.length > 0 &&
      (skupiny ? (
        <details class="tabulkovy-pohled">
          <summary>Jmenovité hlasování ({h.jmenovite.length})</summary>
          <div class="mrizka-2">
            {(
              [
                ['Pro', skupiny.pro],
                ['Proti', skupiny.proti],
                ['Zdrželi se', skupiny.zdrzel],
                ['Ostatní', skupiny.ostatni],
              ] as const
            ).map(([nadpis, lide]) =>
              lide.length > 0 ? (
                <div>
                  <strong>
                    {nadpis} ({lide.length})
                  </strong>
                  <ul>
                    {lide.map((j) => (
                      <li>
                        <a href={`/lide/${j.osoba_id}`}>{j.jmeno}</a>
                        {j.strana && <span class="stav-dat__zdroj"> · {j.strana}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null,
            )}
          </div>
        </details>
      ) : (
        /* Rozpis se poskládá z ostrůvku až při rozbalení. Do té doby je tu
           jeden prázdný <div> místo dvaceti odkazů — právě to drží stránku
           s tisíci hlasováními otevíratelnou. */
        <details class="tabulkovy-pohled" data-jmenovite={h.id}>
          <summary>Jmenovité hlasování ({h.jmenovite.length})</summary>
          <div class="mrizka-2" data-jmenovite-obsah />
        </details>
      ))
  }
</li>
