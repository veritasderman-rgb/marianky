---
import '../styles/global.css';
import { SEKCE_HLEDAT, SEKCE_UVOD, SKUPINY, skupinaSekce } from '../lib/sekce';
import { kresliZnak, nactiZnaky } from '../lib/znaky';
import Znacka from '../components/Znacka.astro';

export interface Props {
  titulek: string;
  /** Krátký úvodní odstavec pod nadpisem stránky. */
  uvod?: string;
  /** Klíč aktivní položky navigace. */
  aktivni?: string;
  /** Nadpis H1. Když chybí, použije se `titulek`. */
  nadpis?: string;
  /** Vypne obal `<h1>` — stránka si nadpis řeší sama. */
  bezNadpisu?: boolean;
  /** Nekreslit znak sekce u nadpisu (úvodní stránka má celý rozcestník). */
  bezZnaku?: boolean;
}

const { titulek, uvod, aktivni, nadpis, bezNadpisu = false, bezZnaku = false } = Astro.props;

/* Popis pro vyhledávače a náhledy při sdílení. Bere se úvodní odstavec
   stránky — je psaný pro čtenáře, takže funguje i tady. Když stránka úvod
   nemá, použije se popis celého přehledu; prázdný description je horší než
   obecný. */
const POPIS_WEBU =
  'Usnesení, hlasování, smlouvy, rozpočet i zápisy z komisí Mariánských Lázní ' +
  'na jednom místě — prohledávatelné, propojené a s odkazem na zdroj u každého čísla.';
const popisStranky = (uvod ?? POPIS_WEBU).replace(/\s+/g, ' ').slice(0, 300);

/* Na úvodní stránce je nadpis rovnou jméno webu; přilepit ho podruhé by
   dalo „Naše Mariánky v přehledech — Naše Mariánky v přehledech". */
const NAZEV_WEBU = 'Naše Mariánky v přehledech';
const ogNadpis = nadpis ?? titulek;
const ogTitulek = ogNadpis === NAZEV_WEBU ? ogNadpis : `${ogNadpis} — ${NAZEV_WEBU}`;

/* ── Navigace ─────────────────────────────────────────────────────────────
   Odkazy jsou seskupené podle toho, čeho se týkají — čtrnáct rovnocenných
   položek v jedné řadě se nedalo přečíst. Popisky mluví o obsahu, ne
   o názvu souboru: „/retez" je pro čtenáře „Od usnesení k penězům".
   ADRESY SE NEMĚNÍ, mění se jen to, co je na nich napsané.

   Samotný seznam sekcí žije v `lib/sekce.ts`, protože ho kromě nabídky
   používá i grafický rozcestník. Dvě kopie by se rozešly. */

const skupinyNavigace = SKUPINY;
const odkazUvod = SEKCE_UVOD;
const odkazHledat = SEKCE_HLEDAT;

/** Ve které skupině leží právě otevřená stránka — ta se označí. */
const aktivniSkupina = skupinaSekce(aktivni);

/* ── Znak sekce vedle nadpisu ────────────────────────────────────────────
   Tentýž obrázek, jaký má sekce na rozcestníku. Není to ozdoba: čtenář,
   který přišel z rozcestníku, podle něj pozná, že je tam, kam klikl.
   Na úvodní stránce se nekreslí — tam je rozcestník celý. */
const zZnaku = nactiZnaky();
const znakSekce = aktivni && !bezZnaku ? zZnaku.data?.znaky?.[aktivni] : undefined;
const svgZnaku =
  znakSekce && znakSekce.stav === 'ok'
    ? kresliZnak(znakSekce, `${nadpis ?? titulek}: ${znakSekce.hodnota} ${znakSekce.jednotka}`.trim())
    : '';
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Veřejný přehled. Vyhledávače smí dovnitř; to je celý smysl —
         kdo hledá „kdo hlasoval pro prodej", má sem dojít. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{titulek} — Naše Mariánky v přehledech</title>
    <meta name="description" content={popisStranky} />
    <meta property="og:site_name" content="Naše Mariánky v přehledech" />
    <meta property="og:title" content={ogTitulek} />
    <meta property="og:description" content={popisStranky} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      Motiv má tři stavy: "dark", "light" a výchozí "system" (bez stampu).
      Skript běží před vykreslením, aby nebliklo špatné pozadí. Když uživatel
      nic nezvolil, ŽÁDNÝ atribut se nenastaví a rozhodne prefers-color-scheme.
    -->
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem('motiv');
          if (m === 'dark' || m === 'light') {
            document.documentElement.setAttribute('data-theme', m);
          } else if (m === 'kolonada') {
            /* Zelená sada je světlá. Musí přebít systémový tmavý režim,
               jinak by se zelený text vykreslil na tmavém pozadí. */
            document.documentElement.setAttribute('data-theme', 'light');
            document.documentElement.setAttribute('data-paleta', 'kolonada');
          }
        } catch (e) {
          /* privátní režim — zůstane "system" */
        }
      })();
    </script>
  </head>

  <body>
    <a href="#obsah" class="vizualne-skryto">Přeskočit na obsah</a>

    <header class="hlavicka-webu">
      <div class="obal hlavicka-webu__radek">
        <a href="/" class="znacka-webu">
          <Znacka trida="znacka-webu__znak" />
          <span class="znacka-webu__slova">Naše Mariánky <span>v přehledech</span></span>
        </a>
        <nav class="navigace" aria-label="Hlavní navigace">
          <a
            class="navigace__odkaz"
            href={odkazUvod.cesta}
            aria-current={aktivni === odkazUvod.klic ? 'page' : undefined}
          >
            {odkazUvod.nazev}
          </a>

          {
            skupinyNavigace.map((s) => (
              <details class="navigace__skupina" data-nav-skupina data-aktivni={aktivniSkupina === s.nazev ? '1' : undefined}>
                <summary class="navigace__nazev">
                  {s.nazev}
                  <span class="navigace__sipka" aria-hidden="true" />
                </summary>
                <ul class="navigace__nabidka">
                  {s.sekce.map((o) => (
                    <li>
                      <a href={o.cesta} aria-current={aktivni === o.klic ? 'page' : undefined}>
                        <span class="navigace__polozka-nazev">{o.nazev}</span>
                        {o.popis && <span class="navigace__polozka-popis">{o.popis}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }

          <a
            class="navigace__odkaz"
            href={odkazHledat.cesta}
            aria-current={aktivni === odkazHledat.klic ? 'page' : undefined}
          >
            {odkazHledat.nazev}
          </a>
        </nav>
        <button
          type="button"
          class="prepinac-motivu"
          id="prepinac-motivu"
          aria-live="polite"
        >
          <span aria-hidden="true">◐</span>
          <span id="prepinac-motivu-popisek">Motiv: podle systému</span>
        </button>
      </div>
    </header>

    <main id="obsah" class="obal" data-pagefind-body>
      {
        !bezNadpisu &&
          (svgZnaku ? (
            <div class="hlava-sekce">
              <span class="hlava-sekce__znak znak" aria-hidden="true" set:html={svgZnaku} />
              <div class="hlava-sekce__text">
                <h1>{nadpis ?? titulek}</h1>
                {uvod && <p class="uvod">{uvod}</p>}
              </div>
            </div>
          ) : (
            <Fragment>
              <h1>{nadpis ?? titulek}</h1>
              {uvod && <p class="uvod">{uvod}</p>}
            </Fragment>
          ))
      }
      {bezNadpisu && uvod && <p class="uvod">{uvod}</p>}
      <slot />
    </main>

    <footer class="paticka-webu">
      <div class="obal">
        <p>
          Neveřejný přehled dění v Mariánských Lázních. Data pocházejí z veřejných
          zdrojů — portálu usnesení města, Městského zpravodaje, registru smluv,
          Hlídače státu, rejstříku ARES, volebních výsledků a otevřených dat
          o městě. Čísla a jména se propisují z dat, ne z generovaného textu.
        </p>
        <nav class="paticka-webu__odkazy" aria-label="Přehled sekcí">
          <div>
            <strong>Týdenní přehled</strong>
            <a href="/">Poslední vydání</a>
          </div>
          {
            skupinyNavigace.map((s) => (
              <div>
                <strong>{s.nazev}</strong>
                {s.sekce.map((o) => (
                  <a href={o.cesta}>{o.nazev}</a>
                ))}
              </div>
            ))
          }
          <div>
            <strong>Hledání</strong>
            <a href="/hledat">Hledat v přehledech</a>
          </div>
        </nav>
        <p>
          Mapy se kreslí z otevřených geodat; zdroj a licenci uvádí každá mapa u sebe.
          Nenačítá se nic z cizích serverů a o čtenáři se nic nesbírá.
        </p>
      </div>
    </footer>

    <script>
      /* ── Skupiny v navigaci ───────────────────────────────────────────
         Skupiny jsou <details>, takže fungují i bez JavaScriptu — rozbalí se
         klepnutím i klávesnicí. Skript jen přidává chování, které se od
         nabídky čeká: otevřená je vždy jen jedna, Escape a klepnutí vedle
         ji zavře. */
      {
        const skupiny = Array.from(
          document.querySelectorAll<HTMLDetailsElement>('[data-nav-skupina]'),
        );

        function zavriVse(krome?: HTMLDetailsElement) {
          for (const s of skupiny) if (s !== krome) s.open = false;
        }

        for (const s of skupiny) {
          s.addEventListener('toggle', () => {
            if (s.open) zavriVse(s);
          });
        }

        document.addEventListener('click', (e) => {
          const cil = e.target;
          if (cil instanceof Element && cil.closest('[data-nav-skupina]')) return;
          zavriVse();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const otevrena = skupiny.find((s) => s.open);
          if (!otevrena) return;
          otevrena.open = false;
          otevrena.querySelector('summary')?.focus();
        });
      }

      /* ── Přepínač motivu ──────────────────────────────────────────────
         Čtyři stavy v jednom tlačítku:
           podle systému → světlý → lázeňský → tmavý → podle systému

         „Lázeňský" je světlá sada v barvách města (modrá, žlutá, bílá).
         Je to varianta světlého motivu, ne pátý motiv — proto při něm
         zůstává `data-theme="light"` a přibývá jen `data-paleta`. Kdyby
         se mohl potkat s tmavým motivem, vznikl by modrý text na tmavém
         pozadí; tenhle přepínač to nedovolí. */
      {
        const koren = document.documentElement;
        const tlacitko = document.getElementById('prepinac-motivu');
        const popisek = document.getElementById('prepinac-motivu-popisek');
        const nazvy: Record<string, string> = {
          system: 'Motiv: podle systému',
          light: 'Motiv: světlý (lázeňský)',
          kolonada: 'Motiv: zelená kolonáda',
          dark: 'Motiv: tmavý',
        };
        const dalsiStav: Record<string, string> = {
          system: 'light',
          light: 'kolonada',
          kolonada: 'dark',
          dark: 'system',
        };

        function precti(): string {
          if (koren.getAttribute('data-paleta') === 'kolonada') return 'kolonada';
          const a = koren.getAttribute('data-theme');
          return a === 'dark' || a === 'light' ? a : 'system';
        }

        function zobraz() {
          if (popisek) popisek.textContent = nazvy[precti()] ?? nazvy.system;
        }

        function uloz(hodnota: string | null) {
          try {
            if (hodnota === null) localStorage.removeItem('motiv');
            else localStorage.setItem('motiv', hodnota);
          } catch {
            /* privátní režim — volba se neuloží, ale stránka funguje */
          }
        }

        tlacitko?.addEventListener('click', () => {
          const dalsi = dalsiStav[precti()] ?? 'system';
          koren.removeAttribute('data-paleta');
          if (dalsi === 'system') {
            koren.removeAttribute('data-theme');
            uloz(null);
          } else if (dalsi === 'kolonada') {
            /* Zelená sada je světlá. Musí přebít systémový tmavý režim,
               jinak by se zelený text vykreslil na tmavém pozadí. */
            koren.setAttribute('data-theme', 'light');
            koren.setAttribute('data-paleta', 'kolonada');
            uloz('kolonada');
          } else {
            koren.setAttribute('data-theme', dalsi);
            uloz(dalsi);
          }
          zobraz();
        });

        zobraz();
      }

      /* ── Rozpis jmenovitých hlasů na vyžádání ─────────────────────────
         Rozpisy nejsou v HTML, ale v JSON ostrůvku (JmenoviteData.astro).
         Stránka /hlasovani z nich měla 28,8 MB a asi 400 000 DOM uzlů —
         telefon na tom zamrzl dřív, než se stihla vykreslit. Teď se rozpis
         poskládá až ve chvíli, kdy ho někdo rozbalí, a jen ten jeden.

         Jména jdou do DOM přes textContent, nikdy přes innerHTML. Jsou to
         cizí data z portálu města. */
      {
        const ostruvek = document.getElementById('data-jmenovite');
        let data: { l: [string, string, string | null][]; h: Record<string, number[][]> } | null =
          null;

        function nacti() {
          if (data || !ostruvek?.textContent) return data;
          try {
            data = JSON.parse(ostruvek.textContent);
          } catch {
            data = null;
          }
          return data;
        }

        const NADPISY = ['Pro', 'Proti', 'Zdrželi se', 'Ostatní'];

        function poskladej(cil: HTMLElement, skupiny: number[][], lide: [string, string, string | null][]) {
          for (let i = 0; i < skupiny.length; i++) {
            const kdo = skupiny[i];
            if (!kdo?.length) continue;
            const blok = document.createElement('div');
            const nadpis = document.createElement('strong');
            nadpis.textContent = `${NADPISY[i]} (${kdo.length})`;
            blok.appendChild(nadpis);

            const seznam = document.createElement('ul');
            for (const idx of kdo) {
              const clovek = lide[idx];
              if (!clovek) continue;
              const [osobaId, jmeno, strana] = clovek;
              const radek = document.createElement('li');
              const odkaz = document.createElement('a');
              odkaz.href = `/lide/${osobaId}`;
              odkaz.textContent = jmeno;
              radek.appendChild(odkaz);
              if (strana) {
                const kde = document.createElement('span');
                kde.className = 'stav-dat__zdroj';
                kde.textContent = ` · ${strana}`;
                radek.appendChild(kde);
              }
              seznam.appendChild(radek);
            }
            blok.appendChild(seznam);
            cil.appendChild(blok);
          }
        }

        /* Jeden posluchač na celý dokument. Položek bývají tisíce a tisíc
           posluchačů by stálo víc než rozpisy samotné. */
        document.addEventListener(
          'toggle',
          (e) => {
            const el = e.target;
            if (!(el instanceof HTMLDetailsElement) || !el.open) return;
            const id = el.dataset.jmenovite;
            if (!id || el.dataset.hotovo === '1') return;

            const cil = el.querySelector<HTMLElement>('[data-jmenovite-obsah]');
            if (!cil) return;
            el.dataset.hotovo = '1';

            const d = nacti();
            const skupiny = d?.h?.[id];
            if (!d || !skupiny) {
              /* Chybějící rozpis se přizná. Prázdný blok by tvrdil, že se
                 jmenovitě nehlasovalo — a to je něco jiného. */
              const hlaska = document.createElement('p');
              hlaska.className = 'stav-dat stav-dat--chyba';
              hlaska.textContent = 'Rozpis se nepodařilo načíst. Jmenovité hlasy jsou i na stránce každého člověka.';
              cil.appendChild(hlaska);
              return;
            }
            poskladej(cil, skupiny, d.l);
          },
          true, /* toggle nebublá, musí se odchytit při zachytávání */
        );
      }

      /* ── Tooltipy grafů ───────────────────────────────────────────────
         Hodnoty se do DOM vkládají přes textContent, nikdy přes innerHTML —
         názvy firem jsou cizí data. Tooltip nic negatuje: každé číslo je
         zároveň v rozbalovací tabulce pod grafem. */
      {
        interface TipData {
          t: string;
          r: [string, string][];
          c: string | null;
        }

        const bublina = document.createElement('div');
        bublina.className = 'tooltip';
        bublina.setAttribute('role', 'tooltip');
        document.body.appendChild(bublina);

        function vykresli(d: TipData) {
          bublina.textContent = '';
          const hlava = document.createElement('div');
          hlava.className = 'tooltip__nadpis';
          if (d.c) {
            const klic = document.createElement('span');
            klic.className = 'tooltip__klic';
            klic.style.background = d.c;
            hlava.appendChild(klic);
          }
          hlava.appendChild(document.createTextNode(d.t));
          bublina.appendChild(hlava);
          for (const dvojice of d.r ?? []) {
            const radek = document.createElement('div');
            radek.className = 'tooltip__radek';
            const l = document.createElement('span');
            l.className = 'tooltip__popisek';
            l.textContent = String(dvojice[0]);
            const v = document.createElement('span');
            v.className = 'tooltip__hodnota';
            v.textContent = String(dvojice[1]);
            radek.append(l, v);
            bublina.appendChild(radek);
          }
        }

        function umisti(x: number, y: number) {
          const r = bublina.getBoundingClientRect();
          let lx = x + 14;
          let ly = y + 16;
          if (lx + r.width > window.innerWidth - 8) lx = x - r.width - 14;
          if (ly + r.height > window.innerHeight - 8) ly = y - r.height - 14;
          bublina.style.left = `${Math.max(8, lx)}px`;
          bublina.style.top = `${Math.max(8, ly)}px`;
        }

        function skryj() {
          bublina.removeAttribute('data-viditelny');
        }

        function zdroj(cil: EventTarget | null): HTMLElement | null {
          if (!(cil instanceof Element)) return null;
          return cil.closest<HTMLElement>('[data-tip]');
        }

        function otevri(el: HTMLElement, x: number, y: number) {
          const syrove = el.getAttribute('data-tip');
          if (!syrove) return;
          let d: TipData;
          try {
            d = JSON.parse(syrove) as TipData;
          } catch {
            return;
          }
          vykresli(d);
          bublina.setAttribute('data-viditelny', '1');
          umisti(x, y);
        }

        document.addEventListener('pointermove', (e) => {
          const el = zdroj(e.target);
          if (!el) {
            skryj();
            return;
          }
          otevri(el, e.clientX, e.clientY);
        });

        document.addEventListener('pointerleave', skryj);
        document.addEventListener('scroll', skryj, { passive: true });

        document.addEventListener('focusin', (e) => {
          const el = zdroj(e.target);
          if (!el) {
            skryj();
            return;
          }
          const r = el.getBoundingClientRect();
          otevri(el, r.left + r.width / 2, r.bottom);
        });
        document.addEventListener('focusout', skryj);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') skryj();
        });
      }
    </script>
  </body>
</html>
