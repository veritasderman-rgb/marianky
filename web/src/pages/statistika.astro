---
/**
 * Časové řady o městě z ČSÚ.
 *
 * Dvě pravidla drží celou stránku pohromadě:
 *
 *   1. **Nikdy dvě osy Y** (web/DESIGN.md §2 bod 1). Do jednoho grafu smí jen
 *      členění téhož ukazatele — tam je jednotka z definice stejná. Napříč
 *      ukazateli se srovnává indexem ke společnému základu, ne druhou osou.
 *   2. **Chybějící hodnota není nula.** Zdroj rozlišuje „údaj v datech není"
 *      a „ČSÚ ho tají kvůli malému počtu subjektů"; obojí je neznámo a v grafu
 *      to je mezera, ne nulový bod.
 */
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import Dlazdice from '../components/Dlazdice.astro';
import GrafKarta from '../components/GrafKarta.astro';
import type { Varianta } from '../components/GrafKarta.astro';
import type { Polozka } from '../components/Dlazdice.astro';
import {
  formatujHodnotu,
  hodnotaVObdobi,
  nactiCsu,
  popisCleneni,
  popisekObdobi,
  rozsahUkazatele,
  souvisleObdobi,
  ukazateleSady,
  type Perioda,
  type Ukazatel,
} from '../lib/csu';
import { grafSpojnice, type SerieRady } from '../lib/grafy_rady';
import JakPocitame from '../components/JakPocitame.astro';
import { cislo, datumVolneKratke, sklonuj } from '../lib/format';

const zCsu = nactiCsu();
const rady = zCsu.data.rady ?? [];
const sady = zCsu.data.sady ?? [];
const maData = rady.length > 0;

const NAZVY_PERIODY: Record<Perioda, string> = {
  rok: 'ročně',
  mesic: 'měsíčně',
  scitani: 'při sčítání lidu',
  jina: 'nepravidelně',
};

/* ── Graf jednoho ukazatele ────────────────────────────────────────────
   Období se doplní souvisle: rok nebo měsíc, za který zdroj údaj nemá, musí
   na ose zabírat místo, jinak by se řada scvrkla a lhala o rozestupech. */

function grafUkazatele(u: Ukazatel): Varianta | null {
  const rozsah = rozsahUkazatele(u);
  if (!rozsah) return null;
  const obdobi = souvisleObdobi(u.perioda, rozsah.od, rozsah.do);
  if (obdobi.length === 0) return null;

  const formatuj = formatujHodnotu(u.jednotka);
  const serie: SerieRady[] = u.rady.map((r) => ({
    klic: r.kod,
    nazev: popisCleneni(r),
    hodnoty: obdobi.map((o) => hodnotaVObdobi(r, o, u.perioda).hodnota),
  }));

  const graf = grafSpojnice(
    obdobi.map((o) => popisekObdobi(o, u.perioda)),
    serie,
    u.nazev,
    u.jednotka,
    formatuj,
  );

  graf.tabulka = {
    hlavicka: [
      { nazev: 'Období' },
      ...u.rady.map((r) => ({ nazev: `${popisCleneni(r)}${u.jednotka ? ` (${u.jednotka})` : ''}`, cislo: true })),
    ],
    radky: obdobi.map((o) => [
      popisekObdobi(o, u.perioda),
      ...u.rady.map((r) => {
        const h = hodnotaVObdobi(r, o, u.perioda);
        if (h.hodnota !== null) return formatuj(h.hodnota);
        if (h.duverne) return 'ČSÚ údaj tají (malý počet subjektů)';
        return 'údaj není';
      }),
    ]),
  };

  const chybejicich = obdobi.filter((o) =>
    u.rady.every((r) => hodnotaVObdobi(r, o, u.perioda).hodnota === null),
  ).length;
  if (chybejicich > 0) {
    graf.poznamky.push(
      `Za ${cislo(chybejicich)} ${sklonuj(chybejicich, 'období', 'období', 'období')} nemá zdroj údaj ani u jedné řady. Osa je přesto vede — mezera v čase je informace, nula by byla lež.`,
    );
  }
  const tajene = u.rady.some((r) => [...r.body.values()].some((b) => b.duverne));
  if (tajene) {
    graf.poznamky.push(
      'Některé hodnoty ČSÚ tají kvůli malému počtu subjektů. V tabulce jsou označené; v grafu jsou jako mezera, protože jde o neznámo, ne o nulu.',
    );
  }
  if (u.perioda === 'scitani') {
    graf.poznamky.push('Body jsou umístěné na spojité ose let, ne po sčítáních — rozestupy mezi sčítáními jsou tedy skutečné.');
  }

  return { klic: u.klic, popisek: u.nazev, graf };
}

/* ── Index ke společnému základu ────────────────────────────────────────
   Jediný poctivý způsob, jak dát různě velké veličiny do jednoho obrázku.
   Základ = nejstarší rok, ve kterém mají údaj VŠECHNY srovnávané řady. */

const SROVNAVANE = ['obyvatel_celkem', 'hoste_celkem', 'prenocovani_celkem', 'podil_nezamestnanych', 'byty_celkem'];

const proIndex = SROVNAVANE.map((kod) => rady.find((r) => r.kod === kod)).filter(
  (r): r is (typeof rady)[number] => r !== undefined && r.perioda !== 'mesic',
);

const rokyIndexu = (() => {
  if (proIndex.length < 2) return [];
  const od = Math.max(...proIndex.map((r) => Number((r.od ?? '9999').slice(0, 4))));
  const doo = Math.min(...proIndex.map((r) => Number((r.do ?? '0').slice(0, 4))));
  const ven: string[] = [];
  for (let x = od; x <= doo; x++) ven.push(String(x));
  return ven;
})();

const zakladniRok =
  rokyIndexu.find((rok) => proIndex.every((r) => (hodnotaVObdobi(r, rok, 'rok').hodnota ?? 0) > 0)) ?? null;

const variantaIndexu: Varianta | null =
  zakladniRok !== null && proIndex.length > 1
    ? (() => {
        const serie: SerieRady[] = proIndex.map((r) => {
          const zaklad = hodnotaVObdobi(r, zakladniRok, 'rok').hodnota as number;
          return {
            klic: r.kod,
            nazev: `${r.nazev}${r.jednotka ? ` (${r.jednotka})` : ''}`,
            hodnoty: rokyIndexu.map((rok) => {
              const h = hodnotaVObdobi(r, rok, 'rok').hodnota;
              return h === null ? null : (h / zaklad) * 100;
            }),
          };
        });
        const graf = grafSpojnice(rokyIndexu, serie, 'Srovnání vývoje — index', `index, ${zakladniRok} = 100`, (v) =>
          v.toFixed(0),
        );
        graf.poznamky.push(
          `Každá řada je přepočtená na index, kde rok ${zakladniRok} = 100. Jde o srovnání SMĚRU a rychlosti změny, ne velikosti — index 120 u obyvatel a u přenocování znamená stejný růst, ne stejný počet.`,
        );
        graf.poznamky.push(
          'Skutečné počty tenhle graf neukazuje — jsou v grafech jednotlivých ukazatelů níže a v jejich tabulkách.',
        );
        graf.poznamky.push(
          'Že dvě křivky jdou stejným směrem, neznamená, že spolu souvisejí. Přehled o žádné souvislosti mezi řadami nic netvrdí.',
        );
        return { klic: 'index', popisek: `Index (${zakladniRok} = 100)`, graf };
      })()
    : null;

/* ── Dlaždice ──────────────────────────────────────────────────────────── */

const vsechnaObdobi = rady.flatMap((r) => [...r.body.keys()]);
const roky = vsechnaObdobi.map((o) => Number(o.slice(0, 4))).filter((r) => Number.isFinite(r));
const bodu = rady.reduce((s, r) => s + r.body.size, 0);
const tajenych = rady.reduce((s, r) => s + [...r.body.values()].filter((b) => b.duverne).length, 0);

const dlazdice: Polozka[] = maData
  ? [
      {
        popisek: 'Časových řad',
        hodnota: cislo(rady.length),
        doplnek: `v ${cislo(sady.length)} ${sklonuj(sady.length, 'datové sadě', 'datových sadách', 'datových sadách')}`,
      },
      {
        popisek: 'Rozsah dat',
        hodnota: roky.length > 0 ? `${Math.min(...roky)}–${Math.max(...roky)}` : '—',
        doplnek: 'nejstarší a nejnovější období napříč řadami',
      },
      {
        popisek: 'Datových bodů',
        hodnota: cislo(bodu),
        doplnek: tajenych > 0 ? `${cislo(tajenych)} z nich ČSÚ tají` : 'žádný údaj zdroj netají',
      },
      {
        popisek: 'Společný základ indexu',
        hodnota: zakladniRok ?? '—',
        doplnek:
          zakladniRok === null
            ? 'řady nemají společný rok s údajem u všech'
            : 'rok, ve kterém mají údaj všechny srovnávané řady',
      },
    ]
  : [];

const sadyKZobrazeni = sady.filter((s) => rady.some((r) => r.sada === s.kod));
const bezSady = rady.filter((r) => !sady.some((s) => s.kod === r.sada));
---

<Zaklad
  titulek="Statistika města"
  aktivni="statistika"
  nadpis="Časové řady o městě"
  uvod="Obyvatelstvo, nezaměstnanost, cestovní ruch a bydlení z otevřených dat ČSÚ. Každý ukazatel má vlastní graf; společné srovnání ukazuje graf indexů, protože počet obyvatel a počet nocí v hotelu se přímo srovnat nedají."
>
  <StavDat
    stav={zCsu.stav}
    zdroj={zCsu.zdroj}
    co="Časové řady o městě"
    prazdno={zCsu.stav === 'ok' && rady.length === 0}
    modul="otevřená data — ČSÚ"
  />

  {
    maData && (
      <>
        <Dlazdice polozky={dlazdice} />

        {zCsu.data.poznamka && <p class="graf-poznamka">{zCsu.data.poznamka}</p>}

        {variantaIndexu && (
          <GrafKarta
            id="index"
            nadpis="Srovnání vývoje jedním pohledem"
            popis="Různě velké veličiny jde srovnat jen indexem ke společnému základu: každá řada začíná na sto a další roky ukazují, o kolik procent se od té doby posunula. Dvě různá měřítka v jednom obrázku by naznačovala souvislost, kterou data nedokládají."
            varianty={[variantaIndexu]}
          />
        )}

        {sadyKZobrazeni.map((s) => {
          const ukazatele = ukazateleSady(rady, s.kod)
            .map(grafUkazatele)
            .filter((v): v is Varianta => v !== null);
          if (ukazatele.length === 0) return null;
          return (
            <section>
              <h2 id={`sada-${s.kod}`}>{s.nazev}</h2>
              <p class="graf-poznamka">
                Periodicita: {NAZVY_PERIODY[s.perioda]}
                {s.od && s.do && ` · období ${datumVolneKratke(s.od)} – ${datumVolneKratke(s.do)}`}
                {s.zaznamu !== null && ` · ${cislo(s.zaznamu)} záznamů`}
                {s.ukazatelu !== null && ` · ${cislo(s.ukazatelu)} ${sklonuj(s.ukazatelu, 'ukazatel', 'ukazatele', 'ukazatelů')}`}
                {s.stav && s.stav !== 'ok' && ` · stav zdroje: ${s.stav}`}
              </p>
              {ukazatele.map((v) => (
                <GrafKarta
                  id={`ukazatel-${v.klic}`}
                  nadpis={v.popisek}
                  popis="Čáry v jednom grafu jsou členění téhož ukazatele, svislá osa proto platí pro všechny. Přerušená čára znamená období bez údaje — není to pokles na nulu."
                  varianty={[v]}
                />
              ))}
            </section>
          );
        })}

        {bezSady.length > 0 && (
          <section>
            <h2>Ostatní řady</h2>
            <p class="graf-poznamka">
              {cislo(bezSady.length)}{' '}
              {sklonuj(bezSady.length, 'řada nepatří', 'řady nepatří', 'řad nepatří')} k žádné sadě
              popsané v přehledu zdroje.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Ukazatel</th>
                    <th scope="col">Členění</th>
                    <th scope="col">Období</th>
                    <th scope="col" class="cislo">Bodů</th>
                  </tr>
                </thead>
                <tbody>
                  {bezSady.map((r) => (
                    <tr>
                      <td>{r.nazev}</td>
                      <td>{popisCleneni(r)}</td>
                      <td>{r.od && r.do ? `${datumVolneKratke(r.od)} – ${datumVolneKratke(r.do)}` : '—'}</td>
                      <td class="cislo">{cislo(r.body.size)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <p class="graf-poznamka">
          Čísla pocházejí ze zdroje beze změny — přehled je nepřepočítává, nevyhlazuje ani
          nedopočítává chybějící období.
        </p>

        <JakPocitame>
          <p>
            Řady vede Český statistický úřad. Přehled je jen zobrazuje: nic se nedopočítává,
            neprůměruje ani neprodlužuje za poslední známý údaj.
          </p>
          <ul>
            <li>
              <strong>Chybějící hodnota není nula.</strong> Zdroj rozlišuje „údaj nemáme" a
              „údaj se kvůli malému počtu subjektů nezveřejňuje". Obojí je v grafu mezera, ne
              pokles na nulu.
            </li>
            <li>
              <strong>V jednom grafu je vždy jedna veličina.</strong> Počet obyvatel a počet
              přenocování mají jiné jednotky i řády; kdyby stály v jednom obrázku vedle sebe,
              vypadaly by jako spojité nádoby.
            </li>
            <li>
              <strong>Srovnání dělá index.</strong> Každá řada se vztáhne ke společnému
              základnímu roku (sto procent) a dál se sleduje jen její změna.
            </li>
          </ul>
        </JakPocitame>
        {zCsu.data.zdroj && (
          <p class="graf-poznamka">
            Zdroj dat: <a href={zCsu.data.zdroj} rel="noreferrer noopener">{zCsu.data.zdroj}</a>
            {zCsu.data.licence && (
              <>
                {' · podmínky užití: '}
                <a href={zCsu.data.licence} rel="noreferrer noopener">{zCsu.data.licence}</a>
              </>
            )}
          </p>
        )}
      </>
    )
  }
</Zaklad>
