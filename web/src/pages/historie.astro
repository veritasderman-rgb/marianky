---
/**
 * Dějiny města po obdobích.
 *
 * U historie platí §3.7 dvojnásob: událost z městské kroniky a údaj převzatý
 * z lázeňské literatury nejsou stejně jistá věc. Jistota se proto propisuje
 * do tvaru značky na ose i do tabulky slovy — a když ji zdroj neuvádí, napíše
 * se „jistota v datech není", nikdy „doloženo".
 *
 * Přesnost data se nedoplňuje: „1865" zůstane rokem.
 */
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import Dlazdice from '../components/Dlazdice.astro';
import CasovaOsa from '../components/CasovaOsa.astro';
import type { Polozka } from '../components/Dlazdice.astro';
import { nactiLidi, spojStavy } from '../lib/data';
import { historieNaOsu, nactiPrehledHistorie, nactiUdalostiHistorie } from '../lib/historie';
import { nactiCasovouOsu, popisDatumu, slucUdalosti, jeNejista, popisekJistoty, udalost } from '../lib/osa';
import type { Jistota } from '../lib/vazby';
import { cislo, sklonuj } from '../lib/format';

const zPrehledu = nactiPrehledHistorie();
const zUdalosti = nactiUdalostiHistorie();
const zLidi = nactiLidi();
const zOsy = nactiCasovouOsu();
const { poznamky: poznamkyStavu } = spojStavy(zPrehledu, zUdalosti);

const obdobi = zPrehledu.data.obdobi ?? [];
const udalosti = zUdalosti.data ?? [];
const maData = obdobi.length > 0 || udalosti.length > 0;

const lide = new Map((zLidi.data ?? []).map((o) => [o.id, o]));

const naOse = slucUdalosti(
  historieNaOsu(udalosti, obdobi),
  (zOsy.data ?? []).filter((u) => u.druh === 'historie'),
);

/* Osobnosti, které se v dějinách objevují. Odkaz vede jen tam, kde profil je. */
const osobyVHistorii = new Map<string, number>();
for (const u of udalosti) {
  for (const id of u.osoby) osobyVHistorii.set(id, (osobyVHistorii.get(id) ?? 0) + 1);
}
const propojeneOsobnosti = [...osobyVHistorii.entries()]
  .map(([id, pocet]) => ({ id, pocet, osoba: lide.get(id) ?? null }))
  .sort((a, b) => b.pocet - a.pocet || a.id.localeCompare(b.id, 'cs-CZ'));

const roky = udalosti.map((u) => u.rok).filter((r): r is number => r !== null);

/** Jistota tak, jak ji zdroj píše. Co se nedá zařadit, zůstane „neuvedeno". */
function jistotaZ(v: string | null): Jistota {
  if (!v) return null;
  const s = v.trim().toLowerCase();
  if (s.startsWith('nizk') || s.startsWith('nízk') || s.startsWith('nejist') || s.startsWith('legend') || s.startsWith('trad')) {
    return 'nizka';
  }
  if (s.startsWith('stredn') || s.startsWith('střed')) return 'stredni';
  if (s.startsWith('vysok') || s.startsWith('dolož') || s.startsWith('dolozen')) return 'vysoka';
  return null;
}

/** Datum tak přesně, jak ho zdroj uvádí — rok se nedoplňuje na 1. leden. */
function kdy(u: { datum: string; datum_do: string | null }): string {
  return popisDatumu({ ...prazdnaUdalost, datum: u.datum, datum_do: u.datum_do });
}
const prazdnaUdalost = udalost({ id: '', datum: '', druh: 'historie', nadpis: '' });

const nejista = udalosti.filter((u) => jeNejista(jistotaZ(u.jistota))).length;

const dlazdice: Polozka[] = maData
  ? [
      {
        popisek: 'Období v přehledu',
        hodnota: cislo(obdobi.length),
        doplnek: obdobi.length > 0 ? `${obdobi[0].nazev} a další` : undefined,
      },
      {
        popisek: 'Zaznamenaných událostí',
        hodnota: cislo(udalosti.length),
        doplnek: roky.length > 0 ? `od roku ${Math.min(...roky)} do ${Math.max(...roky)}` : undefined,
      },
      {
        popisek: 'Událostí s nízkou jistotou',
        hodnota: cislo(nejista),
        doplnek: nejista > 0 ? 'na ose dutá přerušovaná značka' : 'zdroj žádnou takto neoznačuje',
        stav:
          nejista > 0
            ? { uroven: 'pozor', text: 'nejsou to doložená fakta' }
            : { uroven: 'neznamo', text: 'jistota se v datech nerozlišuje' },
      },
      {
        popisek: 'Propojených osobností',
        hodnota: cislo(propojeneOsobnosti.length),
        doplnek: `${cislo(propojeneOsobnosti.filter((o) => o.osoba).length)} má profil v přehledu lidí`,
      },
    ]
  : [];

function udalostiObdobi(id: string) {
  return udalosti.filter((u) => u.obdobi === id);
}
const bezObdobi = udalosti.filter((u) => !u.obdobi || !obdobi.some((o) => o.id === u.obdobi));
---

<Zaklad
  titulek="Dějiny města"
  aktivni="historie"
  nadpis="Dějiny města"
  uvod="Historie Mariánských Lázní po obdobích, s časovou osou a propojením na osobnosti. Přehled uvádí, co je v datech, a odlišuje doložené od nejistého — nedoplňuje ani letopočty, ani souvislosti."
>
  <StavDat
    stav={zPrehledu.stav === 'ok' ? zUdalosti.stav : zPrehledu.stav}
    zdroj="historie/prehled.json, historie/udalosti.json"
    co="Dějiny města po obdobích"
    prazdno={zPrehledu.stav === 'ok' && zUdalosti.stav === 'ok' && !maData}
    modul="historie města"
    poznamky={poznamkyStavu}
  />

  {
    maData && (
      <>
        {zPrehledu.data.uvod && <p>{zPrehledu.data.uvod}</p>}

        <Dlazdice polozky={dlazdice} />

        {naOse.length > 0 && (
          <CasovaOsa
            id="osa-historie"
            nadpis="Časová osa dějin města"
            udalosti={naOse}
            popis="Období jsou vodorovné pruhy, jednotlivé události značky. Osa je lineární v čase, takže staletí bez záznamu jsou vidět jako prázdná plocha — mezera v našich datech je taky informace."
            zdroje={[
              'historie/prehled.json',
              'historie/udalosti.json',
              ...(zOsy.stav === 'ok' ? ['casova_osa/'] : []),
            ]}
            neuplnost="Osa neobsahuje dějiny města, ale záznamy, které o nich máme. Řídké období nemusí znamenat, že se nic nedělo."
          />
        )}

        {obdobi.length > 0 && <h2>Období</h2>}

        {obdobi.map((o) => {
          const vObdobi = udalostiObdobi(o.id);
          return (
            <section class="karta" id={`obdobi-${o.id}`}>
              <div class="obdobi-hlava">
                <h3 class="karta__nadpis">{o.nazev}</h3>
                <span class="obdobi-roky">
                  {o.od !== null || o.do !== null
                    ? `${o.od ?? '?'} – ${o.do ?? 'trvá'}`
                    : 'roky v datech nejsou'}
                </span>
              </div>
              {o.popis && <p>{o.popis}</p>}

              {vObdobi.length > 0 && (
                <div class="tabulka-obal">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Kdy</th>
                        <th scope="col">Událost</th>
                        <th scope="col">Jistota</th>
                        <th scope="col">Osobnosti</th>
                      </tr>
                    </thead>
                    <tbody>
                      {vObdobi.map((u) => (
                        <tr>
                          <td class="cislo">{kdy(u)}</td>
                          <td>
                            {u.odkaz ? (
                              <a href={u.odkaz} rel={u.odkaz.startsWith('http') ? 'noreferrer noopener' : undefined}>
                                {u.nazev}
                              </a>
                            ) : (
                              u.nazev
                            )}
                            {u.popis && <div class="duvod__detail">{u.popis}</div>}
                          </td>
                          <td>{popisekJistoty(jistotaZ(u.jistota))}</td>
                          <td>
                            {u.osoby.length === 0
                              ? '—'
                              : u.osoby.map((id, i) => (
                                  <>
                                    {i > 0 && ', '}
                                    {lide.has(id) ? <a href={`/lide/${id}`}>{lide.get(id)?.jmeno ?? id}</a> : id}
                                  </>
                                ))}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {vObdobi.length === 0 && (
                <p class="graf-poznamka">K tomuhle období nemáme v datech žádnou jednotlivou událost.</p>
              )}

              {o.zdroje.length > 0 && (
                <p class="graf-poznamka">
                  Zdroje:{' '}
                  {o.zdroje.map((z, i) => (
                    <>
                      {i > 0 && ' · '}
                      {z.startsWith('http') ? <a href={z} rel="noreferrer noopener">{z}</a> : z}
                    </>
                  ))}
                </p>
              )}
            </section>
          );
        })}

        {bezObdobi.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Události mimo zařazená období</h2>
            <p class="karta__podnadpis">
              {cislo(bezObdobi.length)}{' '}
              {sklonuj(bezObdobi.length, 'událost nemá', 'události nemají', 'událostí nemá')} v datech
              přiřazené období, nebo odkazuje na období, které v přehledu není.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Kdy</th>
                    <th scope="col">Událost</th>
                    <th scope="col">Zdroje</th>
                  </tr>
                </thead>
                <tbody>
                  {bezObdobi.map((u) => (
                    <tr>
                      <td class="cislo">{kdy(u)}</td>
                      <td>{u.nazev}</td>
                      <td>{u.zdroje.length > 0 ? u.zdroje.join(', ') : 'v datech nejsou'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {propojeneOsobnosti.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Osobnosti v dějinách města</h2>
            <p class="karta__podnadpis">
              Kdo se objevuje u zaznamenaných událostí. Odkaz vede jen tam, kde má osoba profil
              v našem přehledu lidí — u zbylých zůstává jen identifikátor ze zdroje.
            </p>
            <ul class="seznam-temat">
              {propojeneOsobnosti.map((o) => (
                <li class="seznam-temat__polozka">
                  {o.osoba ? <a href={`/lide/${o.id}`}>{o.osoba.jmeno}</a> : <span class="mono">{o.id}</span>}
                  <span class="seznam-temat__pocet">
                    {cislo(o.pocet)} {sklonuj(o.pocet, 'událost', 'události', 'událostí')}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {zPrehledu.data.zdroje.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Zdroje k dějinám města</h2>
            <ul>
              {zPrehledu.data.zdroje.map((z) => (
                <li>{z.startsWith('http') ? <a href={z} rel="noreferrer noopener">{z}</a> : z}</li>
              ))}
            </ul>
          </section>
        )}

        <p class="graf-poznamka">
          Historické údaje se liší jistotou. Kde zdroj uvádí, jak jistý údaj je, přehled to
          přebírá; kde neuvádí, píše „jistota v datech není" — a to není totéž jako „doloženo".
          Přehled sám nic nedatuje, nespojuje a nedopočítává.
        </p>
      </>
    )
  }
</Zaklad>
