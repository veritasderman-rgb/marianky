---
/**
 * Dějiny města po obdobích.
 *
 * Zdroj sám formuluje pravidlo, které tahle stránka jen dodržuje:
 *
 *   > Pole `jistota` nabývá hodnot `dolozeno` a `nejiste` (prameny se
 *   > rozcházejí, rozpor je v poli `poznamka`). **Web nesmí nejistý údaj
 *   > zobrazit jako doložený.**
 *
 * Nejistý záznam má proto na ose jiný tvar značky, v tabulce vlastní sloupec
 * a rozpor je vypsaný slovy. Přesnost datace se nedoplňuje — „1193" zůstane
 * rokem, nestane se z něj 1. leden.
 */
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import Dlazdice from '../components/Dlazdice.astro';
import CasovaOsa from '../components/CasovaOsa.astro';
import JakPocitame from '../components/JakPocitame.astro';
import type { Polozka } from '../components/Dlazdice.astro';
import { nactiLidi, spojStavy } from '../lib/data';
import { historieNaOsu, nactiPrehledHistorie, nactiUdalostiHistorie, type Zdroj } from '../lib/historie';
import { jeSporne, nactiOsuMesta, popisDatumu, popisekJistoty, slucUdalosti } from '../lib/osa';
import { cislo, polidstiData, sklonuj } from '../lib/format';

const zPrehledu = nactiPrehledHistorie();
const zUdalosti = nactiUdalostiHistorie();
const zLidi = nactiLidi();
const zOsyMesta = nactiOsuMesta();
const { poznamky: poznamkyStavu } = spojStavy(zPrehledu, zUdalosti);

const obdobi = zPrehledu.data.obdobi ?? [];
const udalosti = zUdalosti.data.udalosti ?? [];
const maData = obdobi.length > 0 || udalosti.length > 0;

const lide = new Map((zLidi.data ?? []).map((o) => [o.id, o]));
const zdroje = new Map<string, Zdroj>([...zPrehledu.data.zdroje, ...zUdalosti.data.zdroje]);

/* Do osy jdou období, jednotlivé události i to, co k dějinám města přiřazuje
   jednotná časová osa (volby, velké milníky) — a nic víc. */
const naOse = slucUdalosti(
  historieNaOsu(udalosti, obdobi),
  (zOsyMesta.data.udalosti ?? []).filter((u) => u.druh === 'historie' || u.druh === 'volby'),
);

const osobyVHistorii = new Map<string, number>();
for (const u of udalosti) for (const id of u.osoby) osobyVHistorii.set(id, (osobyVHistorii.get(id) ?? 0) + 1);
for (const o of obdobi) for (const id of o.osobnosti) osobyVHistorii.set(id, (osobyVHistorii.get(id) ?? 0) + 1);

const propojeneOsobnosti = [...osobyVHistorii.entries()]
  .map(([id, pocet]) => ({ id, pocet, osoba: lide.get(id) ?? null }))
  .sort((a, b) => b.pocet - a.pocet || a.id.localeCompare(b.id, 'cs-CZ'));

const nejistych = udalosti.filter((u) => jeSporne(u.jistota)).length;
const rozsah = zPrehledu.data.statistika.rozsah;

const dlazdice: Polozka[] = maData
  ? [
      {
        popisek: 'Období v přehledu',
        hodnota: cislo(obdobi.length),
        doplnek: rozsah ? `dějiny od roku ${rozsah[0]} do ${rozsah[1]}` : undefined,
      },
      {
        popisek: 'Zaznamenaných událostí',
        hodnota: cislo(udalosti.length),
        doplnek: `${cislo(propojeneOsobnosti.length)} ${sklonuj(propojeneOsobnosti.length, 'osobnost', 'osobnosti', 'osobností')} v nich figuruje`,
      },
      {
        popisek: 'Nejistých údajů',
        hodnota: cislo(nejistych),
        doplnek:
          nejistych > 0
            ? 'prameny se u nich rozcházejí — na ose mají jiný tvar značky'
            : 'zdroj žádný záznam neoznačuje za nejistý',
        stav:
          nejistych > 0
            ? { uroven: 'pozor', text: 'nesmí se číst jako doložený fakt' }
            : { uroven: 'dobre', text: 'všechny záznamy zdroj označuje za doložené' },
      },
      {
        popisek: 'Uvedených zdrojů',
        hodnota: cislo(zdroje.size),
        doplnek: 'ke každému období i události',
      },
    ]
  : [];

function udalostiObdobi(id: string) {
  return udalosti.filter((u) => u.obdobi === id);
}
const bezObdobi = udalosti.filter((u) => !u.obdobi || !obdobi.some((o) => o.id === u.obdobi));

function odkazyZdroju(ids: string[]) {
  return ids.map((id) => zdroje.get(id) ?? { id, nazev: id, url: null, typ: null });
}
---

<Zaklad
  titulek="Dějiny města"
  aktivni="historie"
  nadpis="Dějiny města"
  uvod="Historie Mariánských Lázní po obdobích, s časovou osou a propojením na osobnosti. Přehled uvádí, co je v datech, a odlišuje doložené od nejistého — nedoplňuje ani letopočty, ani souvislosti."
>
  <StavDat
    stav={zPrehledu.stav === 'ok' ? zUdalosti.stav : zPrehledu.stav}
    zdroj="přehled dějin města a soupis událostí"
    co="Dějiny města po obdobích"
    prazdno={zPrehledu.stav === 'ok' && zUdalosti.stav === 'ok' && !maData}
    modul="historie města"
    poznamky={poznamkyStavu}
  />

  {
    maData && (
      <>
        {zPrehledu.data.uvod && <p>{zPrehledu.data.uvod}</p>}

        <Dlazdice polozky={dlazdice} />

        {naOse.length > 0 && (
          <CasovaOsa
            id="osa-historie"
            nadpis="Časová osa dějin města"
            udalosti={naOse}
            popis="Období jsou vodorovné pruhy, jednotlivé události značky. Osa je lineární v čase, takže staletí bez záznamu jsou vidět jako prázdná plocha — mezera v našich datech je taky informace."
            zdroje={['přehled dějin města', 'soupis historických událostí', 'jednotná časová osa města']}
            neuplnost="Osa neobsahuje dějiny města, ale záznamy, které o nich máme. Řídké období nemusí znamenat, že se nic nedělo."
          />
        )}

        {obdobi.length > 0 && <h2>Období</h2>}

        {obdobi.map((o) => {
          const vObdobi = udalostiObdobi(o.id);
          return (
            <section class="karta" id={`obdobi-${o.id}`}>
              <div class="obdobi-hlava">
                <h3 class="karta__nadpis">{o.nazev}</h3>
                <span class="obdobi-roky">
                  {o.od !== null || o.do !== null ? `${o.od ?? '?'} – ${o.do ?? 'trvá'}` : 'roky v datech nejsou'}
                  {o.presnostRozsahu === 'priblizna' && ' (přibližně)'}
                </span>
              </div>
              {o.text && <p>{o.text}</p>}

              {o.osobnosti.length > 0 && (
                <p class="graf-poznamka">
                  Osobnosti období:{' '}
                  {o.osobnosti.map((id, i) => (
                    <>
                      {i > 0 && ', '}
                      {lide.has(id) ? <a href={`/lide/${id}`}>{lide.get(id)?.jmeno ?? id}</a> : <span class="mono">{id}</span>}
                    </>
                  ))}
                </p>
              )}

              {vObdobi.length > 0 && (
                <div class="tabulka-obal">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Kdy</th>
                        <th scope="col">Událost</th>
                        <th scope="col">Jistota</th>
                        <th scope="col">Osobnosti</th>
                      </tr>
                    </thead>
                    <tbody>
                      {vObdobi.map((u) => (
                        <tr>
                          <td class="cislo">{popisDatumu(u)}</td>
                          <td>
                            {u.odkaz ? (
                              <a href={u.odkaz} rel={u.odkaz.startsWith('http') ? 'noreferrer noopener' : undefined}>
                                {u.nazev}
                              </a>
                            ) : (
                              u.nazev
                            )}
                            {u.popis && <div class="duvod__detail">{u.popis}</div>}
                          </td>
                          <td>
                            {popisekJistoty(u.jistota)}
                            {u.poznamka && <div class="duvod__detail">{u.poznamka}</div>}
                          </td>
                          <td>
                            {u.osoby.length === 0
                              ? '—'
                              : u.osoby.map((id, i) => (
                                  <>
                                    {i > 0 && ', '}
                                    {lide.has(id) ? <a href={`/lide/${id}`}>{lide.get(id)?.jmeno ?? id}</a> : id}
                                  </>
                                ))}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {vObdobi.length === 0 && (
                <p class="graf-poznamka">K tomuhle období nemáme v datech žádnou jednotlivou událost.</p>
              )}

              {o.zdrojeIds.length > 0 && (
                <p class="graf-poznamka">
                  Zdroje:{' '}
                  {odkazyZdroju(o.zdrojeIds).map((z, i) => (
                    <>
                      {i > 0 && ' · '}
                      {z.url ? <a href={z.url} rel="noreferrer noopener">{z.nazev}</a> : z.nazev}
                    </>
                  ))}
                </p>
              )}
            </section>
          );
        })}

        {bezObdobi.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Události mimo zařazená období</h2>
            <p class="karta__podnadpis">
              {cislo(bezObdobi.length)}{' '}
              {sklonuj(bezObdobi.length, 'událost nemá', 'události nemají', 'událostí nemá')} v datech
              přiřazené období, nebo odkazuje na období, které v přehledu není.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Kdy</th>
                    <th scope="col">Událost</th>
                    <th scope="col">Jistota</th>
                  </tr>
                </thead>
                <tbody>
                  {bezObdobi.map((u) => (
                    <tr>
                      <td class="cislo">{popisDatumu(u)}</td>
                      <td>{u.nazev}</td>
                      <td>{popisekJistoty(u.jistota)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {propojeneOsobnosti.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Osobnosti v dějinách města</h2>
            <p class="karta__podnadpis">
              Kdo se objevuje u zaznamenaných událostí a období. Odkaz vede jen tam, kde má osoba
              profil v našem přehledu lidí — u zbylých zůstává jen identifikátor ze zdroje.
            </p>
            <ul class="seznam-temat">
              {propojeneOsobnosti.map((o) => (
                <li class="seznam-temat__polozka">
                  {o.osoba ? <a href={`/lide/${o.id}`}>{o.osoba.jmeno}</a> : <span class="mono">{o.id}</span>}
                  <span class="seznam-temat__pocet">
                    {cislo(o.pocet)}× {sklonuj(o.pocet, 'zmínka', 'zmínky', 'zmínek')}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {zPrehledu.data.metodika.length > 0 && (
          <JakPocitame>
            <p>
              Popis metody pochází přímo ze zdroje dějin města — na webu tak stojí přesně to,
              podle čeho data vznikla.
            </p>
            <dl class="metodika">
              {zPrehledu.data.metodika.map((m) => (
                <>
                  <dt>{m.klic.replace(/_/g, ' ')}</dt>
                  <dd>{polidstiData(m.text)}</dd>
                </>
              ))}
            </dl>
          </JakPocitame>
        )}

        {zdroje.size > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Zdroje k dějinám města</h2>
            <ul>
              {[...zdroje.values()].map((z) => (
                <li>
                  {z.url ? <a href={z.url} rel="noreferrer noopener">{z.nazev}</a> : z.nazev}
                  {z.typ && <span class="stav-dat__zdroj"> ({z.typ})</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</Zaklad>
