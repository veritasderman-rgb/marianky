---
/**
 * Jak se ve městě volilo.
 *
 * Past volební mapy (web/DESIGN.md §3.6): barví se plocha, ale volí lidé.
 * Komponenta `MapaKarta` proto barvenou mapu bez doprovodných absolutních
 * počtů vůbec nevykreslí — pravidlo je v kódu, ne jen v dokumentaci.
 *
 * Druhá past je v samotných datech: u komunálních voleb se v okrscích počítají
 * hlasy pro KANDIDÁTY, ne pro voliče. Proto je „platných hlasů" mnohonásobně
 * víc než voličů a součty hlasů se nesmí srovnávat s účastí.
 */
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import Dlazdice from '../components/Dlazdice.astro';
import GrafKarta from '../components/GrafKarta.astro';
import MapaKarta from '../components/MapaKarta.astro';
import CasovaOsa from '../components/CasovaOsa.astro';
import type { Varianta } from '../components/GrafKarta.astro';
import type { Polozka } from '../components/Dlazdice.astro';
import { nactiLidi, spojStavy } from '../lib/data';
import {
  hlavniVolba,
  nactiGeometrieOkrsku,
  nactiPrehledVoleb,
  nactiVolby,
  nactiVyhraduOkrsku,
  nactiZastupitele,
  registrStran,
  vrstvaProRok,
  geometrieOkrsku,
  NAZVY_TYPU,
  type TypVoleb,
  type Volba,
  type VolebniCyklus,
} from '../lib/volby';
import { krokRampyLinearni, legendaRampyObecna, mapaSvg, type PrvekMapy, type VrstvaMapy } from '../lib/mapy';
import { cssKrokRampy } from '../lib/barvy';
import { grafVodorovny, type BodVodorovny } from '../lib/grafy';
import { grafRadaPoLetech, grafSpojnice, type SerieRady } from '../lib/grafy_rady';
import { nactiOsuMesta, slucUdalosti, udalost, type UdalostOsy } from '../lib/osa';
import { cislo, sklonuj } from '../lib/format';

const zVoleb = nactiVolby();
const zPrehledu = nactiPrehledVoleb();
const zGeometrie = nactiGeometrieOkrsku();
const zVyhrady = nactiVyhraduOkrsku();
const zZastupitelu = nactiZastupitele();
const zLidi = nactiLidi();
const zOsy = nactiOsuMesta();
const { poznamky: poznamkyStavu } = spojStavy(zVoleb, zPrehledu);

const cykly = zVoleb.data ?? [];
const konane = cykly.filter((c) => c.volby.length > 0);
const nekonane = cykly.filter((c) => c.volby.length === 0);
const maData = cykly.length > 0;

const vsechnaHlasovani = konane.flatMap((c) => c.volby);
const registr = registrStran(vsechnaHlasovani);
const znamiLide = new Map((zLidi.data ?? []).map((o) => [o.id, o.jmeno]));

/* ── Formátování ───────────────────────────────────────────────────────── */

function pct(v: number | null | undefined): string {
  return v === null || v === undefined ? 'v datech není' : `${(v * 100).toFixed(1).replace('.', ',')} %`;
}
function pocet(v: number | null | undefined): string {
  return v === null || v === undefined ? 'v datech není' : cislo(v);
}
function odkazNaOsobu(osoba_id: string | null): string | null {
  return osoba_id && znamiLide.has(osoba_id) ? `/lide/${osoba_id}` : null;
}
function popisCyklu(c: VolebniCyklus, v: Volba): string {
  return `${c.nazev} ${c.rok}${v.kolo !== null ? `, ${v.kolo}. kolo` : ''}`;
}

/* ── Výběr hlasování pro mapu ───────────────────────────────────────────
   Mapa se kreslí pro nejnovější komunální volby, protože ty jsou o městě.
   Geometrie okrsků se bere z vrstvy platné k roku voleb; když zdroj vrstvu
   pro ten rok nemá, mapa to napíše — hranice okrsků se mezi volbami mění. */

const komunalni = konane.filter((c) => c.typ === 'komunalni').sort((a, b) => b.rok - a.rok);
const proMapu = (() => {
  for (const c of komunalni) {
    const v = hlavniVolba(c);
    if (!v || v.okrsky.length === 0) continue;
    const vyber = vrstvaProRok(zGeometrie.data ?? [], c.rok);
    if (!vyber) continue;
    const g = geometrieOkrsku([vyber.vrstva.vrstva], v.okrsky.map((o) => o.cislo));
    if (g.podleCisla.size > 0) return { c, v, g, geo: vyber };
  }
  return null;
})();

/* ── Vrstva mapy: účast v okrscích ─────────────────────────────────────── */

function vrstvaUcasti(x: NonNullable<typeof proMapu>): VrstvaMapy {
  const { c, v, g, geo } = x;
  const hodnoty = v.okrsky.map((o) => o.ucast).filter((h): h is number => h !== null);
  const min = hodnoty.length ? Math.min(...hodnoty) : 0;
  const max = hodnoty.length ? Math.max(...hodnoty) : 1;

  const prvky: PrvekMapy[] = v.okrsky.map((o) => {
    const prvek = g.podleCisla.get(o.cislo);
    const bezDat = o.ucast === null;
    return {
      id: o.cislo,
      nazev: `Okrsek ${o.cislo}`,
      tvary: prvek?.tvary ?? [],
      barva: bezDat ? 'var(--surface-2)' : cssKrokRampy(krokRampyLinearni(o.ucast as number, min, max)),
      bezDat,
      tip: [
        { l: 'Zapsaných voličů', v: pocet(o.volicu) },
        { l: 'Vydaných obálek', v: pocet(o.obalky) },
        { l: 'Účast', v: pct(o.ucast) + (o.ucastDopocitana ? ' (dopočet)' : '') },
      ],
      popis: `Okrsek ${o.cislo}: účast ${pct(o.ucast)}, zapsaných voličů ${pocet(o.volicu)}`,
    };
  });

  return {
    klic: 'ucast',
    nazev: 'Účast v okrscích',
    popis: `Účast a počty voličů po okrscích — ${popisCyklu(c, v)}.`,
    druh: 'plocha',
    prvky,
    zapnuta: true,
    legenda: legendaRampyObecna(pct(min), pct(max), 'účast v datech není'),
    zdroj: geo.vrstva.vrstva.zdroj ?? 'neuveden',
    licence: zPrehledu.data.licence,
    tabulka: {
      hlavicka: [
        { nazev: 'Okrsek' },
        { nazev: 'Zapsaní voliči', cislo: true },
        { nazev: 'Vydané obálky', cislo: true },
        { nazev: 'Odevzdané obálky', cislo: true },
        { nazev: 'Účast', cislo: true },
        { nazev: 'Hranice okrsku' },
      ],
      radky: v.okrsky.map((o) => [
        o.cislo,
        pocet(o.volicu),
        pocet(o.obalky),
        pocet(o.odevzdane),
        pct(o.ucast) + (o.ucastDopocitana ? ' (dopočet z obálek)' : ''),
        g.podleCisla.has(o.cislo) ? `podle vrstvy platné k roku ${geo.vrstva.platiK}` : 'v datech není',
      ]),
    },
  };
}

/* ── Vrstva mapy: kdo měl v okrsku nejvíc hlasů ────────────────────────── */

function vrstvaViteze(x: NonNullable<typeof proMapu>): VrstvaMapy {
  const { c, v, g, geo } = x;
  const vitezove = new Map<string, string>();
  for (const o of v.okrsky) if (o.vitez) vitezove.set(o.vitez.klic, o.vitez.nazev);

  const prvky: PrvekMapy[] = v.okrsky.map((o) => {
    const prvek = g.podleCisla.get(o.cislo);
    return {
      id: o.cislo,
      nazev: `Okrsek ${o.cislo}`,
      tvary: prvek?.tvary ?? [],
      barva: o.vitez ? registr.barva(o.vitez.klic) : 'var(--surface-2)',
      bezDat: !o.vitez,
      tip: [
        { l: 'Nejvíc hlasů', v: o.vitez?.nazev ?? 'v datech není' },
        { l: 'Hlasů', v: pocet(o.vitez?.hlasy ?? null) },
        { l: 'Podíl v okrsku', v: pct(o.vitez?.podil ?? null) },
        { l: 'Zapsaných voličů', v: pocet(o.volicu) },
      ],
      popis: `Okrsek ${o.cislo}: nejvíc hlasů ${o.vitez?.nazev ?? 'v datech není'} (${pocet(o.vitez?.hlasy ?? null)})`,
    };
  });

  const legenda = [...vitezove.entries()]
    .map(([klic, nazev]) => ({ nazev, barva: registr.barva(klic), tvar: 'rect' as const }))
    .sort((a, b) => a.nazev.localeCompare(b.nazev, 'cs-CZ'));

  return {
    klic: 'vitez',
    nazev: 'Kdo měl v okrsku nejvíc hlasů',
    popis: `Kandidátka s nejvyšším počtem hlasů v okrsku — ${popisCyklu(c, v)}.`,
    druh: 'plocha',
    prvky,
    zapnuta: true,
    legenda,
    zdroj: geo.vrstva.vrstva.zdroj ?? 'neuveden',
    licence: zPrehledu.data.licence,
    tabulka: {
      hlavicka: [
        { nazev: 'Okrsek' },
        { nazev: 'Nejvíc hlasů' },
        { nazev: 'Hlasů', cislo: true },
        { nazev: 'Podíl v okrsku', cislo: true },
        { nazev: 'Zapsaní voliči', cislo: true },
      ],
      radky: v.okrsky.map((o) => [
        o.cislo,
        o.vitez?.nazev ?? 'v datech není',
        pocet(o.vitez?.hlasy ?? null),
        pct(o.vitez?.podil ?? null),
        pocet(o.volicu),
      ]),
    },
  };
}

const vrstvaU = proMapu ? vrstvaUcasti(proMapu) : null;
const vrstvaV = proMapu ? vrstvaViteze(proMapu) : null;
const mapaU = vrstvaU ? mapaSvg([vrstvaU], { popis: 'Mapa volební účasti po okrscích' }) : null;
const mapaV = vrstvaV ? mapaSvg([vrstvaV], { popis: 'Mapa nejsilnější kandidátky po okrscích' }) : null;

/* ── Doprovodné grafy s absolutními počty ──────────────────────────────
   Tohle je to, co brání volební mapě lhát: velká plocha nemusí znamenat
   mnoho hlasů, a tady je vidět kolik. */

function doprovodVolicu(v: Volba) {
  const sPocty = v.okrsky.filter((o) => o.volicu !== null);
  const graf = grafVodorovny(
    sPocty.map((o) => ({
      nazev: `Okrsek ${o.cislo}`,
      hodnota: o.volicu as number,
      doplnky: [
        { l: 'Vydané obálky', v: pocet(o.obalky) },
        { l: 'Účast', v: pct(o.ucast) },
      ],
    })) as BodVodorovny[],
    'Zapsaní voliči po okrscích',
  );
  graf.poznamky.push(
    'Plocha okrsku na mapě neodpovídá počtu voličů. Rozlehlý okrsek na okraji města může mít méně voličů než jeden panelový blok — proto tenhle graf patří k mapě, ne za ni.',
  );
  if (sPocty.length < v.okrsky.length) {
    graf.poznamky.push(
      `U ${cislo(v.okrsky.length - sPocty.length)} okrsků není počet zapsaných voličů v datech; v grafu chybí, v tabulce jsou.`,
    );
  }
  return graf;
}

function doprovodHlasuViteze(v: Volba) {
  const sHlasy = v.okrsky.filter((o) => o.vitez !== null && o.vitez.hlasy !== null);
  const graf = grafVodorovny(
    sHlasy.map((o) => ({
      nazev: `Okrsek ${o.cislo}`,
      hodnota: o.vitez?.hlasy as number,
      doplnky: [
        { l: 'Nejvíc hlasů', v: o.vitez?.nazev ?? '—' },
        { l: 'Podíl v okrsku', v: pct(o.vitez?.podil ?? null) },
        { l: 'Zapsaní voliči', v: pocet(o.volicu) },
      ],
    })) as BodVodorovny[],
    'Hlasy nejsilnější kandidátky po okrscích',
  );
  graf.poznamky.push(
    'Stejná barva na mapě může znamenat čtyřicet hlasů i čtyři sta. Absolutní počty jsou tady — bez nich mapa tvrdí víc, než v datech stojí.',
  );
  return graf;
}

/* ── Účast v čase ──────────────────────────────────────────────────────── */

function volbyTypu(typ: TypVoleb): { c: VolebniCyklus; v: Volba }[] {
  return konane
    .filter((c) => c.typ === typ)
    .map((c) => ({ c, v: hlavniVolba(c) }))
    .filter((x): x is { c: VolebniCyklus; v: Volba } => x.v !== null)
    .sort((a, b) => a.c.rok - b.c.rok);
}

const variantyUcasti: Varianta[] = NAZVY_TYPU.map(({ klic, kratky, nazev }): Varianta | null => {
  const vyber = volbyTypu(klic);
  if (vyber.length === 0) return null;
  const graf = grafRadaPoLetech(
    vyber.map(({ c, v }) => ({
      rok: c.rok,
      hodnota: v.celkem.ucast === null ? null : v.celkem.ucast * 100,
      poznamka: `zapsaných voličů ${pocet(v.celkem.volicu)}, vydaných obálek ${pocet(v.celkem.obalky)}`,
    })),
    `Volební účast — ${nazev}`,
    'účast',
    (x) => `${x.toFixed(1).replace('.', ',')} %`,
  );
  graf.tabulka = {
    hlavicka: [
      { nazev: 'Rok' },
      { nazev: 'Účast', cislo: true },
      { nazev: 'Zapsaní voliči', cislo: true },
      { nazev: 'Vydané obálky', cislo: true },
    ],
    radky: vyber.map(({ c, v }) => [
      String(c.rok),
      pct(v.celkem.ucast),
      pocet(v.celkem.volicu),
      pocet(v.celkem.obalky),
    ]),
  };
  graf.poznamky.push(
    'Osa má jeden sloupec na jedny volby, ne na každý rok. Rok bez voleb by jako nulový sloupec tvrdil nulovou účast — a to je něco jiného než „nevolilo se". Skutečné rozestupy mezi volbami ukazuje časová osa níže.',
  );
  if (klic === 'prezidentske' || klic === 'senatni') {
    graf.poznamky.push('U dvoukolových voleb je zobrazené první kolo.');
  }
  return { klic, popisek: kratky, graf };
}).filter((v): v is Varianta => v !== null);

/* ── Podpora stran v čase ──────────────────────────────────────────────── */

const variantyStran: Varianta[] = NAZVY_TYPU.map(({ klic, kratky, nazev }): Varianta | null => {
  const vyber = volbyTypu(klic);
  if (vyber.length < 2) return null;

  const soucty = new Map<string, { nazev: string; hlasy: number }>();
  for (const { v } of vyber) {
    for (const s of v.strany) {
      const stav = soucty.get(s.klic) ?? { nazev: s.nazev, hlasy: 0 };
      stav.hlasy += s.hlasy ?? 0;
      soucty.set(s.klic, stav);
    }
  }
  const nej = [...soucty.entries()].sort((a, b) => b[1].hlasy - a[1].hlasy).slice(0, 6);
  if (nej.length === 0) return null;

  const roky = vyber.map(({ c }) => c.rok);
  const serie: SerieRady[] = nej.map(([klicStrany, info]) => ({
    klic: klicStrany,
    nazev: info.nazev,
    hodnoty: vyber.map(({ v }) => {
      const s = v.strany.find((x) => x.klic === klicStrany);
      return s === undefined || s.podil === null ? null : s.podil * 100;
    }),
  }));

  const graf = grafSpojnice(roky, serie, `Podpora stran — ${nazev}`, '% platných hlasů', (x) =>
    `${x.toFixed(1).replace('.', ',')} %`,
  );
  graf.poznamky.push(
    'Přerušená čára znamená, že kandidátka v těch volbách nekandidovala nebo ji zdroj neuvádí — není to nula procent.',
  );
  graf.poznamky.push(
    'Zobrazeno šest kandidátek s nejvíce hlasy za celé období. Body jsou rozmístěné po volbách, ne po letech. Názvy kandidátek se mezi volbami mění, i když za nimi stojí stejné strany — přehled je nespojuje.',
  );
  return { klic, popisek: kratky, graf };
}).filter((v): v is Varianta => v !== null);

/* ── Účast po okrscích, volby po volbách ───────────────────────────────── */

const variantyOkrsku: Varianta[] = konane
  .map((c) => ({ c, v: hlavniVolba(c) }))
  .filter((x): x is { c: VolebniCyklus; v: Volba } => x.v !== null && x.v.okrsky.some((o) => o.ucast !== null))
  .slice(0, 10)
  .map(({ c, v }) => {
    const graf = grafVodorovny(
      v.okrsky
        .filter((o) => o.ucast !== null)
        .map((o) => ({
          nazev: `Okrsek ${o.cislo}`,
          hodnota: (o.ucast as number) * 100,
          doplnky: [
            { l: 'Zapsaných voličů', v: pocet(o.volicu) },
            { l: 'Vydaných obálek', v: pocet(o.obalky) },
          ],
        })) as BodVodorovny[],
      `Účast po okrscích — ${popisCyklu(c, v)}`,
      (x) => `${x.toFixed(1).replace('.', ',')} %`,
    );
    graf.tabulka = {
      hlavicka: [
        { nazev: 'Okrsek' },
        { nazev: 'Účast', cislo: true },
        { nazev: 'Zapsaní voliči', cislo: true },
        { nazev: 'Vydané obálky', cislo: true },
      ],
      radky: v.okrsky.map((o) => [o.cislo, pct(o.ucast), pocet(o.volicu), pocet(o.obalky)]),
    };
    graf.poznamky.push('Procenta bez počtu voličů klamou — absolutní počty jsou v tooltipu i v tabulce.');
    return { klic: v.id, popisek: `${c.rok} ${NAZVY_TYPU.find((t) => t.klic === c.typ)?.kratky ?? ''}`.trim(), graf };
  });

/* ── Časová osa voleb ──────────────────────────────────────────────────
   Skládá se přímo z volebních cyklů, aby fungovala i bez jednotné časové osy.
   Když `casova_osa/mesto.json` existuje, jeho záznamy o volbách se přidají —
   nesou navíc pořadí stran a odkaz do zdroje. */

const zCyklu: UdalostOsy[] = konane.flatMap((c) =>
  c.volby.map((v) =>
    udalost({
      id: `volby-${v.id}`,
      datum: v.datum ?? String(c.rok),
      presnost: v.datum ? 'den' : 'rok',
      druh: 'volby',
      nadpis: popisCyklu(c, v),
      odkaz: `#volba-${v.id}`,
      jistota: 'fakt',
      zdroj: zPrehledu.data.zdroj ?? c.zdroj ?? c.cesta,
      detail: `účast ${pct(v.celkem.ucast)}, zapsaných voličů ${pocet(v.celkem.volicu)}${
        v.strany[0] ? `, nejvíc hlasů ${v.strany[0].nazev}` : ''
      }`,
    }),
  ),
);

const udalostiVoleb = slucUdalosti(
  (zOsy.data.udalosti ?? []).filter((u) => u.druh === 'volby'),
  zCyklu,
);

/* ── Zvolení zastupitelé ───────────────────────────────────────────────── */

const zastupiteleDlePcyklu = new Map<string, typeof zZastupitelu.data>();
for (const z of zZastupitelu.data ?? []) {
  const seznam = zastupiteleDlePcyklu.get(z.cyklus) ?? [];
  seznam.push(z);
  zastupiteleDlePcyklu.set(z.cyklus, seznam);
}

/* ── Dlaždice ──────────────────────────────────────────────────────────── */

const posledniKomunalni = komunalni[0] ?? null;
const posledniVolba = posledniKomunalni ? hlavniVolba(posledniKomunalni) : null;

const dlazdice: Polozka[] = maData
  ? [
      {
        popisek: 'Volebních cyklů v datech',
        hodnota: cislo(cykly.length),
        doplnek: `${cislo(konane.length)} se ve městě konalo${nekonane.length > 0 ? `, ${cislo(nekonane.length)} ne` : ''}`,
      },
      {
        popisek: 'Poslední komunální volby',
        hodnota: posledniKomunalni ? String(posledniKomunalni.rok) : '—',
        doplnek: posledniVolba?.datum ?? undefined,
      },
      {
        popisek: 'Účast v posledních komunálních',
        hodnota: posledniVolba ? pct(posledniVolba.celkem.ucast) : '—',
        doplnek: posledniVolba
          ? `${pocet(posledniVolba.celkem.obalky)} obálek ze ${pocet(posledniVolba.celkem.volicu)} zapsaných voličů`
          : undefined,
      },
      {
        popisek: 'Volebních okrsků',
        hodnota: posledniVolba ? cislo(posledniVolba.okrsky.length) : '—',
        doplnek: proMapu
          ? `geometrie spárována u ${cislo(proMapu.g.podleCisla.size)}`
          : 'geometrii okrsků se nepodařilo spárovat',
      },
    ]
  : [];

const roky = cykly.map((c) => c.rok).filter((r) => r > 0);
const rozsahLet = roky.length > 0 ? `${Math.min(...roky)}–${Math.max(...roky)}` : '';

/* Popisy map jsou tady, ne v atributu — obsahují uvozovky. */
const popisMapyUcasti =
  'Sytost plochy roste s volební účastí. Okrsek, u kterého účast v datech není, má jinou výplň i přerušovaný obrys — „nezjištěno" se nesmí splést s „málo".';
const popisMapyViteze =
  'Barva patří kandidátce, ne pořadí ve výsledku — stejná kandidátka má stejnou barvu ve všech pohledech. „Nejvíc hlasů" není totéž co většina: při deseti kandidátkách stačí k prvnímu místu i pětina hlasů.';
---

<Zaklad
  titulek="Volby"
  aktivni="volby"
  nadpis="Jak se ve městě volilo"
  uvod="Výsledky po volebních okrscích, účast a proměna voličské podpory v čase. Všechno se počítá při buildu z otevřených dat ČSÚ; mapa je SVG, ne dlaždice z cizího serveru."
>
  <StavDat
    stav={zVoleb.stav}
    zdroj={zVoleb.zdroj}
    co="Výsledky voleb po okrscích"
    prazdno={zVoleb.stav === 'ok' && cykly.length === 0}
    modul="otevřená data — volby"
    poznamky={poznamkyStavu}
  />

  {
    maData && (
      <>
        <Dlazdice polozky={dlazdice} />

        <p class="graf-poznamka">
          V datech je {cislo(cykly.length)}{' '}
          {sklonuj(cykly.length, 'volební cyklus', 'volební cykly', 'volebních cyklů')}
          {rozsahLet && ` za období ${rozsahLet}`}.
          {nekonane.length > 0 && (
            <>
              {' '}U {cislo(nekonane.length)} z nich se ve městě nevolilo (senátní volby v letech, kdy nebyl
              zdejší obvod na řadě) — v datech mají stav „neúčastnila se" a v grafech nejsou.
            </>
          )}
        </p>

        {proMapu && vrstvaU && mapaU && (
          <>
            <h2>Mapa okrsků — {popisCyklu(proMapu.c, proMapu.v)}</h2>
            <p class="uvod">
              Mapa barví plochu, ale volí lidé. Vedle každé mapy proto stojí graf s absolutními
              počty: bez něj by rozlehlý okrsek s hrstkou voličů vypadal důležitěji než hustě
              obydlený panelák.
            </p>

            <MapaKarta
              id="mapa-ucast"
              nadpis="Účast po okrscích"
              popis={popisMapyUcasti}
              mapa={mapaU}
              vrstvy={[vrstvaU]}
              barviPlochu
              doprovod={{
                nadpis: 'Kolik voličů okrsek má',
                popis: 'Zapsaní voliči po okrscích — absolutní počty, ne procenta.',
                graf: doprovodVolicu(proMapu.v),
              }}
              zdroje={[
                {
                  nazev: `Hranice okrsků platné k roku ${proMapu.geo.vrstva.platiK}: ${proMapu.geo.vrstva.vrstva.zdroj ?? 'zdroj neuveden'}`,
                  licence: proMapu.geo.vrstva.vrstva.licence ?? zPrehledu.data.licence,
                },
                {
                  nazev: `Výsledky voleb: ${zPrehledu.data.zdroj ?? proMapu.c.zdroj ?? proMapu.c.cesta}`,
                  licence: zPrehledu.data.licence,
                  url: proMapu.c.zdroj,
                },
              ]}
              poznamky={[
                proMapu.geo.sedi
                  ? `Použitá vrstva hranic platí k roku ${proMapu.geo.vrstva.platiK}, tedy k roku těchto voleb.`
                  : `POZOR: zdroj nemá hranice okrsků k roku ${proMapu.c.rok}. Použitá vrstva platí k roku ${proMapu.geo.vrstva.platiK} a území okrsků mohlo být v době voleb jiné.`,
                ...(proMapu.geo.vrstva.poznamka ? [proMapu.geo.vrstva.poznamka] : []),
                ...(proMapu.g.nesparovano.length > 0
                  ? [
                      `Pro okrsky ${proMapu.g.nesparovano.join(', ')} se geometrie nenašla — v mapě chybí, v tabulce a v grafech jsou.`,
                    ]
                  : ['Geometrii se podařilo spárovat u všech okrsků v datech.']),
              ]}
            />

            {vrstvaV && mapaV && (
              <MapaKarta
                id="mapa-vitez"
                nadpis="Kdo měl v okrsku nejvíc hlasů"
                popis={popisMapyViteze}
                mapa={mapaV}
                vrstvy={[vrstvaV]}
                barviPlochu
                doprovod={{
                  nadpis: 'Kolik hlasů to bylo',
                  popis: 'Hlasy nejsilnější kandidátky v každém okrsku — absolutní počty.',
                  graf: doprovodHlasuViteze(proMapu.v),
                }}
                zdroje={[
                  {
                    nazev: `Hranice okrsků platné k roku ${proMapu.geo.vrstva.platiK}: ${proMapu.geo.vrstva.vrstva.zdroj ?? 'zdroj neuveden'}`,
                    licence: proMapu.geo.vrstva.vrstva.licence ?? zPrehledu.data.licence,
                  },
                  {
                    nazev: `Výsledky voleb: ${zPrehledu.data.zdroj ?? proMapu.c.cesta}`,
                    licence: zPrehledu.data.licence,
                  },
                ]}
                poznamky={[
                  'V komunálních volbách se v okrscích počítají hlasy pro jednotlivé kandidáty, ne pro voliče. Každý volič má tolik hlasů, kolik se volí zastupitelů — proto je „platných hlasů" mnohonásobně víc než voličů a s účastí se ta čísla srovnávat nedají.',
                ]}
              />
            )}
          </>
        )}

        {!proMapu && (
          <div class="stav-dat stav-dat--chybi">
            <strong class="stav-dat__nadpis">Mapa okrsků zatím není</strong>
            <span>
              Výsledky po okrscích máme, ale geometrii okrsků se nepodařilo najít nebo spárovat
              podle čísla okrsku.{' '}
              <span class="stav-dat__zdroj">Očekávaný zdroj: opendata/volby/okrsky_geo/</span>.
              Grafy a tabulky níže fungují i bez mapy.
            </span>
          </div>
        )}

        {variantyUcasti.length > 0 && (
          <GrafKarta
            id="ucast-cas"
            nadpis="Účast v čase"
            popis="Kolik lidí přišlo volit. Přepínač odděluje typy voleb — účast v komunálních a sněmovních volbách se nesrovnává, jsou to jiné volby s jinou logikou."
            varianty={variantyUcasti}
          />
        )}

        {variantyStran.length > 0 && (
          <GrafKarta
            id="strany-cas"
            nadpis="Jak se měnila voličská podpora"
            popis="Podíl na platných hlasech po jednotlivých volbách. Podíl, ne počet — počet hlasů kolísá s účastí a sám o sobě o podpoře neříká tolik. Absolutní počty jsou v tabulkách u jednotlivých voleb."
            varianty={variantyStran}
          />
        )}

        {udalostiVoleb.length > 0 && (
          <CasovaOsa
            id="osa-voleb"
            nadpis="Časová osa voleb"
            udalosti={udalostiVoleb}
            zdroje={[
              `výsledky voleb ČSÚ — ${zPrehledu.data.zdroj ?? 'opendata/volby/'}`,
              ...(zOsy.data.udalosti.length > 0 ? ['jednotná časová osa (casova_osa/mesto.json)'] : []),
            ]}
            popis="Volby tak, jak po sobě šly. Na rozdíl od sloupcových grafů výše je tahle osa lineární v čase — je z ní vidět, že mezi volbami leží roky, ve kterých se nevolilo."
            neuplnost="Osa obsahuje jen volby, které jsou v otevřených datech ČSÚ."
          />
        )}

        {variantyOkrsku.length > 0 && (
          <GrafKarta
            id="ucast-okrsky"
            nadpis="Účast po okrscích"
            popis="Rozdíly mezi okrsky uvnitř jednoho města. U každého okrsku je v tooltipu i v tabulce počet zapsaných voličů — bez něj by procenta klamala."
            varianty={variantyOkrsku}
          />
        )}

        {zVyhrady.data.poznamka && (
          <section class="karta">
            <h2 class="karta__nadpis">Co o okrscích víme a co ne</h2>
            <p>{zVyhrady.data.poznamka}</p>
            <dl class="metodika">
              {zVyhrady.data.coVime && (
                <>
                  <dt>Víme</dt>
                  <dd>{zVyhrady.data.coVime}</dd>
                </>
              )}
              {zVyhrady.data.coNevime && (
                <>
                  <dt>Nevíme</dt>
                  <dd>{zVyhrady.data.coNevime}</dd>
                </>
              )}
            </dl>
          </section>
        )}

        <h2>Výsledky jednotlivých voleb</h2>

        {konane.map((c) =>
          c.volby.map((v) => (
            <section class="karta" id={`volba-${v.id}`}>
              <h3 class="karta__nadpis">{popisCyklu(c, v)}</h3>
              <p class="karta__podnadpis">
                {v.datum ? `Konání: ${v.datum}. ` : 'Datum konání zdroj u těchto voleb neuvádí. '}
                Zapsaných voličů {pocet(v.celkem.volicu)}, vydaných obálek {pocet(v.celkem.obalky)},
                účast {pct(v.celkem.ucast)}. Okrsků: {cislo(v.okrsky.length)}.
                {v.mandatu !== null && ` Rozdělovalo se ${cislo(v.mandatu)} mandátů.`}
                {v.kandidatu !== null && ` Kandidátů: ${cislo(v.kandidatu)}.`}
              </p>

              {v.strany.length > 0 && (
                <div class="tabulka-obal">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Kandidátka</th>
                        <th scope="col" class="cislo">Hlasů</th>
                        <th scope="col" class="cislo">Podíl</th>
                        <th scope="col" class="cislo">Mandátů</th>
                      </tr>
                    </thead>
                    <tbody>
                      {v.strany.map((s) => (
                        <tr>
                          <td>
                            {s.nazev}
                            {s.zkratka && s.zkratka !== s.nazev && (
                              <span class="stav-dat__zdroj"> ({s.zkratka})</span>
                            )}
                          </td>
                          <td class="cislo">{pocet(s.hlasy)}</td>
                          <td class="cislo">{pct(s.podil)}</td>
                          <td class="cislo">{s.mandaty === null ? 'nerozdělují se' : cislo(s.mandaty)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {v.zvoleni.length > 0 && (
                <>
                  <h4>Zvolení zastupitelé</h4>
                  <div class="tabulka-obal">
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">Jméno</th>
                          <th scope="col">Kandidátka</th>
                          <th scope="col" class="cislo">Hlasů</th>
                          <th scope="col" class="cislo">Podíl</th>
                          <th scope="col">Povolání podle kandidátky</th>
                        </tr>
                      </thead>
                      <tbody>
                        {v.zvoleni.map((z) => {
                          const odkaz = odkazNaOsobu(z.osoba_id);
                          return (
                            <tr>
                              <td>{odkaz ? <a href={odkaz}>{z.jmeno}</a> : z.jmeno}</td>
                              <td>{z.strana ?? 'v datech není'}</td>
                              <td class="cislo">{pocet(z.hlasy)}</td>
                              <td class="cislo">{pct(z.hlasyProc)}</td>
                              <td>{z.povolani ?? '—'}</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                  <p class="graf-poznamka">
                    Povolání je údaj z kandidátní listiny v době voleb, ne dnešní stav. Odkaz na
                    profil vede jen tam, kde zvoleného zastupitele máme v přehledu lidí.
                  </p>
                </>
              )}

              {v.strany.length === 0 && (
                <p>U těchhle voleb má zdroj jen souhrnná čísla — rozpis podle kandidátek v datech není.</p>
              )}
            </section>
          )),
        )}

        {nekonane.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Volby, které se ve městě nekonaly</h2>
            <p class="karta__podnadpis">
              Zdroj je vede se stavem „neúčastnila se". Není to chybějící údaj — je to informace,
              že se ve městě v ten rok nevolilo.
            </p>
            <ul>
              {nekonane.map((c) => (
                <li>
                  {c.nazev} {c.rok} <span class="stav-dat__zdroj">({c.stav ?? 'bez stavu'})</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="graf-poznamka">
          Volební okrsky se v čase mění hranicemi i čísly. Srovnání okrsku napříč volebními roky
          proto není srovnání téhož území. Tenhle přehled okrsky mezi roky nepřepočítává a ani se
          o to nepokouší — čísla i mapa vždy platí pro uvedené volby.
        </p>
        {zPrehledu.data.licence && (
          <p class="graf-poznamka">
            Zdroj dat: {zPrehledu.data.zdroj ?? 'volby.gov.cz'} · podmínky užití:{' '}
            <a href={zPrehledu.data.licence} rel="noreferrer noopener">{zPrehledu.data.licence}</a>
          </p>
        )}
      </>
    )
  }
</Zaklad>
