---
/**
 * Přehled vazeb mezi samosprávou a firmami.
 *
 * Smyslem je ukázat celý obrázek, ne jen to, co vypadá podezřele:
 *   – u každé firmy je napsané, jestli s městem obchoduje, nebo ne,
 *   – městská organizace se pozná od cizí firmy (ředitel muzea „obchodující
 *     s městem" je něco jiného než stavební firma),
 *   – „nezjištěno" se nikde netváří jako „nic tam není".
 *
 * Stránka nic nehodnotí. Vysvětlení metody se přebírá ze zdrojového souboru,
 * aby na webu stálo přesně to, podle čeho data vznikla.
 */
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import Dlazdice from '../components/Dlazdice.astro';
import JakPocitame from '../components/JakPocitame.astro';
import type { Polozka } from '../components/Dlazdice.astro';
import { nactiLidi, nactiProtistrany } from '../lib/data';
import {
  dodavateleZOsob,
  nactiDodavatelePolitiky,
  nactiOsobyFirmy,
  popisOvereni,
  popisVztahu,
  vsechenSponzoring,
  type DodavatelSVazbou,
  type FirmaOsoby,
  type OsobaFirmy,
} from '../lib/vazby';
import { cislo, kc, kcZkraceno, orderCs, polidstiData, sklonuj } from '../lib/format';

const zOsob = nactiOsobyFirmy();
const zDodavatelu = nactiDodavatelePolitiky();
const zLidi = nactiLidi();
const zProtistran = nactiProtistrany();

const propojeni = zOsob.data;
const zname = new Set((zProtistran.data.protistrany ?? []).map((p) => p.klic));
const jmenaOsob = new Map((zLidi.data ?? []).map((o) => [o.id, o.jmeno]));
for (const o of propojeni.osoby) {
  if (o.jmeno && !jmenaOsob.has(o.osoba_id)) jmenaOsob.set(o.osoba_id, o.jmeno);
}
const jmeno = (o: OsobaFirmy) => o.jmeno ?? jmenaOsob.get(o.osoba_id) ?? o.osoba_id;

const osoby = [...propojeni.osoby].sort((a, b) => orderCs(jmeno(a), jmeno(b)));
const sFirmami = osoby.filter((o) => o.firmy.length > 0);
const bezZjisteni = osoby.filter((o) => !o.firmyZjisteny);

/* ── Řádky „kdo je kde uvedený" ───────────────────────────────────────── */

interface Radek {
  osoba: OsobaFirmy;
  f: FirmaOsoby;
}
const radky: Radek[] = [];
for (const o of sFirmami) for (const f of o.firmy) radky.push({ osoba: o, f });

/* Firmy se počítají podle IČO, ať se jedna firma s více zastupiteli
   nezapočítá vícekrát. Bez IČO se rozlišuje podle názvu. */
const klicFirmy = (f: FirmaOsoby) => f.ico ?? `n-${f.nazev.toLowerCase()}`;
const firmy = new Map<string, FirmaOsoby>();
for (const r of radky) if (!firmy.has(klicFirmy(r.f))) firmy.set(klicFirmy(r.f), r.f);
const vsechnyFirmy = [...firmy.values()];

const mestskych = vsechnyFirmy.filter((f) => f.vztah === 'mestsky-subjekt').length;
const cizichObchodujicich = vsechnyFirmy.filter((f) => f.vztah === 'obchoduje-s-mestem').length;
const bezVazby = vsechnyFirmy.filter((f) => f.vztah === 'bez-vazby-na-mesto').length;

const objemCelkem = vsechnyFirmy.reduce((s, f) => s + (f.od_mesta_czk ?? 0), 0);
const objemCizich = vsechnyFirmy
  .filter((f) => f.vztah === 'obchoduje-s-mestem')
  .reduce((s, f) => s + (f.od_mesta_czk ?? 0), 0);

const maData = radky.length > 0;

const dlazdice: Polozka[] = maData
  ? [
      {
        popisek: 'Osob s dohledanou firmou',
        hodnota: cislo(sFirmami.length),
        doplnek: `z ${cislo(osoby.length)} sledovaných osob · u ${cislo(bezZjisteni.length)} se identita nedohledala`,
      },
      {
        popisek: 'Firem celkem',
        hodnota: cislo(vsechnyFirmy.length),
        doplnek: `${cislo(bezVazby)} z nich s městem neobchoduje`,
      },
      {
        popisek: 'Z toho městských organizací',
        hodnota: cislo(mestskych),
        doplnek: `${cislo(cizichObchodujicich)} je firma mimo město, která s městem obchoduje`,
      },
      {
        popisek: 'Od města firmám mimo město',
        hodnota: kcZkraceno(objemCizich, true),
        doplnek: `celkem včetně městských organizací ${kcZkraceno(objemCelkem, true)}`,
      },
    ]
  : [];

/* ── Dodavatelé s vazbou ──────────────────────────────────────────────── */

const zeSouboru = zDodavatelu.data.dodavatele.length > 0;
const dodavatele: DodavatelSVazbou[] = zeSouboru
  ? zDodavatelu.data.dodavatele
  : dodavateleZOsob(propojeni);
const dodavateleSerazeni = [...dodavatele].sort((a, b) => (b.od_mesta_czk ?? 0) - (a.od_mesta_czk ?? 0));

/* ── Sponzoring ───────────────────────────────────────────────────────── */

const sponzoring = vsechenSponzoring(propojeni).sort(
  (a, b) => (b.rok ?? 0) - (a.rok ?? 0) || (b.castka_czk ?? 0) - (a.castka_czk ?? 0),
);
const sponzoringProverovan = propojeni.osoby.filter((o) => o.sponzoring !== null).length;

function castkaFirmy(f: FirmaOsoby): string {
  if (f.vztah === 'bez-vazby-na-mesto') return '—';
  if (f.od_mesta_czk === null) return 'v datech není';
  return kc(f.od_mesta_czk);
}
---

<Zaklad
  titulek="Propojení"
  aktivni="propojeni"
  nadpis="Propojení samosprávy a firem"
  uvod="Kdo ze zastupitelů, radních a statutárů městských firem je uvedený v jakých firmách a které z těch firem dostávají od města peníze. Přehled uvádí i firmy bez jakéhokoliv vztahu k městu — bez nich by vznikal dojem, že každé angažmá znamená peníze z rozpočtu. Stránka nic nehodnotí, jen ukazuje, co je ve zdrojích."
>
  <StavDat
    stav={zOsob.stav}
    zdroj={zOsob.zdroj}
    co="Propojení osob a firem"
    prazdno={zOsob.stav === 'ok' && radky.length === 0}
    modul="propojení dat"
  />

  {
    maData && (
      <>
        <Dlazdice polozky={dlazdice} />

        <p class="graf-poznamka">
          Zápis ve firmě je veřejný údaj z rejstříku. Sám o sobě neznamená nic víc, než že je osoba
          ve firmě zapsaná. Velká část těch firem jsou přímo organizace města — ředitel příspěvkové
          organizace, která dostává příspěvek od zřizovatele, je běžný stav, ne nález.
        </p>

        <section class="karta">
          <h2 class="karta__nadpis">Kde je kdo uvedený</h2>
          <p class="karta__podnadpis">
            {cislo(radky.length)} {sklonuj(radky.length, 'záznam', 'záznamy', 'záznamů')} o angažmá,
            řazeno podle jména. Sloupec „Vztah firmy k městu" rozlišuje městskou organizaci, cizí
            firmu obchodující s městem a firmu bez vztahu k městu.
          </p>
          <div class="tabulka-obal">
            <table>
              <thead>
                <tr>
                  <th scope="col">Osoba</th>
                  <th scope="col">Uskupení</th>
                  <th scope="col">Firma</th>
                  <th scope="col">Vztah firmy k městu</th>
                  <th scope="col">Období</th>
                  <th scope="col" class="cislo">Od města</th>
                  <th scope="col" class="cislo">Smluv</th>
                </tr>
              </thead>
              <tbody>
                {radky.map(({ osoba, f }) => (
                  <tr>
                    <td>
                      <a href={`/lide/${osoba.osoba_id}`}>{jmeno(osoba)}</a>
                      {osoba.overeni.stav && osoba.overeni.stav !== 'potvrzeno' && (
                        <>
                          <br />
                          <span class="stav-dat__zdroj">{popisOvereni(osoba.overeni.stav)}</span>
                        </>
                      )}
                    </td>
                    <td>{osoba.strana ?? (osoba.role.length > 0 ? osoba.role.join(', ') : '—')}</td>
                    <td>
                      {f.ico && zname.has(f.ico) ? <a href={`/penize/${f.ico}`}>{f.nazev}</a> : f.nazev}
                      {f.ico && (
                        <>
                          <br />
                          <span class="mono">{f.ico}</span>
                        </>
                      )}
                    </td>
                    <td>{popisVztahu(f.vztah)}</td>
                    <td class="cislo">
                      {f.prvni_rok !== null || f.posledni_rok !== null
                        ? `${f.prvni_rok ?? '?'}–${f.posledni_rok ?? '?'}`
                        : '—'}
                    </td>
                    <td class="cislo">{castkaFirmy(f)}</td>
                    <td class="cislo">{f.smluv === null ? '—' : cislo(f.smluv)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="graf-poznamka">
            Období je rozsah let, ve kterých firma s městem uzavírala smlouvy — ne doba, po kterou
            v ní osoba působí. Tu zdroj neuvádí.
          </p>
        </section>

        {bezZjisteni.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Osoby, u kterých se firmy nedohledaly</h2>
            <p class="karta__podnadpis">
              U těchhle lidí zdroj nevede seznam firem. Neznamená to, že žádné nemají — znamená to,
              že se jejich identita v rejstříku nedala spolehlivě určit. Kdyby tu nebyli uvedení,
              vypadal by přehled úplněji, než je.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Osoba</th>
                    <th scope="col">Role</th>
                    <th scope="col">Proč se firmy neuvádějí</th>
                  </tr>
                </thead>
                <tbody>
                  {bezZjisteni.map((o) => (
                    <tr>
                      <td><a href={`/lide/${o.osoba_id}`}>{jmeno(o)}</a></td>
                      <td>{o.role.length > 0 ? o.role.join(', ') : '—'}</td>
                      <td>
                        {popisOvereni(o.overeni.stav)}
                        {o.overeni.kandidatu !== null && o.overeni.kandidatu > 1 && (
                          <> · v rejstříku je {cislo(o.overeni.kandidatu)} osob téhož jména</>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </>
    )
  }

  <section class="karta">
    <h2 class="karta__nadpis">Firmy s vazbou na politiky, které dostávají od města peníze</h2>
    <p class="karta__podnadpis">
      {zeSouboru
        ? 'Seznam pochází z propojení osob, firem a registru smluv.'
        : 'Hotový seznam dodavatelů s vazbou zatím není — tenhle je poskládaný z přehledu osob a jejich firem.'}
      {' '}Objem po letech je na stránce <a href="/penize#dodavatele-vazby">Peníze města</a>.
    </p>

    <StavDat
      stav={zeSouboru ? zDodavatelu.stav : zOsob.stav}
      zdroj={zeSouboru ? zDodavatelu.zdroj : zOsob.zdroj}
      co="Dodavatelé s vazbou na politiky"
      prazdno={dodavateleSerazeni.length === 0}
      modul="propojení dat"
    />

    {
      dodavateleSerazeni.length > 0 && (
        <div class="tabulka-obal">
          <table>
            <thead>
              <tr>
                <th scope="col">Firma</th>
                <th scope="col">Vlastnictví</th>
                <th scope="col" class="cislo">Od města celkem</th>
                <th scope="col" class="cislo">Smluv</th>
                <th scope="col">Kdo je ve firmě uvedený</th>
              </tr>
            </thead>
            <tbody>
              {dodavateleSerazeni.map((d) => (
                <tr>
                  <td>
                    {d.ico && zname.has(d.ico) ? <a href={`/penize/${d.ico}`}>{d.nazev}</a> : d.nazev}
                    {d.ico && (
                      <>
                        <br />
                        <span class="mono">{d.ico}</span>
                      </>
                    )}
                  </td>
                  <td>{d.mestsky === true ? 'městská organizace nebo firma města' : d.mestsky === false ? 'mimo město' : 'v datech není'}</td>
                  <td class="cislo">{d.od_mesta_czk === null ? 'v datech není' : kc(d.od_mesta_czk)}</td>
                  <td class="cislo">{d.smluv === null ? '—' : cislo(d.smluv)}</td>
                  <td>
                    {d.osoby.length === 0
                      ? 'v datech není'
                      : d.osoby.map((o, i) => (
                          <>
                            {i > 0 && ', '}
                            {o.osoba_id ? (
                              <a href={`/lide/${o.osoba_id}`}>{o.jmeno ?? o.osoba_id}</a>
                            ) : (
                              (o.jmeno ?? 'neuvedeno')
                            )}
                            {o.role.length > 0 && <span class="stav-dat__zdroj"> ({o.role.join(', ')})</span>}
                          </>
                        ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section class="karta">
    <h2 class="karta__nadpis">Sponzoring politických stran</h2>
    <p class="karta__podnadpis">
      Dary a příspěvky tak, jak je uvádí zdroj. Sponzoring je zákonná a veřejně vykazovaná věc —
      přehled ho uvádí jako fakt, ne jako výtku. Prověřeno bylo {cislo(sponzoringProverovan)}{' '}
      {sklonuj(sponzoringProverovan, 'osoba', 'osoby', 'osob')}.
    </p>

    <StavDat
      stav={zOsob.stav}
      zdroj={zOsob.zdroj}
      co="Sponzoring politických stran"
      prazdno={zOsob.stav === 'ok' && sponzoring.length === 0}
      modul="propojení dat"
      poznamky={
        zOsob.stav === 'ok' && sponzoring.length === 0
          ? ['Zdroj sponzoring prověřoval, ale u žádné z osob žádný záznam nenašel.']
          : []
      }
    />

    {
      sponzoring.length > 0 && (
        <div class="tabulka-obal">
          <table>
            <thead>
              <tr>
                <th scope="col">Dárce</th>
                <th scope="col">Strana</th>
                <th scope="col">Druh</th>
                <th scope="col" class="cislo">Částka</th>
                <th scope="col" class="cislo">Rok</th>
              </tr>
            </thead>
            <tbody>
              {sponzoring.map((s) => (
                <tr>
                  <td>
                    {s.osoba_id ? (
                      <a href={`/lide/${s.osoba_id}`}>
                        {s.darce ?? jmenaOsob.get(s.osoba_id) ?? s.osoba_id}
                      </a>
                    ) : (
                      (s.darce ?? '—')
                    )}
                  </td>
                  <td>
                    {s.strana ?? '—'}
                    {s.strana_ico && <span class="mono"> ({s.strana_ico})</span>}
                  </td>
                  <td>{s.druh ?? '—'}</td>
                  <td class="cislo">{s.castka_czk === null ? '—' : kc(s.castka_czk)}</td>
                  <td class="cislo">{s.rok ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  {
    propojeni.metodika.length > 0 && (
      <JakPocitame>
        <p>
          Popis metody je převzatý ze zdroje propojení — na webu tak stojí přesně to, podle čeho
          data vznikla.
        </p>
        <dl class="metodika">
          {propojeni.metodika.map((m) => (
            <>
              <dt>{m.klic.replace(/_/g, ' ')}</dt>
              <dd>{polidstiData(m.text)}</dd>
            </>
          ))}
        </dl>
      </JakPocitame>
    )
  }

  <section class="karta">
    <h2 class="karta__nadpis">Jak číst tenhle přehled</h2>
    <ul>
      <li>
        <strong>Zápis ve firmě je fakt z rejstříku.</strong> Neříká nic o tom, jestli se firma
        o zakázku ucházela nebo jak se rozhodovalo.
      </li>
      <li>
        <strong>Městská organizace není totéž co cizí dodavatel.</strong> Peníze, které město
        posílá vlastní příspěvkové organizaci, nejsou platba cizí firmě.
      </li>
      <li>
        <strong>„S městem neobchoduje" je stejně důležité jako částka.</strong> Bez těch firem by
        přehled tvrdil něco jiného, než co v datech je.
      </li>
      <li>
        <strong>„Nezjištěno" není nula.</strong> Osoby, u kterých se identita nedohledala, jsou
        uvedené zvlášť, aby seznam nevypadal úplněji, než je.
      </li>
      <li>
        <strong>Hlasování se uvádí samostatně.</strong> U bodů, kde má hlasující vazbu na dotčenou
        firmu, je to napsané přímo u daného hlasování — opět jen jako věcný záznam.
      </li>
    </ul>
  </section>
</Zaklad>
