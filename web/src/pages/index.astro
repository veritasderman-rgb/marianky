---
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import VydaniKarta from '../components/Vydani.astro';
import Sledovat from '../components/Sledovat.astro';
import {
  nactiCiselnikTagu,
  nactiCisla,
  nactiClanky,
  nactiHlasovani,
  nactiLidi,
  nactiProtistrany,
  nactiUsneseni,
  nactiVydani,
  type Nacteno,
} from '../lib/data';
import JakPocitame from '../components/JakPocitame.astro';
import { zplostiHlasovani, zplostiUsneseni } from '../lib/prehledy';
import {
  cislo,
  datum,
  datumKratke,
  nazevOrganu,
  nazevVysledku,
  nazevZdroje,
  obdobiText,
  orderCs,
  orez,
  sklonuj,
} from '../lib/format';

const zVydani = nactiVydani();
const vydani = zVydani.data ?? [];
const posledni = vydani[0] ?? null;
const starsi = vydani.slice(1, 9);

/* Rozcestník stavu: co už v přehledu je a co se ještě sbírá. Prázdná sekce
   bez vysvětlení je horší než žádná sekce, takže se to napíše natvrdo.
   Stojí až pod obsahem — čtenář přišel kvůli tomu, co se ve městě děje. */
const zUsneseni = nactiUsneseni();
const zHlasovani = nactiHlasovani();
const zPenez = nactiProtistrany();
const zLidi = nactiLidi();
const zCisel = nactiCisla();
const zClanku = nactiClanky();

interface Radek {
  nazev: string;
  cesta: string;
  pocet: number;
  jednotka: string;
  zdroj: Nacteno<unknown>;
  modul: string;
}

const prehled: Radek[] = [
  { nazev: 'Usnesení', cesta: '/usneseni', pocet: zplostiUsneseni(zUsneseni.data ?? []).length, jednotka: 'bodů', zdroj: zUsneseni, modul: 'A1' },
  { nazev: 'Hlasování', cesta: '/hlasovani', pocet: zplostiHlasovani(zHlasovani.data ?? []).length, jednotka: 'hlasování', zdroj: zHlasovani, modul: 'A1' },
  { nazev: 'Peníze', cesta: '/penize', pocet: (zPenez.data?.protistrany ?? []).length, jednotka: 'protistran', zdroj: zPenez, modul: 'A3' },
  { nazev: 'Lidé', cesta: '/lide', pocet: (zLidi.data ?? []).length, jednotka: 'profilů', zdroj: zLidi, modul: 'B1' },
  { nazev: 'Zpravodaj', cesta: '/zpravodaj', pocet: (zCisel.data ?? []).length, jednotka: 'čísel', zdroj: zCisel, modul: 'A2' },
  { nazev: 'Články ze zpravodaje', cesta: '/zpravodaj', pocet: (zClanku.data ?? []).length, jednotka: 'článků', zdroj: zClanku, modul: 'A2' },
];

function stavText(r: Radek): string {
  if (r.zdroj.stav === 'chyba') return 'zdroj se nepodařilo načíst';
  if (r.zdroj.stav === 'chybi') return 'data zatím nejsou sebraná';
  if (r.pocet === 0) return 'načteno, ale zatím prázdné';
  return 'připraveno';
}

function stavTrida(r: Radek): string {
  if (r.zdroj.stav === 'chyba') return 'vazne';
  if (r.zdroj.stav === 'chybi') return 'pozor';
  if (r.pocet === 0) return 'neznamo';
  return 'dobre';
}

/* ── Podklad pro osobní sekci „Vaše sledovaná témata" ─────────────────────
   Web je statický a bez přihlášení: výběr témat žije jen v localStorage
   prohlížeče. Server proto nemůže vědět, co kdo sleduje — do stránky se vloží
   poslední dění ke VŠEM tématům a prohlížeč z toho vybere jen ta sledovaná.
   Data se skládají při buildu, nic se nikam nedotahuje. */

const zTagu = nactiCiselnikTagu();
const tagy = [...(zTagu.data?.tagy ?? [])].sort((a, b) => orderCs(a.nazev, b.nazev));

interface UdalostTematu {
  /** ISO datum — jen pro řazení. */
  d: string;
  /** Datum k zobrazení, naformátované už při buildu. */
  dz: string;
  /** Druh záznamu — Usnesení / Hlasování / Zpravodaj. */
  k: string;
  n: string; // nadpis
  m: string; // doplňující údaje
  o: string | null; // odkaz
}

const NEJVYSE_UDALOSTI = 5;
const denikTemat = new Map<string, UdalostTematu[]>();

function pridejUdalost(tagyPolozky: string[] | undefined, u: UdalostTematu): void {
  for (const t of tagyPolozky ?? []) {
    const pole = denikTemat.get(t);
    if (pole) pole.push(u);
    else denikTemat.set(t, [u]);
  }
}

for (const u of zplostiUsneseni(zUsneseni.data ?? [])) {
  pridejUdalost(u.tagy, {
    d: u.datum,
    dz: datumKratke(u.datum),
    k: 'Usnesení',
    n: orez(u.nazev ?? '', 140),
    m: `${nazevOrganu(u.organ)} · bod ${u.cislo}`,
    o: u.url ?? null,
  });
}

for (const h of zplostiHlasovani(zHlasovani.data ?? [])) {
  pridejUdalost(h.tagy, {
    d: h.datum,
    dz: datumKratke(h.datum),
    k: 'Hlasování',
    n: orez(h.nazev ?? '', 140),
    m: `${nazevOrganu(h.organ)} · ${nazevVysledku(h.vysledek)} · pro ${h.pro}, proti ${h.proti}, zdrželo se ${h.zdrzel}`,
    o: null,
  });
}

for (const c of zClanku.data ?? []) {
  const m = /^(\d{4})-(\d{2})/.exec(c.cislo ?? '');
  pridejUdalost(c.tagy, {
    d: m ? `${m[1]}-${m[2]}-01` : '',
    dz: m ? `${Number(m[2])}/${m[1]}` : '—',
    k: 'Zpravodaj',
    n: orez(c.nadpis ?? '', 140),
    m: `Zpravodaj ${c.cislo}${c.strana ? `, strana ${c.strana}` : ''}`,
    o: `/zpravodaj/${c.cislo}`,
  });
}

const denikProKlienta: Record<string, { nazev: string; udalosti: UdalostTematu[] }> = {};
for (const t of tagy) {
  const udalosti = (denikTemat.get(t.id) ?? [])
    .sort((a, b) => b.d.localeCompare(a.d))
    .slice(0, NEJVYSE_UDALOSTI);
  denikProKlienta[t.id] = { nazev: t.nazev, udalosti };
}

// `<` se escapuje, aby obsah nemohl předčasně ukončit značku <script>.
const denikJson = JSON.stringify(denikProKlienta).replace(/</g, '\\u003c');
---

<Zaklad
  titulek="Poslední vydání"
  aktivni="vydani"
  nadpis="Naše Mariánky v přehledech"
  uvod="Neveřejný přehled dění ve městě. Každé tvrzení má odkaz na zdroj a čísla se propisují z dat, ne z převyprávění. Když se zdroj v daném týdnu nepodaří přečíst, je to na stránce napsané — nesmí to vypadat, že se nic nedělo."
>
  {
    posledni ? (
      <>
        <VydaniKarta vydani={posledni} uroven="h2" />
        {starsi.length > 0 && (
          <section>
            <h2>Starší vydání</h2>
            <ul class="seznam">
              {starsi.map((v) => (
                <li class="polozka">
                  <h3 class="polozka__nazev">
                    <a href={`/vydani/${v.id}`}>
                      {v.datum ? datum(v.datum) : (v.nazev ?? `Vydání ${v.id}`)}
                    </a>
                  </h3>
                  <div class="polozka__hlava">
                    <span>
                      {obdobiText(v.obdobi_od ?? null, v.obdobi_do ?? null) ?? v.id}
                    </span>
                    {typeof v.souhrn?.polozek === 'number' && (
                      <span>
                        {`${cislo(v.souhrn.polozek)} ${sklonuj(
                          v.souhrn.polozek,
                          'záznam',
                          'záznamy',
                          'záznamů',
                        )}`}
                      </span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    ) : (
      <StavDat
        stav={zVydani.stav}
        zdroj="týdenní vydání"
        co="Týdenní vydání"
        prazdno={zVydani.stav === 'ok' && vydani.length === 0}
        poznamky={[
          'Týdenní přehled se skládá z ostatních sekcí. Jakmile budou hotové, objeví se tady.',
        ]}
      />
    )
  }

  <section class="sledovana" id="sledovana">
    <h2>Vaše sledovaná témata</h2>
    <p class="uvod">
      Témata si můžete označit na stránce tématu nebo v seznamu níže. Výběr zůstává jen ve vašem
      prohlížeči — nic se neodesílá a nikam se nepřihlašujete. Když prohlížeč vyčistíte, výběr
      zmizí.
    </p>

    <div id="sledovana-obsah">
      <div class="stav-dat">
        <strong class="stav-dat__nadpis">Sledování potřebuje JavaScript</strong>
        <span>
          Bez něj se výběr témat nedá uložit ani zobrazit. Všechna témata mají vlastní stránku,
          například <a href="/temata/rozpocet">/temata/rozpocet</a>.
        </span>
      </div>
    </div>

    {
      tagy.length > 0 && (
        <details class="tabulkovy-pohled">
          <summary>Vybrat témata ke sledování ({cislo(tagy.length)})</summary>
          <ul class="seznam-temat">
            {tagy.map((t) => (
              <li class="seznam-temat__polozka">
                <a href={`/temata/${t.id}`}>{t.nazev}</a>
                <span class="seznam-temat__pocet">
                  {cislo((denikTemat.get(t.id) ?? []).length)} záznamů
                </span>
                <Sledovat tag={t.id} nazev={t.nazev} kompakt />
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {/* Datový blok, ne kód — proto is:inline: nemá se bundlovat ani zpracovávat. */}
    <script is:inline type="application/json" id="denik-temat" set:html={denikJson} />
  </section>

  <section>
    <h2>Co v přehledu už je</h2>
    <p class="uvod">
      Každou sekci plní vlastní sběr dat. Tabulka rozlišuje „ještě se nesbíralo",
      „sebralo se, ale nic tam nebylo" a „sběr selhal" — to jsou tři různé věci a nesmějí
      vypadat stejně.
    </p>
    <div class="tabulka-obal">
      <table>
        <thead>
          <tr>
            <th scope="col">Sekce</th>
            <th scope="col" class="cislo">Záznamů</th>
            <th scope="col">Stav</th>
            <th scope="col">Zdrojová data</th>
          </tr>
        </thead>
        <tbody>
          {prehled.map((r) => (
            <tr>
              <td><a href={r.cesta}>{r.nazev}</a></td>
              <td class="cislo">{r.pocet > 0 ? `${cislo(r.pocet)} ${r.jednotka}` : '—'}</td>
              <td>
                <span class={`stav-znacka stav-znacka--${stavTrida(r)}`}>
                  <span class="stav-znacka__tecka" aria-hidden="true" />
                  <span>{stavText(r)}</span>
                </span>
              </td>
              <td>{nazevZdroje(r.zdroj.zdroj)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <JakPocitame>
    <p>
      Týdenní přehled se skládá jednou týdně z veřejných zdrojů: portálu usnesení města,
      úřední desky, registru smluv, kalendáře akcí, mediálního monitoringu a Městského
      zpravodaje. Období je vždy uvedené v záhlaví vydání a zahrnuje sedm dní.
    </p>
    <p>
      Každá sekce nese vlastní stav a ten se na stránce neschovává. Rozlišují se čtyři
      různé situace, které vypadají podobně, ale znamenají něco jiného:
    </p>
    <ul>
      <li><strong>Přibylo</strong> — zdroj se načetl a nové záznamy jsou vypsané.</li>
      <li><strong>Beze změny</strong> — zdroj se načetl, ale nic nového v něm nebylo.</li>
      <li>
        <strong>Data končí dřív</strong> — zdroj sice odpověděl, ale poslední záznam v něm je
        starší než sledované období. Pak o té části dění nevíme nic a je to napsané nahoře.
      </li>
      <li>
        <strong>Nepodařilo se načíst</strong> — porucha zdroje. Také se hlásí nahoře, protože
        se nesmí splést s klidným týdnem.
      </li>
    </ul>
    <p>
      Rutinní papírování se v sekcích shlukuje do jednoho řádku (například desítky
      dokumentů „Uložení písemnosti"), aby nezatlačilo zbytek týdne. Nic se přitom
      nezahazuje — zhuštěný řádek se dá rozbalit a vypsat celý.
    </p>
  </JakPocitame>
</Zaklad>

<script>
  /* ── Osobní sekce „Vaše sledovaná témata" ─────────────────────────────
     Data ke všem tématům jsou v <script type="application/json"> na stránce,
     výběr v localStorage. Skript jen spáruje jedno s druhým — žádné dotahování
     dat, funguje i offline.

     Texty ze zdrojů (názvy usnesení, firem) se do DOM vkládají výhradně přes
     textContent, nikdy přes innerHTML. */
  {
    interface Udalost {
      d: string;
      dz: string;
      k: string;
      n: string;
      m: string;
      o: string | null;
    }
    type Denik = Record<string, { nazev: string; udalosti: Udalost[] }>;

    const KLIC = 'sledovana-temata';
    const obal = document.getElementById('sledovana-obsah');
    const zdroj = document.getElementById('denik-temat');

    let denik: Denik = {};
    try {
      denik = zdroj?.textContent ? (JSON.parse(zdroj.textContent) as Denik) : {};
    } catch {
      denik = {};
    }

    function sledovana(): string[] {
      try {
        const s = localStorage.getItem(KLIC);
        const d: unknown = s ? JSON.parse(s) : [];
        return Array.isArray(d) ? d.filter((x): x is string => typeof x === 'string') : [];
      } catch {
        return [];
      }
    }

    function prvek(znacka: string, trida: string, text?: string): HTMLElement {
      const el = document.createElement(znacka);
      if (trida) el.className = trida;
      if (text !== undefined) el.textContent = text;
      return el;
    }

    function hlaska(nadpis: string, text: string): HTMLElement {
      const box = prvek('div', 'stav-dat stav-dat--prazdno');
      box.appendChild(prvek('strong', 'stav-dat__nadpis', nadpis));
      box.appendChild(prvek('span', '', text));
      return box;
    }

    function vykresli(): void {
      if (!obal) return;
      obal.textContent = '';
      const vybrana = sledovana().filter((t) => denik[t]);

      if (vybrana.length === 0) {
        obal.appendChild(
          hlaska(
            'Zatím nesledujete žádné téma',
            'Vyberte si témata v seznamu níže nebo tlačítkem „Sledovat téma“ přímo na stránce tématu. Přehled se pak složí tady.',
          ),
        );
        return;
      }

      const seznam = prvek('ul', 'seznam');
      for (const id of vybrana) {
        const t = denik[id];
        const li = prvek('li', 'polozka');

        const hlava = prvek('div', 'polozka__hlava');
        hlava.appendChild(prvek('span', '', 'Sledované téma'));
        hlava.appendChild(
          prvek('span', '', t.udalosti.length === 0 ? 'zatím bez záznamů' : `poslední: ${t.udalosti[0].dz}`),
        );
        li.appendChild(hlava);

        const nadpis = prvek('h3', 'polozka__nazev');
        const odkaz = document.createElement('a');
        odkaz.href = `/temata/${encodeURIComponent(id)}`;
        odkaz.textContent = t.nazev;
        nadpis.appendChild(odkaz);
        li.appendChild(nadpis);

        if (t.udalosti.length === 0) {
          li.appendChild(
            prvek('p', 'graf-poznamka', 'K tomuhle tématu zatím v datech není žádný záznam.'),
          );
        } else {
          const ul = prvek('ul', 'deni');
          for (const u of t.udalosti) {
            const radek = prvek('li', 'deni__polozka');
            radek.appendChild(prvek('span', 'deni__datum', u.dz));
            radek.appendChild(prvek('span', 'deni__druh', u.k));
            if (u.o) {
              const a = document.createElement('a');
              a.href = u.o;
              a.textContent = u.n;
              if (u.o.startsWith('http')) a.rel = 'noreferrer noopener';
              radek.appendChild(a);
            } else {
              radek.appendChild(prvek('span', '', u.n));
            }
            radek.appendChild(prvek('span', 'deni__meta', u.m));
            ul.appendChild(radek);
          }
          li.appendChild(ul);
        }

        const patka = prvek('p', 'graf-poznamka');
        const naHlasovani = document.createElement('a');
        naHlasovani.href = `/hlasovani/tag/${encodeURIComponent(id)}`;
        naHlasovani.textContent = 'Hlasování k tématu';
        patka.appendChild(naHlasovani);
        li.appendChild(patka);

        seznam.appendChild(li);
      }
      obal.appendChild(seznam);
    }

    document.addEventListener('temata-zmena', vykresli);
    window.addEventListener('storage', (e) => {
      if (e.key === KLIC) vykresli();
    });
    vykresli();
  }
</script>
