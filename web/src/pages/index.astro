---
import Zaklad from '../layouts/Zaklad.astro';
import StavDat from '../components/StavDat.astro';
import VydaniKarta from '../components/Vydani.astro';
import Sledovat from '../components/Sledovat.astro';
import Rozcestnik from '../components/Rozcestnik.astro';
import Hero from '../components/Hero.astro';
import type { PolozkaHero } from '../components/Hero.astro';
import { nactiConfig, nactiJson } from '../lib/data';
import {
  nactiCiselnikTagu,
  nactiCisla,
  nactiClanky,
  nactiHlasovani,
  nactiLidi,
  nactiProtistrany,
  nactiUsneseni,
  nactiVydani,
} from '../lib/data';
import JakPocitame from '../components/JakPocitame.astro';
import { zplostiHlasovani, zplostiUsneseni } from '../lib/prehledy';
import { prehledStavuSekci, souhrnBehu, type StavBehuSekce } from '../lib/stav_sekci';
import type { Uroven } from '../components/Dlazdice.astro';
import {
  cislo,
  datum,
  datumKratke,
  nazevOrganu,
  nazevVysledku,
  obdobiText,
  orderCs,
  orez,
  sklonuj,
} from '../lib/format';

const zVydani = nactiVydani();
const vydani = zVydani.data ?? [];
const posledni = vydani[0] ?? null;
const starsi = vydani.slice(1, 9);

const zUsneseni = nactiUsneseni();
const zHlasovani = nactiHlasovani();
const zPenez = nactiProtistrany();
const zLidi = nactiLidi();
const zCisel = nactiCisla();
const zClanku = nactiClanky();

const usneseni = zplostiUsneseni(zUsneseni.data ?? []);
const hlasovani = zplostiHlasovani(zHlasovani.data ?? []);

/* Co všechno přehled indexuje — živě z dat. Napsat ta čísla do textu
   ručně by znamenalo, že za měsíc lžou. */
const zKomisi = nactiJson<{ souhrn?: { zapisu?: number } }>('komise/prehled.json', {});
const z106 = nactiJson<{ souhrn?: { s_textem?: number } }>('informace106/prehled.json', {});

const heroPolozky: PolozkaHero[] = [
  { pocet: usneseni.length, popis: 'bodů usnesení rady a zastupitelstva', cesta: '/usneseni' },
  { pocet: hlasovani.length, popis: 'hlasování se jmény', cesta: '/hlasovani' },
  { pocet: (zPenez.data?.protistrany ?? []).length, popis: 'protistran v registru smluv', cesta: '/penize' },
  { pocet: zKomisi.data?.souhrn?.zapisu ?? 0, popis: 'zápisů z komisí', cesta: '/komise' },
  { pocet: (zClanku.data ?? []).length, popis: 'článků ze zpravodaje', cesta: '/zpravodaj' },
  { pocet: z106.data?.souhrn?.s_textem ?? 0, popis: 'odpovědí na žádosti o informace', cesta: '/informace' },
  { pocet: (zLidi.data ?? []).length, popis: 'profilů lidí a firem', cesta: '/lide' },
]
  .filter((p) => p.pocet > 0)
  /* Šest, ne sedm. Sedmá dlaždice zůstane na řádku sama a vypadá jako
     nedopatření; šestka se rozloží na 6 × 1, 3 × 2 i 2 × 3. */
  .slice(0, 6);

/* ── Stav sběru dat ────────────────────────────────────────────────────
   Jeden řádek za každou sekci z rejstříku (`lib/sekce.ts`), ne ručně
   vypsaný výběr. Dřív tu bylo šest řádků z doby šesti sekcí a o zbylých
   šestnácti tabulka mlčela. Skládá to `lib/stav_sekci.ts` ze znaků,
   záznamu posledního běhu a mapy zdrojů.

   U adresářů, které datum nenesou, se sloupec „Data k" naplní z toho,
   co už stránka stejně načetla: poslední jednání, poslední číslo. */
const posledniJednani = (d: { datum: string }[]): string | null =>
  d.reduce<string | null>((max, x) => (x.datum && (!max || x.datum > max) ? x.datum : max), null);

const posledniCislo = (() => {
  const c = zCisel.data ?? [];
  const nej = c.reduce<{ rok: number; mesic: number } | null>((m, x) => {
    if (typeof x.rok !== 'number' || typeof x.mesic !== 'number') return m;
    return !m || x.rok > m.rok || (x.rok === m.rok && x.mesic > m.mesic) ? { rok: x.rok, mesic: x.mesic } : m;
  }, null);
  return nej ? `číslo ${nej.mesic}/${nej.rok}` : null;
})();

const stav = prehledStavuSekci({
  vydani: posledni?.datum ? `vydání ${datumKratke(posledni.datum)}` : null,
  usneseni: (() => {
    const d = posledniJednani(usneseni);
    return d ? `jednání ${datumKratke(d)}` : null;
  })(),
  hlasovani: (() => {
    const d = posledniJednani(hlasovani);
    return d ? `jednání ${datumKratke(d)}` : null;
  })(),
  zpravodaj: posledniCislo,
});

const beh = stav.beh.data;
const behSouhrn = beh ? souhrnBehu(beh) : null;

/* Stavová barva nikdy nestojí sama — text vedle tečky je vždy (DESIGN.md §3.4). */
const UROVEN_BEHU: Record<StavBehuSekce, Uroven> = {
  ok: 'dobre',
  selhal: 'vazne',
  preskocen: 'pozor',
  schybami: 'pozor',
  castecne: 'pozor',
  mimo: 'neznamo',
};

function urovenDat(s: 'ok' | 'chybi' | 'chyba'): Uroven {
  return s === 'ok' ? 'dobre' : s === 'chybi' ? 'pozor' : 'vazne';
}

function textDat(s: 'ok' | 'chybi' | 'chyba'): string {
  return s === 'ok' ? 'na disku' : s === 'chybi' ? 'soubor chybí' : 'soubor nešel přečíst';
}

/* ── Co v přehledu přibylo ──────────────────────────────────────────────
   Ručně vedený deník změn z `config/novinky.json`. Je to autorská
   znalost o projektu, ne údaj o městě — proto config, ne data. */
interface Novinka {
  datum: string;
  nadpis: string;
  text: string;
  cesta?: string;
}
const zNovinek = nactiConfig<{ novinky?: Novinka[] }>('novinky.json', {});
const novinky = [...(zNovinek.data.novinky ?? [])]
  .filter((n) => n && typeof n.datum === 'string' && typeof n.nadpis === 'string')
  .sort((a, b) => b.datum.localeCompare(a.datum));
const NOVINEK_ROVNOU = 4;
const novinkyRovnou = novinky.slice(0, NOVINEK_ROVNOU);
const novinkyDalsi = novinky.slice(NOVINEK_ROVNOU);

/* ── Podklad pro osobní sekci „Vaše sledovaná témata" ─────────────────────
   Web je statický a bez přihlášení: výběr témat žije jen v localStorage
   prohlížeče. Server proto nemůže vědět, co kdo sleduje — do stránky se vloží
   poslední dění ke VŠEM tématům a prohlížeč z toho vybere jen ta sledovaná.
   Data se skládají při buildu, nic se nikam nedotahuje. */

const zTagu = nactiCiselnikTagu();
const tagy = [...(zTagu.data?.tagy ?? [])].sort((a, b) => orderCs(a.nazev, b.nazev));

interface UdalostTematu {
  /** ISO datum — jen pro řazení. */
  d: string;
  /** Datum k zobrazení, naformátované už při buildu. */
  dz: string;
  /** Druh záznamu — Usnesení / Hlasování / Zpravodaj. */
  k: string;
  n: string; // nadpis
  m: string; // doplňující údaje
  o: string | null; // odkaz
}

const NEJVYSE_UDALOSTI = 5;
const denikTemat = new Map<string, UdalostTematu[]>();

function pridejUdalost(tagyPolozky: string[] | undefined, u: UdalostTematu): void {
  for (const t of tagyPolozky ?? []) {
    const pole = denikTemat.get(t);
    if (pole) pole.push(u);
    else denikTemat.set(t, [u]);
  }
}

for (const u of zplostiUsneseni(zUsneseni.data ?? [])) {
  pridejUdalost(u.tagy, {
    d: u.datum,
    dz: datumKratke(u.datum),
    k: 'Usnesení',
    n: orez(u.nazev ?? '', 140),
    m: `${nazevOrganu(u.organ)} · bod ${u.cislo}`,
    o: u.url ?? null,
  });
}

for (const h of zplostiHlasovani(zHlasovani.data ?? [])) {
  pridejUdalost(h.tagy, {
    d: h.datum,
    dz: datumKratke(h.datum),
    k: 'Hlasování',
    n: orez(h.nazev ?? '', 140),
    m: `${nazevOrganu(h.organ)} · ${nazevVysledku(h.vysledek)} · pro ${h.pro}, proti ${h.proti}, zdrželo se ${h.zdrzel}`,
    o: null,
  });
}

for (const c of zClanku.data ?? []) {
  const m = /^(\d{4})-(\d{2})/.exec(c.cislo ?? '');
  pridejUdalost(c.tagy, {
    d: m ? `${m[1]}-${m[2]}-01` : '',
    dz: m ? `${Number(m[2])}/${m[1]}` : '—',
    k: 'Zpravodaj',
    n: orez(c.nadpis ?? '', 140),
    m: `Zpravodaj ${c.cislo}${c.strana ? `, strana ${c.strana}` : ''}`,
    o: `/zpravodaj/${c.cislo}`,
  });
}

const denikProKlienta: Record<string, { nazev: string; udalosti: UdalostTematu[] }> = {};
for (const t of tagy) {
  const udalosti = (denikTemat.get(t.id) ?? [])
    .sort((a, b) => b.d.localeCompare(a.d))
    .slice(0, NEJVYSE_UDALOSTI);
  denikProKlienta[t.id] = { nazev: t.nazev, udalosti };
}

// `<` se escapuje, aby obsah nemohl předčasně ukončit značku <script>.
const denikJson = JSON.stringify(denikProKlienta).replace(/</g, '\\u003c');
---

<Zaklad
  titulek="Poslední vydání"
  aktivni="vydani"
  bezZnaku
  bezNadpisu
  nadpis="Naše Mariánky v přehledech"
  uvod="Radnice zveřejňuje. Tenhle přehled to čte za vás. Usnesení, jmenovitá hlasování, smlouvy z registru, rozpočet, zápisy z komisí i odpovědi na žádosti o informace — všechno veřejné, všechno v PDF, jedno po druhém. Tady se v tom dá hledat, filtrovat a proklikat od jména k hlasování, od hlasování k usnesení a od usnesení ke smlouvě."
>
  <Hero polozky={heroPolozky} />

  <section class="karta karta--lazenska" id="o-prehledu">
    <h2 class="karta__nadpis">Město slíbilo portál občana. Tohle je přehled, který zatím chybí.</h2>
    <p class="karta__podnadpis">Ze stejných veřejných dokumentů, jen čitelně.</p>
    <p>
      Všechno, co je tu vidět, je veřejné už dnes. Leží to ale ve dvaceti PDF na
      pěti různých místech: usnesení na portálu rady, smlouvy v registru,
      rozpočet v Monitoru státní pokladny, zápisy z komisí v dokumentech úřadu,
      zpravodaj ve skenech. <strong>Kdo to má projít, projde jeden dokument a vzdá to.</strong>
    </p>
    <p>
      Přehled je čte strojově a skládá dohromady — na jedno hledání místo dvaceti
      stažených souborů. Sběr běží každý týden a co se nepodařilo přečíst, se
      nezamlčuje: u každé sekce je vidět, kdy naposledy zdroj odpověděl.
    </p>
    <hr class="kolonada-predel" aria-hidden="true" />
    <p>
      <strong>A u každého čísla je vidět, odkud je a kde data končí.</strong> Kde se
      zdroj nepodařilo přečíst, je to napsané. Kde je spojení jen odhad, je označené
      jako odhad — a u řetězu komise → rada je i změřené, jak často takový odhad
      sedí. Co nevíme, se tu netváří jako nula.
    </p>
    <p>
      Přehled je <strong>pokus týmu{' '}
      <a href="https://lepsiml.cz" rel="noopener">Za lepší Mariánské Lázně</a>{' '}
      ve spolupráci s umělou inteligencí</strong>: takhle myslíme transparentní
      radnici. Skutečný dashboard potřebuje přímé napojení na systémy radnice —
      tohle je poskládané jen z veřejných a dostupných zdrojů.{' '}
      <a href="/zdroje">Víc o tom, kdo za tím stojí a odkud data jsou.</a>
    </p>
  </section>

  {
    posledni ? (
      <>
        <VydaniKarta vydani={posledni} uroven="h2" />
        {starsi.length > 0 && (
          <section>
            <h2>Starší vydání</h2>
            <ul class="seznam">
              {starsi.map((v) => (
                <li class="polozka">
                  <h3 class="polozka__nazev">
                    <a href={`/vydani/${v.id}`}>
                      {v.datum ? datum(v.datum) : (v.nazev ?? `Vydání ${v.id}`)}
                    </a>
                  </h3>
                  <div class="polozka__hlava">
                    <span>
                      {obdobiText(v.obdobi_od ?? null, v.obdobi_do ?? null) ?? v.id}
                    </span>
                    {typeof v.souhrn?.polozek === 'number' && (
                      <span>
                        {`${cislo(v.souhrn.polozek)} ${sklonuj(
                          v.souhrn.polozek,
                          'záznam',
                          'záznamy',
                          'záznamů',
                        )}`}
                      </span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    ) : (
      <StavDat
        stav={zVydani.stav}
        zdroj="týdenní vydání"
        co="Týdenní vydání"
        prazdno={zVydani.stav === 'ok' && vydani.length === 0}
        poznamky={[
          'Týdenní přehled se skládá z ostatních sekcí. Jakmile budou hotové, objeví se tady.',
        ]}
      />
    )
  }

  <Rozcestnik
    nadpis="Kam dál"
    krome="vydani"
    uroven="h2"
  />

  {
    novinky.length > 0 && (
      <section class="novinky" id="novinky">
        <h2>Co v přehledu přibylo</h2>
        <p class="uvod">
          Přehled roste po týdnech. Tady je vidět, co přibylo naposledy a kde se to
          dá najít — ať se nemusí hádat, jestli je sekce nová, nebo jen přehlédnutá.
        </p>
        <ol class="novinky__seznam">
          {novinkyRovnou.map((n) => (
            <li class="novinky__polozka">
              <span class="novinky__datum">{datumKratke(n.datum)}</span>
              <span class="novinky__telo">
                <strong class="novinky__nadpis">
                  {n.cesta ? <a href={n.cesta}>{n.nadpis}</a> : n.nadpis}
                </strong>
                <span class="novinky__text">{n.text}</span>
              </span>
            </li>
          ))}
        </ol>
        {novinkyDalsi.length > 0 && (
          <details class="tabulkovy-pohled">
            <summary>
              Starší změny ({cislo(novinkyDalsi.length)})
            </summary>
            <ol class="novinky__seznam">
              {novinkyDalsi.map((n) => (
                <li class="novinky__polozka">
                  <span class="novinky__datum">{datumKratke(n.datum)}</span>
                  <span class="novinky__telo">
                    <strong class="novinky__nadpis">
                      {n.cesta ? <a href={n.cesta}>{n.nadpis}</a> : n.nadpis}
                    </strong>
                    <span class="novinky__text">{n.text}</span>
                  </span>
                </li>
              ))}
            </ol>
          </details>
        )}
      </section>
    )
  }

  <section class="sledovana" id="sledovana">
    <h2>Vaše sledovaná témata</h2>
    <p class="uvod">
      Témata si můžete označit na stránce tématu nebo v seznamu níže. Výběr zůstává jen ve vašem
      prohlížeči — nic se neodesílá a nikam se nepřihlašujete. Když prohlížeč vyčistíte, výběr
      zmizí.
    </p>

    <div id="sledovana-obsah">
      <div class="stav-dat">
        <strong class="stav-dat__nadpis">Sledování potřebuje JavaScript</strong>
        <span>
          Bez něj se výběr témat nedá uložit ani zobrazit. Všechna témata mají vlastní stránku,
          například <a href="/temata/rozpocet">/temata/rozpocet</a>.
        </span>
      </div>
    </div>

    {
      tagy.length > 0 && (
        <details class="tabulkovy-pohled">
          <summary>Vybrat témata ke sledování ({cislo(tagy.length)})</summary>
          <ul class="seznam-temat">
            {tagy.map((t) => (
              <li class="seznam-temat__polozka">
                <a href={`/temata/${t.id}`}>{t.nazev}</a>
                <span class="seznam-temat__pocet">
                  {cislo((denikTemat.get(t.id) ?? []).length)} záznamů
                </span>
                <Sledovat tag={t.id} nazev={t.nazev} kompakt />
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {/* Datový blok, ne kód — proto is:inline: nemá se bundlovat ani zpracovávat. */}
    <script is:inline type="application/json" id="denik-temat" set:html={denikJson} />
  </section>

  <section class="stav-sberu" id="stav-sberu">
    <h2>Stav sběru dat</h2>
    <p class="uvod">
      Rozcestník výše říká, co v které sekci je. Tahle tabulka říká, jak se to tam
      dostalo a jak je to čerstvé: každou sekci plní vlastní krok týdenního běhu a ten
      může selhat. Rozlišují se tři různé věci, které nesmějí vypadat stejně — jestli
      data <strong>na disku jsou</strong>, <strong>k jakému dni</strong> jsou, a jak
      dopadl <strong>poslední běh</strong>, který je má obnovovat. Selhaný krok nad
      staršími daty je běžný stav: web ukazuje minulý výsledek a tady je to napsané.
    </p>

    {
      beh && behSouhrn ? (
        <div class={`stav-behu ${behSouhrn.selhalo > 0 ? 'stav-behu--selhal' : ''}`}>
          <p class="stav-behu__veta">
            <strong>Poslední zaznamenaný běh: {datum(beh.datum)}</strong>
            {behSouhrn.jen.length > 0
              ? ` — cílený běh jen na: ${behSouhrn.jen.join(', ')}; ostatní kroky neběžely.`
              : behSouhrn.sberBezel
                ? ' — úplný běh se sběrem ze zdrojů.'
                : ' — jen přepočet z uložených dat, sběr ze zdrojů neběžel.'}
            {!behSouhrn.rezimZaznamenany && ' (Režim odhadnutý z kroků, záznam ho neuvádí.)'}{' '}
            {cislo(behSouhrn.kroku)} {sklonuj(behSouhrn.kroku, 'krok', 'kroky', 'kroků')}:{' '}
            {cislo(behSouhrn.ok)} v pořádku
            {behSouhrn.sChybami > 0 && `, ${cislo(behSouhrn.sChybami)} s chybami v logu`}
            {behSouhrn.selhalo > 0 && `, ${cislo(behSouhrn.selhalo)} ${sklonuj(behSouhrn.selhalo, 'selhal', 'selhaly', 'selhalo')}`}
            {behSouhrn.preskoceno > 0 && `, ${cislo(behSouhrn.preskoceno)} se ${sklonuj(behSouhrn.preskoceno, 'přeskočil', 'přeskočily', 'přeskočilo')}`}.
          </p>
          {(behSouhrn.selhane.length > 0 || behSouhrn.preskocene.length > 0 || behSouhrn.sChybamiKroky.length > 0) && (
            <ul class="stav-behu__kroky">
              {behSouhrn.selhane.map((k) => (
                <li>
                  <span class="stav-znacka stav-znacka--vazne">
                    <span class="stav-znacka__tecka" aria-hidden="true" />
                    <span>selhal</span>
                  </span>{' '}
                  <strong>{k.popis}</strong>
                  {k.chyba && <span class="stav-behu__chyba"> — {k.chyba}</span>}
                </li>
              ))}
              {behSouhrn.preskocene.map((k) => (
                <li>
                  <span class="stav-znacka stav-znacka--pozor">
                    <span class="stav-znacka__tecka" aria-hidden="true" />
                    <span>přeskočen</span>
                  </span>{' '}
                  <strong>{k.popis}</strong>
                  <span class="stav-behu__chyba">
                    {' '}— {k.stav === 'chybi_main' ? 'modul nemá vstupní bod, krok se nespustil' : 'modul chybí'}
                  </span>
                </li>
              ))}
              {behSouhrn.sChybamiKroky.map(({ krok, chyb }) => (
                <li>
                  <span class="stav-znacka stav-znacka--pozor">
                    <span class="stav-znacka__tecka" aria-hidden="true" />
                    <span>s chybami</span>
                  </span>{' '}
                  <strong>{krok.popis}</strong>
                  <span class="stav-behu__chyba">
                    {' '}— doběhl, ale jeho log hlásí {cislo(chyb)} {sklonuj(chyb, 'chybu', 'chyby', 'chyb')}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ) : (
        <StavDat
          stav={stav.beh.stav === 'ok' ? 'chybi' : stav.beh.stav}
          zdroj="logy/*/beh.json"
          co="Záznam posledního běhu"
          poznamky={['Tabulka níže proto říká jen, jaká data na disku jsou — ne jak dopadl běh, který je plní.']}
        />
      )
    }

    <p class="stav-sberu__souhrn">
      {cislo(stav.souhrn.sekci)} sekcí, {cislo(stav.souhrn.dataOk)} s daty na disku
      {stav.souhrn.dataChybi > 0 && `, ${cislo(stav.souhrn.dataChybi)} bez dat`}
      {stav.souhrn.behSelhal > 0 && `, u ${cislo(stav.souhrn.behSelhal)} selhal poslední běh`}
      {stav.souhrn.behPreskocen > 0 && `, u ${cislo(stav.souhrn.behPreskocen)} se krok přeskočil`}
      {stav.souhrn.behSChybami > 0 && `, u ${cislo(stav.souhrn.behSChybami)} hlásí log kroku chyby`}
      {stav.souhrn.behCastecne > 0 && `, u ${cislo(stav.souhrn.behCastecne)} část kroků neběžela`}
      {stav.souhrn.bezSberu > 0 && `, u ${cislo(stav.souhrn.bezSberu)} naposledy neběžel sběr ze zdroje`}.
    </p>

    <div class="tabulka-obal">
      <table class="tabulka-stavu">
        <thead>
          <tr>
            <th scope="col">Sekce</th>
            <th scope="col">Záznamů</th>
            <th scope="col">Data k</th>
            <th scope="col">Poslední běh</th>
            <th scope="col">Odkud</th>
          </tr>
        </thead>
        {stav.skupiny.map((sk) => (
          <tbody>
            <tr class="tabulka-stavu__skupina">
              <th scope="colgroup" colspan="5">{sk.nazev}</th>
            </tr>
            {sk.radky.map((r) => (
              <tr>
                <td>
                  <a href={r.sekce.cesta}>{r.sekce.nazev}</a>
                </td>
                <td class="tabulka-stavu__pocet">
                  {r.data.stav === 'ok' ? (
                    r.pocet
                  ) : (
                    <span class={`stav-znacka stav-znacka--${urovenDat(r.data.stav)}`}>
                      <span class="stav-znacka__tecka" aria-hidden="true" />
                      <span>{textDat(r.data.stav)}</span>
                    </span>
                  )}
                </td>
                <td class="tabulka-stavu__datum">{r.dataK}</td>
                <td>
                  <span class={`stav-znacka stav-znacka--${UROVEN_BEHU[r.beh.stav]}`}>
                    <span class="stav-znacka__tecka" aria-hidden="true" />
                    <span>{r.beh.text}</span>
                  </span>
                </td>
                <td class="tabulka-stavu__zdroje">
                  {r.zdroje.length > 0 ? r.zdroje.join(', ') : 'skládá se z ostatních sekcí'}
                </td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    <p class="graf-poznamka">
      „Data k" je datum, které si soubor sám nese z posledního přepočtu; u usnesení
      a hlasování je to datum posledního jednání v datech, u zpravodaje poslední číslo.
      Sloupec „Odkud" jmenuje vnější zdroje podle mapy v <a href="/diagramy">schématu
      zdrojů</a>. Sekce bez vlastního zdroje se skládá z ostatních.
    </p>
  </section>

  <JakPocitame>
    <p>
      Týdenní přehled se skládá jednou týdně z veřejných zdrojů: portálu usnesení města,
      úřední desky, registru smluv, kalendáře akcí, mediálního monitoringu a Městského
      zpravodaje. Období je vždy uvedené v záhlaví vydání a zahrnuje sedm dní.
    </p>
    <p>
      Každá sekce nese vlastní stav a ten se na stránce neschovává. Rozlišují se čtyři
      různé situace, které vypadají podobně, ale znamenají něco jiného:
    </p>
    <ul>
      <li><strong>Přibylo</strong> — zdroj se načetl a nové záznamy jsou vypsané.</li>
      <li><strong>Beze změny</strong> — zdroj se načetl, ale nic nového v něm nebylo.</li>
      <li>
        <strong>Data končí dřív</strong> — zdroj sice odpověděl, ale poslední záznam v něm je
        starší než sledované období. Pak o té části dění nevíme nic a je to napsané nahoře.
      </li>
      <li>
        <strong>Nepodařilo se načíst</strong> — porucha zdroje. Také se hlásí nahoře, protože
        se nesmí splést s klidným týdnem.
      </li>
    </ul>
    <p>
      Rutinní papírování se v sekcích shlukuje do jednoho řádku (například desítky
      dokumentů „Uložení písemnosti"), aby nezatlačilo zbytek týdne. Nic se přitom
      nezahazuje — zhuštěný řádek se dá rozbalit a vypsat celý.
    </p>
  </JakPocitame>
</Zaklad>

<script>
  /* ── Osobní sekce „Vaše sledovaná témata" ─────────────────────────────
     Data ke všem tématům jsou v <script type="application/json"> na stránce,
     výběr v localStorage. Skript jen spáruje jedno s druhým — žádné dotahování
     dat, funguje i offline.

     Texty ze zdrojů (názvy usnesení, firem) se do DOM vkládají výhradně přes
     textContent, nikdy přes innerHTML. */
  {
    interface Udalost {
      d: string;
      dz: string;
      k: string;
      n: string;
      m: string;
      o: string | null;
    }
    type Denik = Record<string, { nazev: string; udalosti: Udalost[] }>;

    const KLIC = 'sledovana-temata';
    const obal = document.getElementById('sledovana-obsah');
    const zdroj = document.getElementById('denik-temat');

    let denik: Denik = {};
    try {
      denik = zdroj?.textContent ? (JSON.parse(zdroj.textContent) as Denik) : {};
    } catch {
      denik = {};
    }

    function sledovana(): string[] {
      try {
        const s = localStorage.getItem(KLIC);
        const d: unknown = s ? JSON.parse(s) : [];
        return Array.isArray(d) ? d.filter((x): x is string => typeof x === 'string') : [];
      } catch {
        return [];
      }
    }

    function prvek(znacka: string, trida: string, text?: string): HTMLElement {
      const el = document.createElement(znacka);
      if (trida) el.className = trida;
      if (text !== undefined) el.textContent = text;
      return el;
    }

    function hlaska(nadpis: string, text: string): HTMLElement {
      const box = prvek('div', 'stav-dat stav-dat--prazdno');
      box.appendChild(prvek('strong', 'stav-dat__nadpis', nadpis));
      box.appendChild(prvek('span', '', text));
      return box;
    }

    function vykresli(): void {
      if (!obal) return;
      obal.textContent = '';
      const vybrana = sledovana().filter((t) => denik[t]);

      if (vybrana.length === 0) {
        obal.appendChild(
          hlaska(
            'Zatím nesledujete žádné téma',
            'Vyberte si témata v seznamu níže nebo tlačítkem „Sledovat téma“ přímo na stránce tématu. Přehled se pak složí tady.',
          ),
        );
        return;
      }

      const seznam = prvek('ul', 'seznam');
      for (const id of vybrana) {
        const t = denik[id];
        const li = prvek('li', 'polozka');

        const hlava = prvek('div', 'polozka__hlava');
        hlava.appendChild(prvek('span', '', 'Sledované téma'));
        hlava.appendChild(
          prvek('span', '', t.udalosti.length === 0 ? 'zatím bez záznamů' : `poslední: ${t.udalosti[0].dz}`),
        );
        li.appendChild(hlava);

        const nadpis = prvek('h3', 'polozka__nazev');
        const odkaz = document.createElement('a');
        odkaz.href = `/temata/${encodeURIComponent(id)}`;
        odkaz.textContent = t.nazev;
        nadpis.appendChild(odkaz);
        li.appendChild(nadpis);

        if (t.udalosti.length === 0) {
          li.appendChild(
            prvek('p', 'graf-poznamka', 'K tomuhle tématu zatím v datech není žádný záznam.'),
          );
        } else {
          const ul = prvek('ul', 'deni');
          for (const u of t.udalosti) {
            const radek = prvek('li', 'deni__polozka');
            radek.appendChild(prvek('span', 'deni__datum', u.dz));
            radek.appendChild(prvek('span', 'deni__druh', u.k));
            if (u.o) {
              const a = document.createElement('a');
              a.href = u.o;
              a.textContent = u.n;
              if (u.o.startsWith('http')) a.rel = 'noreferrer noopener';
              radek.appendChild(a);
            } else {
              radek.appendChild(prvek('span', '', u.n));
            }
            radek.appendChild(prvek('span', 'deni__meta', u.m));
            ul.appendChild(radek);
          }
          li.appendChild(ul);
        }

        const patka = prvek('p', 'graf-poznamka');
        const naHlasovani = document.createElement('a');
        naHlasovani.href = `/hlasovani/tag/${encodeURIComponent(id)}`;
        naHlasovani.textContent = 'Hlasování k tématu';
        patka.appendChild(naHlasovani);
        li.appendChild(patka);

        seznam.appendChild(li);
      }
      obal.appendChild(seznam);
    }

    document.addEventListener('temata-zmena', vykresli);
    window.addEventListener('storage', (e) => {
      if (e.key === KLIC) vykresli();
    });
    vykresli();
  }
</script>
