---
import Zaklad from '../../layouts/Zaklad.astro';
import StavDat from '../../components/StavDat.astro';
import Znacky from '../../components/Znacky.astro';
import Dlazdice from '../../components/Dlazdice.astro';
import GrafKarta from '../../components/GrafKarta.astro';
import Vazby from '../../components/Vazby.astro';
import CasovaOsa from '../../components/CasovaOsa.astro';
import type { Varianta } from '../../components/GrafKarta.astro';
import type { Polozka } from '../../components/Dlazdice.astro';
import { nactiCiselnikTagu, nactiClanky, nactiHlasovani, nactiLidi, nactiProtistrany, type Osobnost } from '../../lib/data';
import { mapaTagu, zplostiHlasovani } from '../../lib/prehledy';
import { jednou } from '../../lib/cache';
import { nactiCasovouOsu, proOsobu, slucUdalosti, udalost, type UdalostOsy } from '../../lib/osa';
import { statistikyOsoby, seradPocty } from '../../lib/profil';
import { grafVodorovny, type BodVodorovny } from '../../lib/grafy';
import {
  nactiOsobyFirmy,
  nactiProfily,
  nactiVazbyHlasovani,
  popisOvereni,
  popisVztahu,
  procenta,
  type Rez,
  type ShodaSOsobou,
} from '../../lib/vazby';
import { cislo, datumKratke, kc, nazevHlasu, nazevOrganu, nazevVysledku, sklonuj } from '../../lib/format';

export async function getStaticPaths() {
  const { data: lide } = jednou('lide', nactiLidi);
  const { data: soubory } = jednou('hlasovani', nactiHlasovani);
  const hlasovani = jednou('hlasovani-ploche', () => zplostiHlasovani(soubory ?? []));

  const znami = new Set((lide ?? []).map((o) => o.id));
  // Stránku dostanou i lidé, kteří hlasují, ale profil zatím nemají —
  // odkaz ze jmenovitého hlasování jinak vede na 404.
  const bezProfilu = new Map<string, string>();
  for (const h of hlasovani) {
    for (const j of h.jmenovite) {
      if (j.osoba_id && !znami.has(j.osoba_id) && !bezProfilu.has(j.osoba_id)) {
        bezProfilu.set(j.osoba_id, j.jmeno ?? j.osoba_id);
      }
    }
  }

  const cesty: { params: { id: string }; props: { osoba: Osobnost; maProfil: boolean } }[] = [];
  for (const o of lide ?? []) {
    if (o?.id) cesty.push({ params: { id: o.id }, props: { osoba: o, maProfil: true } });
  }
  for (const [id, jmeno] of bezProfilu) {
    cesty.push({ params: { id }, props: { osoba: { id, jmeno }, maProfil: false } });
  }
  return cesty;
}

const { osoba, maProfil } = Astro.props;

const zHlasovani = jednou('hlasovani', nactiHlasovani);
const zTagu = jednou('tagy', nactiCiselnikTagu);
const zOsobFirem = jednou('propojeni', nactiOsobyFirmy);
const zProfilu = jednou('profily', nactiProfily);
const zVazeb = jednou('vazby-hlasovani', nactiVazbyHlasovani);
const zLidi = jednou('lide', nactiLidi);
const zClanku = jednou('clanky', nactiClanky);
const zOsy = jednou('casova-osa', nactiCasovouOsu);

const ciselnik = jednou('tagy-mapa', () => mapaTagu(zTagu.data?.tagy ?? []));
const vsechna = jednou('hlasovani-ploche', () => zplostiHlasovani(zHlasovani.data ?? []));
const zname = jednou(
  'protistrany-klice',
  () => new Set((jednou('protistrany', nactiProtistrany).data.protistrany ?? []).map((p) => p.klic)),
);
const jmenaLidi = jednou('lide-jmena', () => new Map((zLidi.data ?? []).map((o) => [o.id, o.jmeno])));

/* ── Statistiky ───────────────────────────────────────────────────────────
   Přednost má `lide/profily.json`: rozlišuje omluvenou a neomluvenou neúčast
   a počítá věci, které z prostého součtu neplynou. Když soubor chybí, spočítá
   se základ přímo z hlasovacích dat, ať stránka není prázdná. */

const profil = zProfilu.data.profily.get(osoba.id) ?? null;
const st = statistikyOsoby(vsechna, osoba.id);
const celkem = st.zaznamy.length;
const rez: Rez | null = profil?.celek ?? null;

/** Podíl se u malého vzorku neukazuje — zdroj to výslovně zakazuje. */
function podilNeboPocet(hodnota: number | null, pocet: number | null, maly: boolean): string {
  if (maly) return pocet === null ? '—' : `${cislo(pocet)} hlasování (na podíl je vzorek malý)`;
  return procenta(hodnota);
}

const dlazdice: Polozka[] = rez
  ? [
      {
        popisek: 'Zaznamenaných hlasování',
        hodnota: cislo(rez.prilezitosti ?? celkem),
        doplnek:
          profil?.prvni && profil?.posledni
            ? `od ${datumKratke(profil.prvni)} do ${datumKratke(profil.posledni)}`
            : undefined,
      },
      {
        popisek: 'Odevzdaných hlasů',
        hodnota: cislo(rez.hlasoval ?? 0),
        doplnek: `${podilNeboPocet(rez.podil_hlasoval, rez.hlasoval, rez.maly_vzorek)} — pro, proti nebo zdržel se`,
      },
      {
        popisek: 'Neúčast',
        hodnota: cislo(rez.neucast ?? 0),
        doplnek:
          rez.omluven !== null || rez.nepritomen !== null
            ? `z toho omluvených ${cislo(rez.omluven ?? 0)}`
            : undefined,
      },
      {
        popisek: 'Shoda s většinou',
        hodnota: profil?.shodaSVetsinou
          ? podilNeboPocet(
              profil.shodaSVetsinou.podil,
              profil.shodaSVetsinou.shodnych,
              profil.shodaSVetsinou.maly_vzorek,
            )
          : '—',
        doplnek: profil?.shodaSVetsinou?.odlisnych
          ? `odlišně hlasoval ${cislo(profil.shodaSVetsinou.odlisnych)}×`
          : undefined,
      },
    ]
  : [
      {
        popisek: 'Zaznamenaných hlasování',
        hodnota: cislo(celkem),
        doplnek:
          st.prvni && st.posledni ? `od ${datumKratke(st.prvni)} do ${datumKratke(st.posledni)}` : undefined,
      },
      {
        popisek: 'Odevzdaných hlasů',
        hodnota: cislo(st.odevzdanych),
        doplnek:
          st.podilOdevzdanych === null
            ? undefined
            : `${procenta(st.podilOdevzdanych)} — pro, proti nebo zdržel se`,
      },
      { popisek: 'Hlasoval pro', hodnota: cislo(st.pocty.pro ?? 0) },
      { popisek: 'Hlasoval proti', hodnota: cislo(st.pocty.proti ?? 0) },
    ];

/* ── Graf: rozložení hlasů ────────────────────────────────────────────── */

const POPISKY_HLASU: [keyof Rez, string][] = [
  ['pro', 'pro'],
  ['proti', 'proti'],
  ['zdrzel', 'zdržel se'],
  ['nehlasoval', 'nehlasoval'],
  ['omluven', 'omluvená neúčast'],
  ['nepritomen', 'nepřítomen bez zapsané omluvy'],
];

const bodyRozlozeni: BodVodorovny[] = rez
  ? POPISKY_HLASU.map(([klic, nazev]) => ({ nazev, hodnota: (rez[klic] as number | null) ?? 0 })).filter(
      (b) => b.hodnota > 0,
    )
  : seradPocty(st.pocty).map((r) => ({ nazev: nazevHlasu(r.hlas), hodnota: r.pocet }));

const variantyRozlozeni: Varianta[] =
  bodyRozlozeni.length > 0
    ? [{ klic: 'rozlozeni', popisek: 'Rozložení hlasů', graf: grafVodorovny(bodyRozlozeni, 'Rozložení hlasů') }]
    : [];

/* ── Graf: aktivita podle témat ───────────────────────────────────────── */

const NEJVYSE_TEMAT = 12;
const temataOsoby = profil && profil.podleTagu.length > 0
  ? profil.podleTagu
      .map((t) => ({ id: t.tag, nazev: t.nazev ?? ciselnik.get(t.tag)?.nazev ?? t.tag, pocet: t.prilezitosti ?? 0 }))
      .sort((a, b) => b.pocet - a.pocet)
  : [...st.podleTagu.entries()]
      .map(([id, pocet]) => ({ id, nazev: ciselnik.get(id)?.nazev ?? id, pocet }))
      .sort((a, b) => b.pocet - a.pocet);
const temataGraf = temataOsoby.slice(0, NEJVYSE_TEMAT);

const variantyTemat: Varianta[] =
  temataGraf.length > 0
    ? [
        {
          klic: 'temata',
          popisek: 'Aktivita podle témat',
          graf: (() => {
            const g = grafVodorovny(
              temataGraf.map((t) => ({ nazev: t.nazev, hodnota: t.pocet, odkaz: `/temata/${t.id}` })),
              'Hlasování podle témat',
            );
            if (temataOsoby.length > temataGraf.length) {
              g.poznamky.push(
                `Zobrazeno ${cislo(temataGraf.length)} nejčastějších témat z ${cislo(temataOsoby.length)}.`,
              );
            }
            g.poznamky.push(
              'Jedno hlasování může mít víc témat, součet je proto vyšší než počet hlasování.',
            );
            return g;
          })(),
        },
      ]
    : [];

/* ── Kde je osoba uvedená (firmy) ─────────────────────────────────────── */

const zaznamOsoby = zOsobFirem.data.osoby.find((o) => o.osoba_id === osoba.id) ?? null;
const firmy = [...(zaznamOsoby?.firmy ?? [])].sort(
  (a, b) => (b.od_mesta_czk ?? 0) - (a.od_mesta_czk ?? 0),
);
const mestskych = firmy.filter((f) => f.vztah === 'mestsky-subjekt').length;
const obchodujicich = firmy.filter((f) => f.vztah === 'obchoduje-s-mestem').length;
const bezVazby = firmy.filter((f) => f.vztah === 'bez-vazby-na-mesto').length;
const sponzoring = zaznamOsoby?.sponzoring ?? null;

/* ── Vazby u konkrétních hlasování ────────────────────────────────────── */

const vsechnyVazby = zVazeb.data.vazby;
const vazbyOsoby = vsechnyVazby.filter((v) => v.osoba_id === osoba.id);
const idSVazbou = new Set(vazbyOsoby.map((v) => v.hlasovani_id).filter((x): x is string => Boolean(x)));

/* ── Shoda s ostatními ────────────────────────────────────────────────── */

const shodne = profil?.nejcastejiShodne ?? [];
const odlisne = profil?.nejcastejiOdlisne ?? [];

function jmenoShody(s: ShodaSOsobou): string {
  return s.jmeno ?? (s.osoba_id ? (jmenaLidi.get(s.osoba_id) ?? s.osoba_id) : '—');
}

const spolehliveOmluvy = zProfilu.data.omluvySpolehliveOd;

/* ── Časová osa osoby ───────────────────────────────────────────────────
   Hlasování se na osu dává po JEDNÁNÍCH, ne po jednotlivých bodech. Tisíc
   značek nad sebou by z pruhu udělalo souvislý pás, ze kterého se nic nevyčte
   — a stránku by nafouklo o stovky kilobajtů. Jedno jednání = jedna značka
   s počty; jednotlivé body zůstávají v tabulce hlasovací historie níže. */

const podleJednani = new Map<string, { datum: string; organ: string; celkem: number; hlasy: Record<string, number> }>();
for (const z of st.zaznamy) {
  if (!z.h.datum) continue;
  const klic = `${z.h.organ}|${z.h.datum}`;
  const stav = podleJednani.get(klic) ?? { datum: z.h.datum, organ: z.h.organ, celkem: 0, hlasy: {} };
  stav.celkem++;
  stav.hlasy[z.hlas] = (stav.hlasy[z.hlas] ?? 0) + 1;
  podleJednani.set(klic, stav);
}

const udalostiHlasovani: UdalostOsy[] = [...podleJednani.entries()].map(([klic, j]) =>
  udalost({
    id: `jednani-${klic}`,
    datum: j.datum,
    druh: 'hlasovani',
    nadpis: `${nazevOrganu(j.organ)} — ${cislo(j.celkem)} ${sklonuj(j.celkem, 'hlasování', 'hlasování', 'hlasování')}`,
    detail: Object.entries(j.hlasy)
      .map(([h, p]) => `${nazevHlasu(h)} ${cislo(p)}×`)
      .join(', '),
    zdroj: 'hlasovani/ (jmenovité hlasování)',
    osoby: [osoba.id],
  }),
);

const udalostiFunkci: UdalostOsy[] = (osoba.funkce ?? [])
  .filter((f) => f.od)
  .map((f, i) =>
    udalost({
      id: `funkce-${osoba.id}-${i}`,
      datum: f.od as string,
      datum_do: f.do ?? null,
      druh: 'funkce',
      nadpis: f.nazev,
      detail: f.do ? `do ${f.do}` : 'v datech bez konce — nemusí to znamenat, že funkce trvá',
      zdroj: 'lide/osobnosti.json',
      osoby: [osoba.id],
    }),
  );

const clankyOsoby = (zClanku.data ?? []).filter((c) => (c.osoby ?? []).includes(osoba.id));
const udalostiClanku: UdalostOsy[] = clankyOsoby
  .map((c) => {
    const m = /^(\d{4})-(\d{2})/.exec(c.cislo ?? '');
    if (!m) return null;
    return udalost({
      id: `clanek-${c.id}`,
      datum: `${m[1]}-${m[2]}`,
      druh: 'zpravodaj',
      nadpis: c.nadpis,
      popis: c.perex ?? null,
      odkaz: `/zpravodaj/${c.cislo}`,
      detail: `Zpravodaj ${c.cislo}${c.strana ? `, strana ${c.strana}` : ''}`,
      zdroj: 'zpravodaj/clanky/',
      osoby: [osoba.id],
    });
  })
  .filter((u): u is UdalostOsy => u !== null);

const zJednotneOsy = proOsobu(zOsy.data ?? [], osoba.id);
const naOse = slucUdalosti(udalostiFunkci, udalostiHlasovani, udalostiClanku, zJednotneOsy);

const zdrojeOsy = [
  ...(udalostiFunkci.length > 0 ? ['lide/osobnosti.json (funkce)'] : []),
  ...(udalostiHlasovani.length > 0 ? ['hlasovani/ (jmenovitá hlasování, po jednáních)'] : []),
  ...(udalostiClanku.length > 0 ? ['zpravodaj/clanky/'] : []),
  ...(zJednotneOsy.length > 0 ? ['casova_osa/'] : []),
];
---

<Zaklad titulek={osoba.jmeno} aktivni="lide" nadpis={osoba.jmeno}>
  {
    !maProfil && (
      <div class="stav-dat stav-dat--chybi">
        <strong class="stav-dat__nadpis">Profil zatím není</strong>
        <span>
          Tahle osoba se objevuje ve jmenovitých hlasováních, ale popis, funkce ani zdroje
          zatím v <span class="stav-dat__zdroj">lide/osobnosti.json</span> nejsou. Níže je jen to,
          co plyne přímo z dat.
        </span>
      </div>
    )
  }

  <p class="uvod">
    {osoba.role && osoba.role.length > 0 && <>{osoba.role.join(', ')}. </>}
    {osoba.strana && <>Politická příslušnost: {osoba.strana}. </>}
  </p>

  {osoba.popis && <p>{osoba.popis}</p>}

  {
    osoba.funkce && osoba.funkce.length > 0 && (
      <section class="karta">
        <h2 class="karta__nadpis">Funkce</h2>
        <p class="karta__podnadpis">Funkce se v čase mění — proto s platností, ne jako aktuální stav.</p>
        <div class="tabulka-obal">
          <table>
            <thead>
              <tr><th scope="col">Funkce</th><th scope="col">Od</th><th scope="col">Do</th></tr>
            </thead>
            <tbody>
              {osoba.funkce.map((f) => (
                <tr>
                  <td>{f.nazev}</td>
                  <td class="cislo">{f.od ?? '—'}</td>
                  <td class="cislo">{f.do ?? 'trvá'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    naOse.length > 0 && (
      <CasovaOsa
        id="osa-osoby"
        nadpis="Časová osa"
        udalosti={naOse}
        popis="Funkce jako vodorovné pruhy, jednání a zmínky ve zpravodaji jako značky. Hlasování je na ose po jednáních, ne po jednotlivých bodech — jinak by z pruhu byl souvislý pás, ze kterého se nedá nic vyčíst. Jednotlivé body jsou v tabulce hlasovací historie níže."
        zdroje={zdrojeOsy}
        neuplnost="Osa ukazuje jen zaznamenanou veřejnou činnost z našich dat. Prázdné období neznamená, že osoba nic nedělala — znamená, že o tom v datech nic nemáme."
      />
    )
  }

  <h2>Hlasovací statistiky</h2>

  <StavDat
    stav={zHlasovani.stav}
    zdroj={zHlasovani.zdroj}
    co={`Jmenovitá hlasování ${osoba.jmeno}`}
    prazdno={zHlasovani.stav === 'ok' && celkem === 0 && rez === null}
    modul="A1 Usnesení a hlasování"
  />

  {
    (celkem > 0 || rez) && (
      <>
        <Dlazdice polozky={dlazdice} />

        <p class="graf-poznamka">
          Jmenovatel je počet hlasování, kde je osoba na jmenovité listině — ne počet všech
          jednání orgánu. Kdo na listině není, nemusel chybět: nemusel v tu dobu být členem
          orgánu. Podíly proto vypovídají o zaznamenaných hlasováních, ne o docházce, a neúčast
          nemá v datech uvedený důvod.
          {profil && profil.podleOrganu.length > 0 && (
            <>
              {' '}
              {`Rozdělení podle orgánu: ${profil.podleOrganu
                .map((o) => `${nazevOrganu(o.organ)} ${cislo(o.rez.prilezitosti ?? 0)}`)
                .join(', ')}.`}
            </>
          )}
        </p>

        {spolehliveOmluvy.length > 0 && (rez?.omluven ?? 0) >= 0 && rez && (
          <p class="graf-poznamka">
            Omluvenou a neomluvenou neúčast lze rozlišit jen tam, kde zdroj příznak omluvy zapisuje:
            {' '}
            {spolehliveOmluvy.map((o) => `${nazevOrganu(o.organ)} od roku ${o.od}`).join(', ')}.
            U starších zápisů je každá neúčast vedená jako „nepřítomen", ačkoliv se lidé
            samozřejmě omlouvali.
            {profil?.rozliseniOmluv?.podil !== null && profil?.rozliseniOmluv?.podil !== undefined && (
              <> U této osoby má rozlišení {procenta(profil.rozliseniOmluv.podil)} hlasování.</>
            )}
          </p>
        )}

        {variantyRozlozeni.length > 0 && (
          <GrafKarta
            id="rozlozeni-hlasu"
            nadpis="Rozložení hlasů"
            popis="Kolikrát osoba hlasovala jak. Neúčast je uvedená jako záznam z dat — přehled z ní nic nevyvozuje."
            varianty={variantyRozlozeni}
          />
        )}

        {variantyTemat.length > 0 && (
          <GrafKarta
            id="temata-osoby"
            nadpis="Aktivita podle témat"
            popis="U kolika hlasování se objevilo které téma. Téma se bere z tagů usnesení, ne z posouzení obsahu."
            varianty={variantyTemat}
          />
        )}

        {profil?.velkeCastky && (
          <section class="karta">
            <h2 class="karta__nadpis">Hlasování o velkých částkách</h2>
            <p class="karta__podnadpis">
              Body, kde usnesení uvádí částku nad{' '}
              {profil.velkeCastky.prah_czk === null ? 'stanovenou hranicí' : kc(profil.velkeCastky.prah_czk)}.
              Zdroj u nich publikuje jen počty hlasování, ne součty korun — část částek je
              v podkladech zjevně špatně načtená a součet by lhal.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Ukazatel</th>
                    <th scope="col" class="cislo">Počet hlasování</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>Na jmenovité listině</td><td class="cislo">{cislo(profil.velkeCastky.prilezitosti ?? 0)}</td></tr>
                  <tr><td>Hlasoval pro</td><td class="cislo">{cislo(profil.velkeCastky.pro ?? 0)}</td></tr>
                  <tr><td>Hlasoval proti</td><td class="cislo">{cislo(profil.velkeCastky.proti ?? 0)}</td></tr>
                  <tr><td>Zdržel se</td><td class="cislo">{cislo(profil.velkeCastky.zdrzel ?? 0)}</td></tr>
                  <tr><td>Nehlasoval</td><td class="cislo">{cislo(profil.velkeCastky.nehlasoval ?? 0)}</td></tr>
                  <tr><td>Neúčast</td><td class="cislo">{cislo(profil.velkeCastky.neucast ?? 0)}</td></tr>
                </tbody>
              </table>
            </div>
          </section>
        )}

        {profil?.odchylky && profil.odchylky.porovnatelnych !== null && (
          <section class="karta">
            <h2 class="karta__nadpis">Hlasy odlišné od většiny vlastního uskupení</h2>
            <p class="karta__podnadpis">
              Porovnává se jen tam, kde hlasovali aspoň dva členové téhož uskupení. Je to prostý
              rozdíl v datech, ne hodnocení — hlasovat jinak než klub je běžná součást
              zastupitelské práce.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Ukazatel</th>
                    <th scope="col" class="cislo">Hodnota</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Porovnatelných hlasování</td>
                    <td class="cislo">{cislo(profil.odchylky.porovnatelnych)}</td>
                  </tr>
                  <tr>
                    <td>Hlasoval jinak než většina uskupení</td>
                    <td class="cislo">{cislo(profil.odchylky.odchylek ?? 0)}</td>
                  </tr>
                  <tr>
                    <td>Podíl odlišných hlasů</td>
                    <td class="cislo">
                      {podilNeboPocet(profil.odchylky.podil, profil.odchylky.odchylek, profil.odchylky.maly_vzorek)}
                    </td>
                  </tr>
                  {profil.shodaSVetsinou?.jediny !== null && profil.shodaSVetsinou?.jediny !== undefined && (
                    <tr>
                      <td>Hlasoval odlišně od většiny celého orgánu jako jediný</td>
                      <td class="cislo">{cislo(profil.shodaSVetsinou.jediny)}×</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {(shodne.length > 0 || odlisne.length > 0) && (
          <section class="karta">
            <h2 class="karta__nadpis">Shoda hlasování s ostatními</h2>
            <p class="karta__podnadpis">
              Podíl hlasování, kde oba odevzdali stejný hlas, ze společných hlasování. Neúčast se
              nepočítá jako neshoda. Vysoká shoda vzniká i tím, že se většina bodů schvaluje
              jednomyslně — sama o sobě neznamená domluvu.
            </p>
            <div class="mrizka-2">
              {(
                [
                  ['Nejčastěji hlasovali stejně', shodne],
                  ['Nejčastěji hlasovali jinak', odlisne],
                ] as [string, ShodaSOsobou[]][]
              ).map(([nadpis, seznam]) =>
                seznam.length > 0 ? (
                  <div>
                    <strong>{nadpis}</strong>
                    <div class="tabulka-obal">
                      <table>
                        <thead>
                          <tr>
                            <th scope="col">Zastupitel</th>
                            <th scope="col" class="cislo">Shoda</th>
                            <th scope="col" class="cislo">Společných</th>
                          </tr>
                        </thead>
                        <tbody>
                          {seznam.slice(0, 8).map((s) => (
                            <tr>
                              <td>
                                {s.osoba_id ? (
                                  <a href={`/lide/${s.osoba_id}`}>{jmenoShody(s)}</a>
                                ) : (
                                  jmenoShody(s)
                                )}
                              </td>
                              <td class="cislo">
                                {s.maly_vzorek ? `${cislo(s.shodnych)} z ${cislo(s.spolecnych)}` : procenta(s.podil)}
                              </td>
                              <td class="cislo">{s.spolecnych === null ? '—' : cislo(s.spolecnych)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ) : null,
              )}
            </div>
          </section>
        )}
      </>
    )
  }

  {
    zProfilu.stav !== 'ok' && celkem > 0 && (
      <StavDat
        stav={zProfilu.stav}
        zdroj={zProfilu.zdroj}
        co="Hlasovací profil (shoda mezi zastupiteli, odchylky od uskupení, velké částky)"
        modul="hlasovací profily"
        poznamky={[
          'Statistiky výše jsou spočítané přímo z hlasovacích dat. Rozlišení omluvené neúčasti a shoda mezi zastupiteli se počítají jinde a zatím nejsou.',
        ]}
      />
    )
  }

  <h2 id="kde-je-aktivni">Kde je aktivní</h2>

  <StavDat
    stav={zOsobFirem.stav}
    zdroj={zOsobFirem.zdroj}
    co={`Firmy, ve kterých je ${osoba.jmeno} uvedený`}
    prazdno={zOsobFirem.stav === 'ok' && zaznamOsoby !== null && zaznamOsoby.firmyZjisteny && firmy.length === 0}
    modul="propojení dat"
    poznamky={
      zOsobFirem.stav === 'ok' && zaznamOsoby !== null && zaznamOsoby.firmyZjisteny && firmy.length === 0
        ? ['Identita byla dohledaná, ale žádné angažmá ve firmě u ní zdroj nevede.']
        : []
    }
  />

  {
    zaznamOsoby !== null && !zaznamOsoby.firmyZjisteny && (
      <div class="stav-dat stav-dat--chybi">
        <strong class="stav-dat__nadpis">Firmy se nedohledaly</strong>
        <span>
          Zdroj u téhle osoby seznam firem nevede: {popisOvereni(zaznamOsoby.overeni.stav)}
          {zaznamOsoby.overeni.kandidatu !== null && zaznamOsoby.overeni.kandidatu > 1 && (
            <> — v rejstříku je {cislo(zaznamOsoby.overeni.kandidatu)} osob téhož jména</>
          )}. Neznamená to, že žádné firmy nemá; znamená to, že se nedaly spolehlivě přiřadit.
        </span>
      </div>
    )
  }

  {
    firmy.length > 0 && (
      <section class="karta">
        <p class="karta__podnadpis">
          Všechny firmy, ve kterých je osoba podle zdrojů uvedená — včetně těch, které s městem
          nijak neobchodují. Z {cislo(firmy.length)} {sklonuj(firmy.length, 'firmy', 'firem', 'firem')}
          {' '}je {cislo(mestskych)} organizace města, {cislo(obchodujicich)} obchoduje s městem
          zvenčí a {cislo(bezVazby)} s městem neobchoduje.
        </p>

        <div class="tabulka-obal">
          <table>
            <thead>
              <tr>
                <th scope="col">Firma</th>
                <th scope="col">Vztah k městu</th>
                <th scope="col">Role</th>
                <th scope="col" class="cislo">Od města</th>
                <th scope="col" class="cislo">Městu</th>
                <th scope="col" class="cislo">Smluv</th>
              </tr>
            </thead>
            <tbody>
              {firmy.map((f) => (
                <tr>
                  <td>
                    {f.ico && zname.has(f.ico) ? <a href={`/penize/${f.ico}`}>{f.nazev}</a> : f.nazev}
                    {f.ico && (
                      <>
                        <br />
                        <span class="mono">{f.ico}</span>
                      </>
                    )}
                  </td>
                  <td>{popisVztahu(f.vztah)}</td>
                  <td>{f.role.length > 0 ? f.role.join(', ') : 'zdroj ji u firmy neuvádí'}</td>
                  <td class="cislo">
                    {f.vztah === 'bez-vazby-na-mesto'
                      ? '—'
                      : f.od_mesta_czk === null
                        ? 'v datech není'
                        : kc(f.od_mesta_czk)}
                  </td>
                  <td class="cislo">{f.mestu_czk === null ? '—' : kc(f.mestu_czk)}</td>
                  <td class="cislo">{f.smluv === null ? '—' : cislo(f.smluv)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="graf-poznamka">
          Zápis ve firmě je veřejný údaj z rejstříku. Sám o sobě neznamená nic víc, než že je
          osoba ve firmě zapsaná — přehled z něj nevyvozuje žádný závěr. Sloupec „Od města" je
          objem smluv mezi městem (či jeho organizacemi) a danou firmou, ne příjem osoby.
          {zaznamOsoby?.hlidacUrl && (
            <>
              {' '}
              <a href={zaznamOsoby.hlidacUrl} rel="noreferrer noopener">Profil osoby na Hlídači státu</a>
              {zaznamOsoby.overeni.stav && <> · {popisOvereni(zaznamOsoby.overeni.stav)}</>}
            </>
          )}
        </p>
      </section>
    )
  }

  {
    sponzoring !== null && (
      <section class="karta">
        <h2 class="karta__nadpis">Sponzoring politických stran</h2>
        <p class="karta__podnadpis">
          Dary a příspěvky tak, jak je uvádí zdroj. Zákonná a veřejně vykazovaná věc — přehled ji
          uvádí jako fakt, ne jako výtku.
          {sponzoring.uplne === false && ' Zdroj upozorňuje, že seznam nemusí být úplný.'}
        </p>

        {sponzoring.zaznamy.length === 0 ? (
          <p>
            Zdroj sponzoring u téhle osoby prověřoval a žádný záznam nenašel
            {sponzoring.zaznamu !== null && <> (záznamů: {cislo(sponzoring.zaznamu)})</>}.
          </p>
        ) : (
          <div class="tabulka-obal">
            <table>
              <thead>
                <tr>
                  <th scope="col">Strana</th>
                  <th scope="col">Druh</th>
                  <th scope="col" class="cislo">Částka</th>
                  <th scope="col" class="cislo">Rok</th>
                </tr>
              </thead>
              <tbody>
                {sponzoring.zaznamy.map((s) => (
                  <tr>
                    <td>{s.strana ?? '—'}</td>
                    <td>{s.druh ?? '—'}</td>
                    <td class="cislo">{s.castka_czk === null ? '—' : kc(s.castka_czk)}</td>
                    <td class="cislo">{s.rok ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )
  }

  {
    vazbyOsoby.length > 0 && (
      <section class="karta">
        <h2 class="karta__nadpis">Hlasování o firmách, kde je osoba uvedená</h2>
        <p class="karta__podnadpis">
          Body, u kterých zdroj eviduje vazbu této osoby na dotčenou firmu. Věcný výpis: jak
          hlasovala, v jaké roli je ve firmě uvedená a kolik firma od města dostala.
        </p>
        <Vazby vazby={vazbyOsoby} zname={zname} otevreno bezOsoby />
      </section>
    )
  }

  {
    celkem > 0 && (
      <section>
        <h2>Hlasovací historie</h2>
        <p class="uvod">
          Všechna zaznamenaná jmenovitá hlasování, od nejnovějšího.
          {vazbyOsoby.length > 0 && ' Sloupec „Vazba“ označuje body, u kterých zdroj eviduje vazbu na dotčenou firmu.'}
        </p>
        <div class="tabulka-obal">
          <table>
            <thead>
              <tr>
                <th scope="col">Datum</th>
                <th scope="col">Orgán</th>
                <th scope="col">Bod</th>
                <th scope="col">Hlas</th>
                <th scope="col">Výsledek</th>
                <th scope="col">Téma</th>
                {vazbyOsoby.length > 0 && <th scope="col">Vazba</th>}
              </tr>
            </thead>
            <tbody>
              {st.zaznamy.map((u) => (
                <tr>
                  <td class="cislo">{datumKratke(u.h.datum)}</td>
                  <td>{nazevOrganu(u.h.organ)}</td>
                  <td>{u.h.nazev}</td>
                  <td>
                    {nazevHlasu(u.hlas)}
                    {u.h.jmenovite.find((j) => j.osoba_id === osoba.id)?.omluven === true && (
                      <span class="stav-dat__zdroj"> (omluven)</span>
                    )}
                  </td>
                  <td>{nazevVysledku(u.h.vysledek)}</td>
                  <td><Znacky tagy={u.h.tagy} ciselnik={ciselnik} /></td>
                  {vazbyOsoby.length > 0 && (
                    <td>
                      {idSVazbou.has(u.h.id) ? (
                        <span class="znacka znacka--vazba">vazba na dotčenou firmu</span>
                      ) : (
                        ''
                      )}
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    osoba.zdroje && osoba.zdroje.length > 0 && (
      <section class="karta">
        <h2 class="karta__nadpis">Zdroje</h2>
        <ul>
          {osoba.zdroje.map((z) => (
            <li><a href={z} rel="noreferrer noopener">{z}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  <p><a href="/lide">← Zpět na přehled lidí</a> · <a href="/propojeni">Přehled vazeb samosprávy a firem</a></p>
</Zaklad>
