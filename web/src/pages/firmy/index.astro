---
/**
 * Firmy se sídlem ve městě.
 *
 * Zásada: že firma sídlí ve městě, není zásluha ani podezření. Zvýrazněné jsou
 * jen ty, u kterých zdroj eviduje aspoň jedno silné kritérium — a u každé je
 * vypsané, PODLE ČEHO je za důležitou označená. Kritéria si web nevymýšlí,
 * přebírá je i s metodikou z `firmy/prehled/dulezite.json`.
 */
import Zaklad from '../../layouts/Zaklad.astro';
import StavDat from '../../components/StavDat.astro';
import Dlazdice from '../../components/Dlazdice.astro';
import GrafKarta from '../../components/GrafKarta.astro';
import CasovaOsa from '../../components/CasovaOsa.astro';
import JakPocitame from '../../components/JakPocitame.astro';
import type { Varianta } from '../../components/GrafKarta.astro';
import type { Polozka } from '../../components/Dlazdice.astro';
import { jednou } from '../../lib/cache';
import {
  nactiCasovouRaduFirem,
  nactiDulezite,
  nactiMestoAFirmy,
  nactiObory,
  nactiSouhrnFirem,
  nactiSubjektyFirem,
  seradDulezite,
  souvisleRokyMapy,
} from '../../lib/firmy';
import { grafVodorovny } from '../../lib/grafy';
import { grafSpojnice } from '../../lib/grafy_rady';
import { udalost, type UdalostOsy } from '../../lib/osa';
import { cislo, datumVolneKratke, kc, kcZkraceno, polidstiData, sklonuj } from '../../lib/format';
import { spojStavy } from '../../lib/data';

const zSubjektu = jednou('firmy-subjekty', nactiSubjektyFirem);
const zDulezitych = jednou('firmy-dulezite', () => nactiDulezite(kc, cislo));
const zMesta = jednou('firmy-mesto', nactiMestoAFirmy);
const zOboru = jednou('firmy-obory', nactiObory);
const zRady = jednou('firmy-rada', nactiCasovouRaduFirem);
const zSouhrnu = jednou('firmy-souhrn', nactiSouhrnFirem);
const { poznamky: poznamkyStavu } = spojStavy(zSubjektu, zDulezitych);

const vsechny = zSubjektu.data.firmy ?? [];
const dulezite = seradDulezite(zDulezitych.data.firmy ?? []);
const souhrn = zSouhrnu.data;
const maData = vsechny.length > 0 || dulezite.length > 0;

/* ── Dlaždice ──────────────────────────────────────────────────────────── */

const dlazdice: Polozka[] = maData
  ? [
      {
        popisek: 'Firem se sídlem ve městě',
        hodnota: cislo(souhrn.celkem ?? vsechny.length),
        doplnek:
          souhrn.podleStavu.length > 0
            ? souhrn.podleStavu.map((s) => `${cislo(s.pocet)} ${s.nazev}`).join(' · ')
            : undefined,
      },
      {
        popisek: 'Obchoduje s městem',
        hodnota: cislo(souhrn.napojenychNaRegistr ?? zMesta.data.firmy.length),
        doplnek:
          zMesta.data.souhrn.objemVeMeste !== null
            ? `${kcZkraceno(zMesta.data.souhrn.objemVeMeste, true)} z registru smluv`
            : undefined,
      },
      {
        popisek: 'Se zvýrazněním v přehledu',
        hodnota: cislo(souhrn.vPrehleduDulezitych ?? dulezite.length),
        doplnek: 'každá s uvedeným kritériem',
      },
      {
        popisek: 'Právnických osob',
        hodnota: souhrn.pravnickychOsob === null ? '—' : cislo(souhrn.pravnickychOsob),
        doplnek:
          souhrn.fyzickychOsob === null
            ? undefined
            : `a ${cislo(souhrn.fyzickychOsob)} podnikajících fyzických osob`,
      },
    ]
  : [];

/* ── Obory ─────────────────────────────────────────────────────────────
   Zdroj nabízí tři pohledy a sám říká, který se má číst — přebírá se to
   i s vysvětlením, proč se ostatní dva liší. */

const NEJVYSE_OBORU = 18;
const variantyOboru: Varianta[] = zOboru.data.pohledy
  .filter((p) => p.polozky.length > 0)
  .map((p) => {
    const graf = grafVodorovny(
      p.polozky.slice(0, NEJVYSE_OBORU).map((o) => ({ nazev: o.nazev, hodnota: o.pocet })),
      p.nazev,
    );
    graf.tabulka = {
      hlavicka: [{ nazev: 'Obor' }, { nazev: 'Subjektů', cislo: true }],
      radky: p.polozky.map((o) => [o.nazev, cislo(o.pocet)]),
    };
    if (p.polozky.length > NEJVYSE_OBORU) {
      graf.poznamky.push(
        `V grafu je ${cislo(NEJVYSE_OBORU)} nejčetnějších z ${cislo(p.polozky.length)} položek; všechny jsou v tabulce.`,
      );
    }
    if (zOboru.data.mereni) graf.poznamky.push(zOboru.data.mereni);
    return { klic: p.klic, popisek: p.nazev.replace(' podle sekce', '').replace(' podle oddílu', ' (oddíly)'), graf };
  });

/* ── Vzniky a zániky ───────────────────────────────────────────────────── */

const rokyFirem = souvisleRokyMapy(zRady.data.vzniky, zRady.data.zaniky);
const variantyCasu: Varianta[] = [];

if (rokyFirem.length > 1) {
  const gVzniky = grafSpojnice(
    rokyFirem,
    [
      { klic: 'vzniky', nazev: 'Vzniklo subjektů', hodnoty: rokyFirem.map((r) => zRady.data.vzniky.get(r) ?? 0) },
      { klic: 'zaniky', nazev: 'Zaniklo subjektů', hodnoty: rokyFirem.map((r) => zRady.data.zaniky.get(r) ?? 0) },
    ],
    'Vzniky a zániky po letech',
    'subjektů',
  );
  gVzniky.poznamky.push(
    'Obě řady jsou ve stejné jednotce, proto mohou být v jednom grafu s jednou osou. Rok bez vzniku i bez zániku zůstává v ose jako nula a nepřeskakuje se.',
  );
  if (zRady.data.mereniVzniku) gVzniky.poznamky.push(zRady.data.mereniVzniku);
  if (zRady.data.mereniZaniku) gVzniky.poznamky.push(zRady.data.mereniZaniku);
  variantyCasu.push({ klic: 'zmeny', popisek: 'Vzniky a zániky', graf: gVzniky });
}

/* ── Časová osa firem s vazbou na město ────────────────────────────────── */

const NEJVYSE_NA_OSE = 60;
const naOse = dulezite.filter((f) => f.vznik).slice(0, NEJVYSE_NA_OSE);
const udalostiFirem: UdalostOsy[] = naOse.map((f) =>
  udalost({
    id: `firma-${f.klic}`,
    datum: f.vznik as string,
    datum_do: f.zanik,
    presnost: 'den',
    druh: 'firma',
    nadpis: f.nazev,
    odkaz: `/firmy/${f.klic}`,
    zdroj: 'rejstřík ARES',
    jistota: 'fakt',
    detail: `${f.kriteria.map((k) => k.nazev).join(', ')}${f.zanik ? ` · výmaz ${datumVolneKratke(f.zanik)}` : ''}`,
    firmy: f.ico ? [f.ico] : [],
  }),
);

/* ── Výpis firem ───────────────────────────────────────────────────────── */

const MAX_VYPIS = 400;
const vypis = vsechny.slice(0, MAX_VYPIS);
const klicoveDulezitych = new Set(dulezite.map((f) => f.klic));
---

<Zaklad
  titulek="Firmy ve městě"
  aktivni="firmy"
  nadpis="Firmy se sídlem ve městě"
  uvod="Ekonomické subjekty z rejstříku ARES, jejich obory a proměna v čase. Zvýrazněné jsou firmy s doloženým vztahem k městu — u každé je uvedené, podle čeho je za důležitou označená."
>
  <StavDat
    stav={zSubjektu.stav}
    zdroj={zSubjektu.zdroj}
    co="Firmy se sídlem ve městě"
    prazdno={zSubjektu.stav === 'ok' && !maData}
    modul="firmy z ARES"
    poznamky={poznamkyStavu}
  />

  {
    maData && (
      <>
        <Dlazdice polozky={dlazdice} />

        <p class="graf-poznamka">
          Že firma sídlí ve městě, samo o sobě nic neznamená — ani zásluhu, ani podezření. Přehled
          proto nikoho nehodnotí; odděluje jen doložený vztah k městu od pouhé adresy.
          {souhrn.sidloMimoObec.pocet !== null && souhrn.sidloMimoObec.pocet > 0 && (
            <>
              {' '}U {cislo(souhrn.sidloMimoObec.pocet)} subjektů platí navíc, že{' '}
              {souhrn.sidloMimoObec.poznamka ?? 'je ARES váže k městu jen historickou adresou'}.
            </>
          )}
        </p>

        {souhrn.velikost.poznamka && (
          <p class="graf-poznamka">
            <strong>Velikost firem:</strong> {souhrn.velikost.poznamka}
            {souhrn.velikost.od10 !== null && (
              <>
                {' '}Deset a víc zaměstnanců má {cislo(souhrn.velikost.od10)} subjektů, sto a víc{' '}
                {cislo(souhrn.velikost.od100 ?? 0)}.
              </>
            )}
          </p>
        )}

        {variantyOboru.length > 0 && (
          <>
            <GrafKarta
              id="obory"
              nadpis="Čím se město živí"
              popis="Kolik subjektů připadá na jednotlivé obory. Přepínač nabízí tři pohledy zdroje — liší se tím, koho do počtu berou."
              varianty={variantyOboru}
            />
            {zOboru.data.kteryCist && (
              <p class="graf-poznamka">
                <strong>Který pohled číst:</strong> {zOboru.data.kteryCist}
              </p>
            )}
            {zOboru.data.bezOboru.poznamka && (
              <p class="graf-poznamka">
                Bez určeného oboru je {cislo(zOboru.data.bezOboru.vsechny ?? 0)} subjektů.{' '}
                {zOboru.data.bezOboru.poznamka}
              </p>
            )}
          </>
        )}

        {variantyCasu.length > 0 && (
          <GrafKarta
            id="vzniky"
            nadpis="Vzniky a zániky v čase"
            popis="Kdy dnes existující subjekty vznikly a kdy končily. Vznik i zánik se počítají ve stejné jednotce, dají se proto číst vedle sebe."
            varianty={variantyCasu}
          />
        )}

        {udalostiFirem.length > 0 && (
          <CasovaOsa
            id="osa-firem"
            nadpis="Časová osa firem s vazbou na město"
            udalosti={udalostiFirem}
            popis="Vodorovný pruh je doba mezi zápisem a výmazem v rejstříku. Firma bez zapsaného výmazu končí značkou u data vzniku, ne čárou do dneška — že v rejstříku pořád je, neznamená, že funguje."
            zdroje={['rejstřík ARES', 'registr smluv města (podle něj se pozná obchod s městem)']}
            neuplnost={`Datum výmazu má jen obchodní rejstřík a jen u subjektů vedených jako zaniklé; ${
              zRady.data.dohledanoZaniku === null ? 'většinu zániků' : `mimo ${cislo(zRady.data.dohledanoZaniku)} dohledaných zániků`
            } tedy v datech nemáme. Prázdné pole „zánik" znamená NEVÍME, ne „trvá".${
              dulezite.length > NEJVYSE_NA_OSE
                ? ` Na ose je ${cislo(naOse.length)} firem z ${cislo(dulezite.length)} zvýrazněných.`
                : ''
            }`}
          />
        )}

        <section class="karta">
          <h2 class="karta__nadpis">Firmy s doloženým vztahem k městu</h2>
          <p class="karta__podnadpis">
            {cislo(dulezite.length)} {sklonuj(dulezite.length, 'firma', 'firmy', 'firem')} z{' '}
            {cislo(souhrn.celkem ?? vsechny.length)}. U každé je vypsané kritérium — bez něj by
            „důležitá" bylo jen tvrzení.
          </p>

          {zDulezitych.data.poctyPodleKriteria.length > 0 && (
            <p class="graf-poznamka">
              Podle kritérií:{' '}
              {zDulezitych.data.poctyPodleKriteria
                .map((k) => `${k.nazev} ${cislo(k.pocet)}`)
                .join(' · ')}
              . Jedna firma může splnit víc kritérií najednou, součet je proto vyšší než počet firem.
            </p>
          )}

          {dulezite.length === 0 ? (
            <p>Zdroj zatím žádnou firmu za zvýrazněnou neoznačuje.</p>
          ) : (
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Firma</th>
                    <th scope="col">IČO</th>
                    <th scope="col">Podle čeho je označená</th>
                    <th scope="col" class="cislo">Od města</th>
                    <th scope="col">Vlastnictví</th>
                  </tr>
                </thead>
                <tbody>
                  {dulezite.map((f) => (
                    <tr>
                      <td>
                        <a href={`/firmy/${f.klic}`}>{f.nazev}</a>
                      </td>
                      <td class="mono">{f.ico ?? 'bez IČO'}</td>
                      <td>
                        <ul class="duvody">
                          {f.kriteria.map((k) => (
                            <li>
                              <span class="duvod__nazev">{k.nazev}</span>
                              {k.detail && <span class="duvod__detail"> — {k.detail}</span>}
                            </li>
                          ))}
                        </ul>
                      </td>
                      <td class="cislo">{f.odMesta === null ? '—' : kc(f.odMesta)}</td>
                      <td>
                        {f.mestskyHolding
                          ? 'organizace města'
                          : f.odMesta !== null
                            ? 'mimo město'
                            : '—'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {zDulezitych.data.metodika.length > 0 && (
            <details class="tabulkovy-pohled">
              <summary>Jak to počítáme — podle čeho se firma označí za důležitou</summary>
              <dl class="metodika">
                {zDulezitych.data.metodika.map((m) => (
                  <>
                    <dt>{m.klic.replace(/_/g, ' ')}</dt>
                    <dd>{polidstiData(m.text)}</dd>
                  </>
                ))}
              </dl>
            </details>
          )}
        </section>

        {zMesta.data.firmy.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Kolik z peněz města zůstává ve městě</h2>
            <p class="karta__podnadpis">
              Z {cislo(zMesta.data.souhrn.protistranSIcem ?? 0)} protistran města s IČO má{' '}
              {cislo(zMesta.data.souhrn.veMeste ?? 0)} sídlo ve městě a{' '}
              {cislo(zMesta.data.souhrn.mimoMesto ?? 0)} mimo něj. Na místní firmy připadá{' '}
              {kcZkraceno(zMesta.data.souhrn.objemVeMeste, true)} z celkových{' '}
              {kcZkraceno(zMesta.data.souhrn.objemVsech, true)}.
            </p>
            <p class="graf-poznamka">
              Velkou část objemu u místních firem tvoří vlastní organizace města — technické služby,
              kultura, sportoviště. Sloupec „vlastnictví" v tabulce výše ten rozdíl drží: příspěvek
              zřizovatele vlastní organizaci není totéž co platba cizí firmě.
            </p>
            {zMesta.data.metodika.length > 0 && (
              <details class="tabulkovy-pohled">
                <summary>Jak se firmy párovaly s registrem smluv</summary>
                <dl class="metodika">
                  {zMesta.data.metodika.map((m) => (
                    <>
                      <dt>{m.klic.replace(/_/g, ' ')}</dt>
                      <dd>{m.text}</dd>
                    </>
                  ))}
                </dl>
              </details>
            )}
          </section>
        )}

        {zDulezitych.data.zebricky.map((z) => (
          <section class="karta">
            <h2 class="karta__nadpis">{z.nazev}</h2>
            <p class="karta__podnadpis">
              Žebříček přebírá zdroj. Pořadí není hodnocení — jen řazení podle jednoho údaje.
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Firma</th>
                    <th scope="col">IČO</th>
                    <th scope="col">Údaj</th>
                  </tr>
                </thead>
                <tbody>
                  {z.polozky.map((p) => (
                    <tr>
                      <td>
                        {p.ico && klicoveDulezitych.has(p.ico) ? (
                          <a href={`/firmy/${p.ico}`}>{p.nazev}</a>
                        ) : (
                          p.nazev
                        )}
                      </td>
                      <td class="mono">{p.ico ?? '—'}</td>
                      <td>{p.popis ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))}

        {vsechny.length > 0 && (
          <section class="karta">
            <h2 class="karta__nadpis">Všechny firmy</h2>
            <p class="karta__podnadpis">
              Řazeno podle názvu.{' '}
              {vypis.length < vsechny.length
                ? `Zobrazeno prvních ${cislo(vypis.length)} z ${cislo(vsechny.length)} — celý seznam by stránku zbytečně nafoukl. Firmy s vazbou na město jsou v tabulce výše všechny.`
                : `Celkem ${cislo(vsechny.length)}.`}
            </p>
            <div class="tabulka-obal">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Firma</th>
                    <th scope="col">IČO</th>
                    <th scope="col">Obor</th>
                    <th scope="col">Právní forma</th>
                    <th scope="col" class="cislo">Vznik</th>
                    <th scope="col">Stav</th>
                  </tr>
                </thead>
                <tbody>
                  {vypis.map((f) => (
                    <tr>
                      <td>
                        {klicoveDulezitych.has(f.klic) ? <a href={`/firmy/${f.klic}`}>{f.nazev}</a> : f.nazev}
                      </td>
                      <td class="mono">{f.ico ?? '—'}</td>
                      <td>{f.obor ?? 'v datech není'}</td>
                      <td>{f.pravniForma ?? '—'}</td>
                      <td class="cislo">{datumVolneKratke(f.vznik)}</td>
                      <td>{f.stav ?? 'v datech není'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {zSubjektu.data.metodika.length > 0 && (
          <JakPocitame nadpis="Jak to počítáme — a co data o firmách neříkají">
            <p>
              Podklad je rejstřík ARES doplněný registrem smluv města. Popis níže je převzatý ze
              zdroje, aby na webu stálo přesně to, podle čeho data vznikla.
            </p>
            <dl class="metodika">
              {zSubjektu.data.metodika.map((m) => (
                <>
                  <dt>{m.klic.replace(/_/g, ' ')}</dt>
                  <dd>{polidstiData(m.text)}</dd>
                </>
              ))}
            </dl>
          </JakPocitame>
        )}
      </>
    )
  }
</Zaklad>
