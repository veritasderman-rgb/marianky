---
/**
 * Detail firmy s doloženým vztahem k městu.
 *
 * Vlastní stránku dostávají jen firmy, které zdroj vede v přehledu důležitých
 * (`firmy/prehled/dulezite.json`). Pro zbylé tisíce subjektů se sídlem ve
 * městě by stránka neřekla nic než „sídlí tady", a to už stojí v přehledu.
 *
 * Kritérium důležitosti je první věc pod nadpisem — čtenář má hned vidět, proč
 * se na tuhle firmu vůbec dívá.
 */
import Zaklad from '../../layouts/Zaklad.astro';
import StavDat from '../../components/StavDat.astro';
import Dlazdice from '../../components/Dlazdice.astro';
import CasovaOsa from '../../components/CasovaOsa.astro';
import type { Polozka } from '../../components/Dlazdice.astro';
import { nactiProtistrany, type Protistrana } from '../../lib/data';
import { jednou } from '../../lib/cache';
import { nactiDulezite, nactiMestoAFirmy, seradDulezite, type DuleziaFirma } from '../../lib/firmy';
import { nactiOsuFirmy, popisModulu, udalost, slucUdalosti, type UdalostOsy } from '../../lib/osa';
import { cislo, datumVolneKratke, kc, kcZkraceno, nazevZdroje, sklonuj } from '../../lib/format';

export async function getStaticPaths() {
  const zDulezitych = jednou('firmy-dulezite', () => nactiDulezite(kc, cislo));
  return seradDulezite(zDulezitych.data.firmy ?? []).map((f) => ({
    params: { ico: f.klic },
    props: { firma: f },
  }));
}

const { firma } = Astro.props as { firma: DuleziaFirma };

const zMesta = jednou('firmy-mesto', nactiMestoAFirmy);
const zProtistran = jednou('protistrany', nactiProtistrany);

const vRegistru = firma.ico ? (zMesta.data.firmy.find((f) => f.ico === firma.ico) ?? null) : null;
const protistrana: Protistrana | null = firma.ico
  ? ((zProtistran.data.protistrany ?? []).find((p) => p.ico === firma.ico) ?? null)
  : null;

/* ── Časová osa firmy ──────────────────────────────────────────────────
   Jednotná osa z `casova_osa/firmy/{ico}.json` — jeden soubor na firmu, takže
   se nemusí číst celý adresář. Zápis a výmaz z rejstříku se doplní z ARES,
   protože v jednotné ose nemusí být. */

const zOsy = firma.ico ? nactiOsuFirmy(firma.ico) : null;
const zJednotneOsy = zOsy?.data.udalosti ?? [];

const vlastni: UdalostOsy[] = [];
if (firma.vznik) {
  vlastni.push(
    udalost({
      id: `${firma.klic}-vznik`,
      datum: firma.vznik,
      presnost: 'den',
      druh: 'firma',
      nadpis: 'Zápis do rejstříku',
      detail: firma.pravniForma,
      zdroj: 'rejstřík ARES',
      jistota: 'fakt',
    }),
  );
}
if (firma.zanik) {
  vlastni.push(
    udalost({
      id: `${firma.klic}-zanik`,
      datum: firma.zanik,
      presnost: 'den',
      druh: 'firma',
      nadpis: 'Výmaz z rejstříku',
      zdroj: 'obchodní rejstřík přes ARES',
      jistota: 'fakt',
    }),
  );
}

const naOse = slucUdalosti(vlastni, zJednotneOsy);
const zdrojeOsy = [
  'ARES — rejstříkové zápisy',
  ...popisModulu(zOsy?.data.moduly ?? []),
];

/* ── Dlaždice ──────────────────────────────────────────────────────────── */

const dlazdice: Polozka[] = [
  {
    popisek: 'Od města',
    hodnota: firma.odMesta === null ? '—' : kcZkraceno(firma.odMesta, true),
    doplnek:
      firma.odMesta === null
        ? 'v registru smluv města firma není'
        : `${kc(firma.odMesta)}${firma.smluv === null ? '' : ` ve ${cislo(firma.smluv)} ${sklonuj(firma.smluv, 'smlouvě', 'smlouvách', 'smlouvách')}`}`,
  },
  {
    popisek: 'Období s městem',
    hodnota: firma.prvniRok && firma.posledniRok ? `${firma.prvniRok}–${firma.posledniRok}` : '—',
    doplnek:
      firma.prvniRok && firma.posledniRok
        ? 'roky, ve kterých má registr smlouvu'
        : 'v registru smluv města firma není',
  },
  {
    popisek: 'Existuje',
    hodnota: firma.stav ?? (firma.zanik ? 'zaniklá' : 'v datech není'),
    doplnek: firma.zanik
      ? `výmaz ${datumVolneKratke(firma.zanik)}, zápis ${firma.vznik ? datumVolneKratke(firma.vznik) : 'v datech není'}`
      : firma.vznik
        ? `zápis ${datumVolneKratke(firma.vznik)}; datum výmazu zdroj nemá — není to „trvá"`
        : 'datum vzniku v datech není',
  },
  {
    popisek: 'Zaměstnanci',
    hodnota: firma.zamestnancuRozsah ?? '—',
    doplnek:
      firma.zamestnancuRozsah === null
        ? 'registr u téhle firmy pásmo nevede — není to nula'
        : 'pásmo z registru ekonomických subjektů, ne přesný počet',
  },
];

const poLetech = vRegistru ? [...vRegistru.poLetech.entries()].sort((a, b) => a[0] - b[0]) : [];
---

<Zaklad titulek={firma.nazev} aktivni="firmy" nadpis={firma.nazev}>
  <p class="uvod">
    {firma.ico ? <>IČO <span class="mono">{firma.ico}</span></> : <>bez IČO — zdroj ho u téhle firmy neuvádí</>}
    {firma.pravniForma && <> · {firma.pravniForma}</>}
    {firma.obor && <> · {firma.obor}</>}
    {firma.adresa && <> · {firma.adresa}</>}
  </p>

  {
    firma.sidloVObci === false && (
      <p class="graf-poznamka">
        Tahle firma dnes sídlí mimo Mariánské Lázně. ARES ji k městu váže historickou adresou —
        v přehledu je proto, že tu dřív sídlila, ne proto, že tu sídlí teď.
      </p>
    )
  }

  <section class="karta">
    <h2 class="karta__nadpis">Podle čeho je firma v přehledu zvýrazněná</h2>
    <p class="karta__podnadpis">
      Kritéria přebírá web ze zdroje a každé se dá dohledat. Zvýraznění není hodnocení firmy —
      jen upozornění, že s městem něco spojuje.
    </p>
    <ul class="duvody">
      {firma.kriteria.map((k) => (
        <li>
          <span class="duvod__nazev">{k.nazev}</span>
          {k.detail && <span class="duvod__detail"> — {k.detail}</span>}
          {k.zdroj && <span class="stav-dat__zdroj"> (zdroj: {nazevZdroje(k.zdroj)})</span>}
        </li>
      ))}
    </ul>
  </section>

  <Dlazdice polozky={dlazdice} />

  {
    firma.mestskyHolding && (
      <p class="graf-poznamka">
        Tohle je subjekt městského holdingu. Peníze, které mu město posílá, nejsou platby cizí
        firmě, ale financování vlastní organizace — technických služeb, kultury, sportovišť. Bez
        tohohle rozlišení by přehled tvrdil opak toho, co v datech stojí.
        {firma.vnitromestskyPrevod && ' Zdroj u smluv s touhle firmou uvádí, že jde o přesun peněz uvnitř města.'}
      </p>
    )
  }

  {
    naOse.length > 0 && (
      <CasovaOsa
        id="osa-firmy"
        nadpis="Časová osa firmy"
        udalosti={naOse}
        popis="Zápis a výmaz v rejstříku, smlouvy s městem a další doložené události. Roky bez jediné události zabírají na ose stejně místa jako ostatní — mezera je informace."
        zdroje={zdrojeOsy}
        neuplnost="Osa neobsahuje činnost firmy jako takovou, jen to, co je v našich datech — rejstříkové zápisy a doklady o vztahu k městu."
      />
    )
  }

  {
    firma.hlidac && (
      <section class="karta">
        <h2 class="karta__nadpis">Doplňky z Hlídače státu</h2>
        <p class="karta__podnadpis">
          Hlídač uvádí pásma, ne čísla. Přesný obrat ani počet zaměstnanců nezveřejňuje ani on,
          ani ARES.
        </p>
        <div class="tabulka-obal">
          <table>
            <thead>
              <tr><th scope="col">Údaj</th><th scope="col">Hodnota</th></tr>
            </thead>
            <tbody>
              <tr><td>Pásmo obratu</td><td>{firma.hlidac.obratPasmo ?? 'v datech není'}</td></tr>
              <tr><td>Pásmo počtu zaměstnanců</td><td>{firma.hlidac.zamestnancuPasmo ?? 'v datech není'}</td></tr>
              <tr><td>Obor podle Hlídače</td><td>{firma.hlidac.obor ?? 'v datech není'}</td></tr>
              <tr><td>Plátce DPH</td><td>{firma.hlidac.platceDph === null ? 'v datech není' : firma.hlidac.platceDph ? 'ano' : 'ne'}</td></tr>
              <tr><td>Osob ve vedení</td><td>{firma.hlidac.osobVeVedeni === null ? 'v datech není' : cislo(firma.hlidac.osobVeVedeni)}</td></tr>
              <tr>
                <td>Z toho s politickou angažovaností nebo sponzorstvím</td>
                <td>
                  {firma.hlidac.osobSVazbouNaPolitiku === null
                    ? 'v datech není'
                    : cislo(firma.hlidac.osobSVazbouNaPolitiku)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="graf-poznamka">
          Poslední řádek je údaj o OSOBÁCH ve vedení, ne o firmě, a neříká nic o tom, že by na
          něčem bylo něco v nepořádku. Politická angažovanost je veřejná a legální věc.
          {firma.hlidac.odkaz && (
            <>
              {' '}
              <a href={firma.hlidac.odkaz} rel="noreferrer noopener">Profil firmy na Hlídači státu</a>
            </>
          )}
        </p>
      </section>
    )
  }

  <section class="karta">
    <h2 class="karta__nadpis">Peníze od města po letech</h2>
    <StavDat
      stav={zMesta.stav}
      zdroj={zMesta.zdroj}
      co={`Objem smluv mezi městem a ${firma.nazev}`}
      prazdno={zMesta.stav === 'ok' && poLetech.length === 0}
      modul="firmy × registr smluv"
      poznamky={
        zMesta.stav === 'ok' && poLetech.length === 0
          ? ['Firma je v přehledu z jiného důvodu než obchodu s městem — v registru smluv města se nenašla.']
          : []
      }
    />
    {
      poLetech.length > 0 && (
        <>
          <p class="karta__podnadpis">
            {vRegistru?.smer === 'prijem' ? 'Město od firmy inkasovalo' : 'Město firmě zaplatilo'}{' '}
            {kc(vRegistru?.celkem ?? null)} ve {cislo(vRegistru?.smluv ?? 0)}{' '}
            {sklonuj(vRegistru?.smluv ?? 0, 'smlouvě', 'smlouvách', 'smlouvách')}
            {vRegistru?.smluvBezCeny ? `, z toho ${cislo(vRegistru.smluvBezCeny)} bez uvedené ceny` : ''}.
          </p>
          <div class="tabulka-obal">
            <table>
              <thead>
                <tr><th scope="col">Rok</th><th scope="col" class="cislo">Objem</th></tr>
              </thead>
              <tbody>
                {poLetech.map(([rok, castka]) => (
                  <tr>
                    <td class="cislo">{rok}</td>
                    <td class="cislo">{kc(castka)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {vRegistru?.smluvBezCeny ? (
            <p class="graf-poznamka">
              Smlouvy bez uvedené ceny se do objemů nezapočítávají. Chybějící cena není nula.
            </p>
          ) : null}
        </>
      )
    }
  </section>

  <p>
    <a href="/firmy">← Zpět na přehled firem</a>
    {
      protistrana && (
        <> · <a href={`/penize/${protistrana.klic}`}>Jednotlivé smlouvy s městem</a></>
      )
    }
    {
      firma.ico && !firma.hlidac?.odkaz && (
        <>
          {' · '}
          <a href={`https://www.hlidacstatu.cz/subjekt/${firma.ico}`} rel="noreferrer noopener">
            profil na Hlídači státu
          </a>
        </>
      )
    }
  </p>
</Zaklad>
