---
import Zaklad from '../../layouts/Zaklad.astro';
import StavDat from '../../components/StavDat.astro';
import Sledovat from '../../components/Sledovat.astro';
import CasovaOsa from '../../components/CasovaOsa.astro';
import CastiPoCastech from '../../components/CastiPoCastech.astro';
import { esc } from '../../lib/polozka_hlasovani';
import { nactiCiselnikTagu, nactiClanky, nactiHlasovani, nactiUsneseni, type Tag } from '../../lib/data';
import { zplostiHlasovani, zplostiUsneseni } from '../../lib/prehledy';
import { nactiOsuTagu, popisModulu, slucUdalosti, udalost, type UdalostOsy } from '../../lib/osa';
import { cislo, datumKratke, kc, nazevOrganu, nazevVysledku, orez } from '../../lib/format';

interface Udalost {
  datum: string;
  druh: 'usneseni' | 'hlasovani' | 'clanek';
  nadpis: string;
  popis: string | null;
  meta: string;
  odkaz: string | null;
}

export async function getStaticPaths() {
  const { data: ciselnik } = nactiCiselnikTagu();
  const { data: usneseniSoubory } = nactiUsneseni();
  const { data: hlasovaniSoubory } = nactiHlasovani();
  const { data: clanky } = nactiClanky();

  const usneseni = zplostiUsneseni(usneseniSoubory ?? []);
  const hlasovani = zplostiHlasovani(hlasovaniSoubory ?? []);

  return (ciselnik?.tagy ?? []).map((t) => {
    const udalosti: Udalost[] = [];

    for (const u of usneseni) {
      if (!(u.tagy ?? []).includes(t.id)) continue;
      udalosti.push({
        datum: u.datum,
        druh: 'usneseni',
        nadpis: u.nazev,
        popis: u.text ? orez(u.text, 180) : null,
        meta: `${nazevOrganu(u.organ)} · bod ${u.cislo}${typeof u.castka_czk === 'number' ? ` · ${kc(u.castka_czk)}` : ''}`,
        odkaz: u.url ?? null,
      });
    }

    for (const h of hlasovani) {
      if (!h.tagy.includes(t.id)) continue;
      udalosti.push({
        datum: h.datum,
        druh: 'hlasovani',
        nadpis: h.nazev,
        popis: `${nazevVysledku(h.vysledek)} — pro ${h.pro}, proti ${h.proti}, zdrželo se ${h.zdrzel}`,
        meta: `${nazevOrganu(h.organ)} · bod ${h.bod}`,
        odkaz: `/hlasovani/tag/${t.id}`,
      });
    }

    for (const c of clanky ?? []) {
      if (!(c.tagy ?? []).includes(t.id)) continue;
      const m = /^(\d{4})-(\d{2})/.exec(c.cislo ?? '');
      udalosti.push({
        datum: m ? `${m[1]}-${m[2]}-01` : '',
        druh: 'clanek',
        nadpis: c.nadpis,
        popis: c.perex ? orez(c.perex, 180) : null,
        meta: `Zpravodaj ${c.cislo}${c.strana ? `, strana ${c.strana}` : ''}`,
        odkaz: `/zpravodaj/${c.cislo}`,
      });
    }

    udalosti.sort((a, b) => b.datum.localeCompare(a.datum));
    return { params: { tema: t.id }, props: { tag: t, udalosti } };
  });
}

interface Props {
  tag: Tag;
  udalosti: Udalost[];
}

const { tag, udalosti } = Astro.props as Props;
const zUsneseni = nactiUsneseni();

const nazvyDruhu: Record<Udalost['druh'], string> = {
  usneseni: 'Usnesení',
  hlasovani: 'Hlasování',
  clanek: 'Zpravodaj',
};

const roky = [...new Set(udalosti.map((u) => u.datum.slice(0, 4)).filter(Boolean))].sort((a, b) => b.localeCompare(a));

/* ── Časová osa tématu ──────────────────────────────────────────────────
   Přednost má jednotná časová osa (`casova_osa/tagy/{tag}.json`), která už
   spojuje usnesení, hlasování, smlouvy, zpravodaj i média. Když pro téma
   soubor není, sestaví se osa z týchž záznamů, které jsou vypsané níže —
   stránka tak není bez osy jen proto, že jiný modul ještě nedoběhl. */

const DRUHY_NA_OSE: Record<Udalost['druh'], string> = {
  usneseni: 'usneseni',
  hlasovani: 'hlasovani',
  clanek: 'zpravodaj',
};
const ZDROJE_DRUHU: Record<Udalost['druh'], string> = {
  usneseni: 'usnesení rady a zastupitelstva',
  hlasovani: 'jmenovitá hlasování',
  clanek: 'Městský zpravodaj',
};

const zOsy = nactiOsuTagu(tag.id);
const zeZaznamu: UdalostOsy[] =
  zOsy.data.udalosti.length > 0
    ? []
    : udalosti
        .filter((u) => /^\d{4}/.test(u.datum))
        .map((u, i) =>
          udalost({
            id: `${u.druh}-${i}`,
            datum: u.datum,
            presnost: u.druh === 'clanek' ? 'mesic' : 'den',
            druh: DRUHY_NA_OSE[u.druh],
            nadpis: u.nadpis,
            popis: u.popis,
            odkaz: u.odkaz,
            detail: u.meta,
            jistota: 'fakt',
            zdroj: ZDROJE_DRUHU[u.druh],
            tagy: [tag.id],
          }),
        );

const naOse = slucUdalosti(zOsy.data.udalosti, zeZaznamu);
const moduly = popisModulu(zOsy.data.moduly);
const zdrojeOsy =
  moduly.length > 0
    ? moduly
    : [...new Set(zeZaznamu.map((u) => u.zdroj).filter((x): x is string => Boolean(x)))];

/* ── Ročníky se skládají jako HTML řetězce ──────────────────────────────
   Stránka tématu vypisovala všechny záznamy najednou; u „Pronájmů a pachtů"
   to bylo 54 170 DOM uzlů. Ročníky se proto vysázejí do řetězců a stránka
   ukáže tři nejnovější, zbytek na vyžádání.

   Cizí data (nadpisy, popisy, odkazy) jdou do HTML přes `esc()`. */
const rocniky = roky.map((rok) => {
  const vRoce = udalosti.filter((u) => u.datum.startsWith(rok));
  const polozky = vRoce
    .map((u) => {
      const nadpis = u.odkaz
        ? `<a href="${esc(u.odkaz)}"${u.odkaz.startsWith('http') ? ' rel="noreferrer noopener"' : ''}>${esc(u.nadpis)}</a>`
        : esc(u.nadpis);
      const popis = u.popis ? `<p>${esc(u.popis)}</p>` : '';
      return (
        `<li class="polozka"><div class="polozka__hlava">` +
        `<span>${esc(nazvyDruhu[u.druh])}</span>` +
        `<span>${esc(datumKratke(u.datum))}</span>` +
        `<span>${esc(u.meta ?? '')}</span></div>` +
        `<h3 class="polozka__nazev">${nadpis}</h3>${popis}</li>`
      );
    })
    .join('');
  return `<section><h2>${esc(rok)}</h2><ul class="seznam">${polozky}</ul></section>`;
});
---

<Zaklad titulek={`Téma: ${tag.nazev}`} aktivni="usneseni" nadpis={tag.nazev} uvod={tag.popis}>
  <div class="radek-akci">
    <p class="pocet-vysledku">
      {udalosti.length > 0 ? `${cislo(udalosti.length)} záznamů z usnesení, hlasování a zpravodaje · ` : ''}
      <a href={`/hlasovani/tag/${tag.id}`}>Jen hlasování k tématu</a>
    </p>
    <Sledovat tag={tag.id} nazev={tag.nazev} />
  </div>

  <p class="graf-poznamka">
    Sledování je uložené jen ve vašem prohlížeči — na úvodní stránce se z něj složí přehled
    nejnovějšího dění ve sledovaných tématech. Nic se neodesílá a nic se neregistruje.
  </p>

  <StavDat
    stav={zUsneseni.stav}
    zdroj="usnesení, hlasování a články zpravodaje"
    co={`Časová osa tématu ${tag.nazev}`}
    prazdno={zUsneseni.stav === 'ok' && udalosti.length === 0}
    modul="usnesení, hlasování a zpravodaj"
  />

  {
    naOse.length > 0 && (
      <CasovaOsa
        id="osa-tematu"
        nadpis={`Časová osa tématu ${tag.nazev}`}
        udalosti={naOse}
        popis="Kdy se k tématu co dělo. Každý pruh je jeden druh záznamu; osa je lineární v čase, takže delší mezera znamená, že se k tématu opravdu dlouho nic neobjevilo."
        zdroje={zdrojeOsy.length > 0 ? zdrojeOsy : ['jednotná časová osa tématu']}
        neuplnost="Do osy se dostane jen to, co má v datech téma přiřazené. Záznam bez tagu tu chybí, i kdyby o téma šlo."
      />
    )
  }

  <CastiPoCastech
    casti={rocniky}
    id={`rocniky-${tag.id}`}
    poCastech={3}
    jednotka="ročníků"
  />
</Zaklad>
